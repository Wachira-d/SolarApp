@page
@using SolarApp.Models.Enums
@model SolarApp.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "หน้าหลัก — ภาพรวมการทำงาน";
    var d = Model.Dashboard;
}

<!-- ═══ Filter bar — partner (admin) + project type + monitoring + brand ═══ -->
@{
    var anyFilterActive = d.SelectedPartnerId.HasValue
        || d.SelectedServiceLevel.HasValue
        || d.SelectedMonitoredOnly.HasValue
        || d.SelectedBrand.HasValue;
    var monitoringVal = d.SelectedMonitoredOnly switch
    {
        true => "monitored",
        false => "unmonitored",
        _ => ""
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h5 class="mb-0">ภาพรวม <span class="text-muted fs-6">(@d.TotalInstallations ไซต์)</span></h5>
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        @if (d.Partners.Any())
        {
            <select name="PartnerId" class="form-select form-select-sm" style="width:auto"
                    onchange="this.form.submit()" title="กรองตามพาร์ทเนอร์">
                <option value="">พาร์ทเนอร์ทั้งหมด</option>
                @foreach (var p in d.Partners)
                {
                    <option value="@p.Id" selected="@(d.SelectedPartnerId == p.Id)">@p.Name (@p.InstallationCount)</option>
                }
            </select>
        }

        @* Project type = ServiceLevel preset *@
        <select name="ServiceLevel" class="form-select form-select-sm" style="width:auto"
                onchange="this.form.submit()" title="ประเภทโปรเจ็ค (ขอบเขตบริการ)">
            <option value="">ทุกประเภทบริการ</option>
            @foreach (var sl in Enum.GetValues<SolarApp.Models.Enums.ServiceLevel>())
            {
                var label = sl switch
                {
                    SolarApp.Models.Enums.ServiceLevel.FullOM => "Full O&M",
                    SolarApp.Models.Enums.ServiceLevel.MonitoringOnly => "Monitoring เท่านั้น",
                    SolarApp.Models.Enums.ServiceLevel.CleaningOnly => "ล้างแผงเท่านั้น",
                    SolarApp.Models.Enums.ServiceLevel.PreventiveOnly => "PM เท่านั้น",
                    SolarApp.Models.Enums.ServiceLevel.Custom => "Custom",
                    _ => sl.ToString()
                };
                <option value="@sl" selected="@(d.SelectedServiceLevel == sl)">@label</option>
            }
        </select>

        @* Monitoring — the operator's primary ask: only sites we poll via API *@
        <select name="Monitoring" class="form-select form-select-sm" style="width:auto"
                onchange="this.form.submit()" title="กรองตามการ Monitor ผ่าน API">
            <option value="" selected="@(monitoringVal == "")">Monitor: ทั้งหมด</option>
            <option value="monitored" selected="@(monitoringVal == "monitored")">เฉพาะที่ Monitor (ดึงผ่าน API)</option>
            <option value="unmonitored" selected="@(monitoringVal == "unmonitored")">เฉพาะที่ไม่ Monitor</option>
        </select>

        @* Brand *@
        <select name="Brand" class="form-select form-select-sm" style="width:auto"
                onchange="this.form.submit()" title="กรองตามยี่ห้อ inverter">
            <option value="">ทุกยี่ห้อ</option>
            @foreach (var b in Enum.GetValues<InverterBrand>())
            {
                <option value="@b" selected="@(d.SelectedBrand == b)">@b</option>
            }
        </select>

        @if (anyFilterActive)
        {
            <a asp-page="Index" class="btn btn-sm btn-outline-secondary" title="ล้างตัวกรอง">
                <i class="bi bi-x-circle"></i> ล้างตัวกรอง
            </a>
        }
    </form>
</div>

<!-- ═══ STATUS OVERVIEW ═══ -->
<div class="row mb-4 g-2 g-md-3">
    <div class="col-6 col-md">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-2 py-md-3">
                <div class="display-6 fw-bold">@d.TotalInstallations</div>
                <small class="text-muted">ไซต์ทั้งหมด</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card border-0 shadow-sm text-center h-100 @(d.OnlineCount == d.TotalInstallations && d.TotalInstallations > 0 ? "border-success" : "")">
            <div class="card-body py-2 py-md-3">
                <div class="display-6 fw-bold text-success">@d.OnlineCount</div>
                <small class="text-muted">ใช้งานปกติ</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card border-0 shadow-sm text-center h-100 @(d.OfflineCount > 0 ? "border-danger border-2" : "")">
            <div class="card-body py-2 py-md-3">
                <div class="display-6 fw-bold @(d.OfflineCount > 0 ? "text-danger" : "text-muted")">@d.OfflineCount</div>
                <small class="text-muted">ออฟไลน์</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-2 py-md-3">
                <div class="display-6 fw-bold text-warning">@d.MaintenanceCount</div>
                <small class="text-muted">บำรุงรักษา</small>
            </div>
        </div>
    </div>
    <div class="col-12 col-md">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-2 py-md-3">
                <div class="display-6 fw-bold text-info">@d.TotalCapacityKw.ToString("N0")</div>
                <small class="text-muted">กำลังรวม (kWp)</small>
            </div>
        </div>
    </div>
</div>

<!-- ═══ ACTION REQUIRED ═══ -->
@{
    var hasAction = d.CriticalAlertCount + d.HighAlertCount + d.OfflineCount + d.CleaningDueCount
                    + d.WarrantyExpiringCount + d.PendingMaintenanceCount + d.OpenTicketCount;
}
@if (hasAction > 0)
{
    <div class="card border-danger border-2 shadow-sm mb-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between">
            <h6 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> ต้องดำเนินการ</h6>
            <span class="badge bg-white text-danger">@hasAction รายการ</span>
        </div>
        <div class="card-body p-0">
            @* Every tile links to the page where that work is actually done —
               a count you can't act on just makes the operator hunt for the
               right screen. *@
            <div class="row g-0">
                @if (d.OfflineCount > 0)
                {
                    <a href="#offline-sites" class="col-6 col-sm-4 col-md-auto border-end border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-danger">@d.OfflineCount</div>
                        <small class="text-body">ออฟไลน์</small>
                    </a>
                }
                @if (d.CriticalAlertCount > 0)
                {
                    <a asp-page="/Admin/Alerts" class="col-6 col-sm-4 col-md-auto border-end border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-danger">@d.CriticalAlertCount</div>
                        <small class="text-body">วิกฤต</small>
                    </a>
                }
                @if (d.HighAlertCount > 0)
                {
                    <a asp-page="/Admin/Alerts" class="col-6 col-sm-4 col-md-auto border-end border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-warning">@d.HighAlertCount</div>
                        <small class="text-body">เร่งด่วน</small>
                    </a>
                }
                @if (d.CleaningDueCount > 0)
                {
                    <a href="#cleaning-due" class="col-6 col-sm-4 col-md-auto border-end border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-info">@d.CleaningDueCount</div>
                        <small class="text-body">ครบล้างแผง</small>
                    </a>
                }
                @if (d.PendingMaintenanceCount > 0)
                {
                    <a asp-page="/Maintenance/Index" class="col-6 col-sm-4 col-md-auto border-end border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-primary">@d.PendingMaintenanceCount</div>
                        <small class="text-body">รอบำรุงรักษา</small>
                    </a>
                }
                @if (d.OpenTicketCount > 0)
                {
                    <a asp-page="/ServiceTickets/Index" class="col-6 col-sm-4 col-md-auto border-end border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-secondary">@d.OpenTicketCount</div>
                        <small class="text-body">แจ้งซ่อมค้าง</small>
                    </a>
                }
                @if (d.WarrantyExpiringCount > 0)
                {
                    <a href="#warranty-expiring" class="col-6 col-sm-4 col-md-auto border-bottom p-2 p-md-3 text-center text-decoration-none action-tile">
                        <div class="fs-3 fw-bold text-info">@d.WarrantyExpiringCount</div>
                        <small class="text-body">ประกันใกล้หมด</small>
                    </a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle-fill"></i> <strong>ทุกระบบปกติ</strong> — ไม่มีรายการที่ต้องดำเนินการ
    </div>
}

<div class="row mb-4">
    <!-- ═══ OFFLINE INSTALLATIONS ═══ -->
    @if (d.OfflineInstallations.Any())
    {
        <div class="col-md-6 mb-3" id="offline-sites">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><h6 class="mb-0 text-danger"><i class="bi bi-wifi-off"></i> ไซต์ที่ออฟไลน์</h6></div>
                <div class="card-body p-0">
                    @foreach (var inst in d.OfflineInstallations)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom p-3">
                            <div>
                                <strong>@inst.SiteName</strong>
                                <br /><small class="text-muted">@inst.CustomerName @(inst.PartnerName != null ? $"• {inst.PartnerName}" : "")</small>
                                <br /><small class="text-danger">ออนไลน์ล่าสุด: @inst.OnlineAgo</small>
                            </div>
                            <a asp-page="/Installations/Detail" asp-route-id="@inst.Id" class="btn btn-sm btn-outline-danger">ดู</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ═══ ACTIVE ALERTS ═══ -->
    <div class="@(d.OfflineInstallations.Any() ? "col-md-6" : "col-12") mb-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between">
                <h6 class="mb-0"><i class="bi bi-bell-fill text-warning"></i> แจ้งเตือนที่ยังไม่จัดการ (@d.ActiveAlerts.Count)</h6>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Alerts" class="btn btn-sm btn-outline-warning">ดูทั้งหมด</a>
                }
            </div>
            <div class="card-body p-0" style="max-height:280px;overflow-y:auto">
                @foreach (var alert in d.ActiveAlerts)
                {
                    var badge = alert.Severity switch
                    {
                        SolarApp.Models.Enums.AlertSeverity.Critical => "bg-danger",
                        SolarApp.Models.Enums.AlertSeverity.High => "bg-warning text-dark",
                        SolarApp.Models.Enums.AlertSeverity.Medium => "bg-info",
                        _ => "bg-secondary"
                    };
                    <div class="d-flex align-items-start border-bottom p-2 px-3">
                        <span class="badge @badge me-2 mt-1" style="min-width:70px">@alert.Severity</span>
                        <div class="flex-grow-1">
                            <strong>@alert.DisplayTitle</strong>
                            <br /><small class="text-muted">@alert.Installation.SiteName • @alert.OccurredAt.ToString("dd/MM HH:mm")</small>
                        </div>
                    </div>
                }
                @if (!d.ActiveAlerts.Any())
                {
                    <p class="text-center text-muted py-3 mb-0">ไม่มีแจ้งเตือน</p>
                }
            </div>
        </div>
    </div>
</div>

@* The view model has always computed these two lists, but the page only ever
   showed their counts — so the operator saw "4 ครบล้างแผง" with no way to find
   out which four.  Rendering them here also gives the tiles above something to
   jump to. *@
@if (d.CleaningDueInstallations.Any() || d.WarrantyExpiringInstallations.Any())
{
    <div class="row mb-4">
        <!-- ═══ CLEANING DUE ═══ -->
        @if (d.CleaningDueInstallations.Any())
        {
            <div class="@(d.WarrantyExpiringInstallations.Any() ? "col-md-6" : "col-12") mb-3" id="cleaning-due">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 text-info"><i class="bi bi-droplet-fill"></i> ครบกำหนดล้างแผง (@d.CleaningDueInstallations.Count)</h6>
                    </div>
                    <div class="card-body p-0" style="max-height:320px;overflow-y:auto">
                        @foreach (var inst in d.CleaningDueInstallations)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom p-3">
                                <div>
                                    <strong>@inst.SiteName</strong>
                                    <br /><small class="text-muted">@inst.CustomerName @(inst.PartnerName != null ? $"• {inst.PartnerName}" : "")</small>
                                    <br />
                                    @{
                                        var overdueDays = inst.NextCleaningDate.HasValue
                                            ? (DateTime.UtcNow.Date - inst.NextCleaningDate.Value.Date).Days
                                            : 0;
                                        var cleaningWhen = overdueDays > 0
                                            ? $"เลยกำหนด {overdueDays} วัน"
                                            : "ถึงกำหนดล้าง";
                                    }
                                    <small class="text-info">@cleaningWhen · เหลือ @inst.RemainingCleanings ครั้ง</small>
                                </div>
                                <a asp-page="/Installations/Cleaning" asp-route-id="@inst.Id" class="btn btn-sm btn-outline-info">ล้างแผง</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ═══ WARRANTY EXPIRING ═══ -->
        @if (d.WarrantyExpiringInstallations.Any())
        {
            <div class="@(d.CleaningDueInstallations.Any() ? "col-md-6" : "col-12") mb-3" id="warranty-expiring">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 text-warning"><i class="bi bi-shield-exclamation"></i> ประกันใกล้หมดอายุ (@d.WarrantyExpiringInstallations.Count)</h6>
                    </div>
                    <div class="card-body p-0" style="max-height:320px;overflow-y:auto">
                        @foreach (var inst in d.WarrantyExpiringInstallations)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom p-3">
                                <div>
                                    <strong>@inst.SiteName</strong>
                                    <br /><small class="text-muted">@inst.CustomerName @(inst.PartnerName != null ? $"• {inst.PartnerName}" : "")</small>
                                    <br /><small class="text-warning">
                                        หมดอายุ @inst.WarrantyExpiry.ToString("dd/MM/yyyy") · เหลือ @inst.WarrantyDaysLeft วัน
                                    </small>
                                </div>
                                <a asp-page="/Installations/Warranty" asp-route-id="@inst.Id" class="btn btn-sm btn-outline-warning">ดูประกัน</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ═══ ALL INSTALLATIONS TABLE ═══ -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">ไซต์งานทั้งหมด</h6>
        <div class="d-flex gap-2 align-items-center">
            <input type="text" id="searchInput" class="form-control form-control-sm" style="width:200px"
                   placeholder="ค้นหาไซต์ / ลูกค้า..." />
            @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
            {
                <a asp-page="/Installations/Create" class="btn btn-warning btn-sm">
                    <i class="bi bi-plus"></i> เพิ่ม
                </a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="installationsTable">
                <thead class="table-light">
                    <tr>
                        <th>สถานะ</th>
                        <th>ไซต์งาน</th>
                        <th>ลูกค้า</th>
                        @if (User.IsInRole("Admin")) { <th>พาร์ทเนอร์</th> }
                        <th>อินเวอร์เตอร์</th>
                        <th>กำลัง</th>
                        <th>ออนไลน์ล่าสุด</th>
                        <th>แจ้งเตือน</th>
                        <th>ล้างแผง</th>
                        <th>ประกัน</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in d.AllInstallations)
                    {
                        <tr class="searchable" data-install-id="@inst.Id" data-search="@inst.SiteName @inst.CustomerName @inst.PartnerName @inst.InverterBrand">
                            <td><span class="badge @inst.StatusBadgeClass">@inst.Status</span></td>
                            <td>
                                <a asp-page="/Installations/Detail" asp-route-id="@inst.Id" class="text-decoration-none">
                                    <strong>@inst.SiteName</strong>
                                </a>
                                <br /><small class="text-muted">@inst.SiteCode</small>
                            </td>
                            <td>@inst.CustomerName</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td><small>@(inst.PartnerName ?? "ตรง")</small></td>
                            }
                            <td>
                                <small>@inst.InverterBrand</small>
                                @if (inst.InverterSizeKw > 0)
                                {
                                    <br /><small class="text-muted">@inst.InverterSizeKw kW ×@inst.InverterCount</small>
                                }
                            </td>
                            <td>@inst.CapacityKw kWp</td>
                            <td class="@(inst.Status == "Offline" ? "text-danger fw-bold" : "")">
                                <small>@inst.OnlineAgo</small>
                            </td>
                            <td>
                                @if (inst.ActiveAlerts > 0)
                                {
                                    <span class="badge bg-danger">@inst.ActiveAlerts</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check-circle"></i></span>
                                }
                            </td>
                            <td>
                                @if (inst.IsCleaningDue)
                                {
                                    <span class="badge bg-warning text-dark" title="@inst.NextCleaningDate?.ToString("dd/MM/yyyy")">ครบกำหนด!</span>
                                }
                                else
                                {
                                    <small class="text-muted">เหลือ @inst.RemainingCleanings ครั้ง</small>
                                }
                            </td>
                            <td>
                                @if (inst.WarrantyDaysLeft <= 0)
                                {
                                    <span class="badge bg-danger">หมดประกัน</span>
                                }
                                else if (inst.WarrantyDaysLeft <= 90)
                                {
                                    <span class="badge bg-warning text-dark">เหลือ @inst.WarrantyDaysLeft วัน</span>
                                }
                                else
                                {
                                    <small class="text-muted">@inst.WarrantyExpiry.ToString("MM/yyyy")</small>
                                }
                            </td>
                            <td>
                                <a asp-page="/Installations/Detail" asp-route-id="@inst.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!d.AllInstallations.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">ยังไม่มีไซต์งาน</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        // Search filter
        document.getElementById('searchInput')?.addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#installationsTable .searchable').forEach(row => {
                row.style.display = row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
            });
        });

        // ─── SignalR live updates ───
        (function () {
            if (typeof signalR === 'undefined') return;
            const conn = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/dashboard')
                .withAutomaticReconnect()
                .build();

            conn.on('RealtimeUpdate', payload => {
                const row = document.querySelector(`tr[data-install-id="${payload.Id}"]`);
                if (row) {
                    row.classList.add('table-success');
                    setTimeout(() => row.classList.remove('table-success'), 1500);
                }
                const led = document.getElementById('liveLed');
                if (led) { led.classList.add('bg-success'); led.title = 'Live update at ' + new Date().toLocaleTimeString(); }
            });

            conn.start()
                .then(() => conn.invoke('Subscribe', 'all'))
                .catch(err => console.warn('SignalR connect failed', err));
        })();
    </script>
}
