@page "{id:int}"
@model SolarApp.Pages.Performance.DetailModel
@{
    var r = Model.Report;
    var inst = r.Installation;
    ViewData["Title"] = $"Performance - {inst.SiteName}";
    var seriesJson = System.Text.Json.JsonSerializer.Serialize(
        r.DailySeries.Select(d => new { d = d.Date.ToString("yyyy-MM-dd"), a = d.ActualKwh, e = d.ExpectedKwh, pr = d.PerformanceRatio * 100 })
    );
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">
            <span class="badge bg-@r.HealthColor me-2">Grade @r.HealthGrade</span>
            @inst.SiteName
        </h4>
        <small class="text-muted">@inst.InverterBrand · @inst.SystemCapacityKw kW · @Model.From.ToString("dd MMM") → @Model.To.ToString("dd MMM yyyy")</small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Fleet</a>
        <a asp-page="/Installations/Detail" asp-route-id="@inst.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-info-circle"></i> Site Detail</a>

        @* ── Cloud-resync button ─────────────────────────────────────
           Pulls historical kWh from the inverter brand's cloud and
           replaces the stored data for the chosen window.  Use this
           when the dashboard numbers look wrong (PR > 100 %, Specific
           Yield off the charts, spikes on a single day) — the API is
           the source of truth, our DB just caches it.  See Startup.cs
           POST /api/installations/{id}/backfill for the server side. *@
        <select id="resyncDays" class="form-select form-select-sm" style="width:auto">
            <option value="30">30 วัน</option>
            <option value="90">90 วัน</option>
            <option value="180">180 วัน</option>
            <option value="365" selected>1 ปี</option>
            <option value="730">2 ปี</option>
            <option value="1095">3 ปี</option>
        </select>
        <button type="button" id="resyncBtn" class="btn btn-outline-success btn-sm" title="ดึงข้อมูลจาก cloud มาเทียบและเขียนทับ (clean + refetch)">
            <i class="bi bi-cloud-download"></i> ดึงข้อมูลใหม่จาก Cloud
        </button>
        @if (User.IsInRole("Admin"))
        {
            <button type="button" id="probeBtn"
                    class="btn btn-outline-warning btn-sm"
                    data-brand="@inst.InverterBrand"
                    title="ทดสอบ backfill ของ @inst.InverterBrand เพื่อ debug">
                <i class="bi bi-search"></i> Probe (admin)
            </button>
        }
    </div>
</div>
<div id="resyncResult" class="alert alert-light small d-none mb-3"></div>
<div id="probeResult" class="card border-warning d-none mb-3"></div>

<!-- KPI Cards -->
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Performance Ratio</div>
            <div class="fs-3 fw-bold text-@(r.PerformanceRatio >= 0.85m ? "success" : r.PerformanceRatio >= 0.7m ? "warning" : "danger")">
                @((r.PerformanceRatio * 100).ToString("0.0"))%
            </div>
            <small class="text-muted">Industry target ≥ 80%</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Uptime</div>
            <div class="fs-3 fw-bold text-@(r.UptimePercent >= 98 ? "success" : r.UptimePercent >= 90 ? "warning" : "danger")">
                @r.UptimePercent%
            </div>
            <small class="text-muted">@r.OfflineDays offline day(s)</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Specific Yield</div>
            <div class="fs-3 fw-bold">@r.SpecificYieldKwhPerKw.ToString("0.0")</div>
            <small class="text-muted">kWh / kW installed</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Capacity Factor</div>
            <div class="fs-3 fw-bold">@((r.CapacityFactor * 100).ToString("0.0"))%</div>
            <small class="text-muted">vs 24h theoretical max</small>
        </div></div>
    </div>
</div>

<!-- Revenue + Actual vs Expected -->
<div class="row g-2 mb-3">
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-cash-stack"></i> Financial Summary</h6></div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Energy Generated</span>
                    <strong>@r.TotalActualKwh.ToString("N1") kWh</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Estimated Savings</span>
                    <strong class="text-success">฿@r.EstimatedSavings.ToString("N2")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Export Revenue</span>
                    <strong class="text-info">฿@r.EstimatedRevenue.ToString("N2")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span><strong>Total Value</strong></span>
                    <strong class="fs-5">฿@((r.EstimatedSavings + r.EstimatedRevenue).ToString("N2"))</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-bar-chart"></i> Daily Actual vs Expected</h6></div>
            <div class="card-body">
                <canvas id="prodChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recommendations -->
@if (r.Recommendations.Any())
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-lightbulb"></i> Recommendations</h6></div>
        <ul class="list-group list-group-flush">
            @foreach (var rec in r.Recommendations)
            {
                <li class="list-group-item">@rec</li>
            }
        </ul>
    </div>
}

<!-- Daily table (collapsed on mobile) -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Daily Production</h6>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#dailyTable">
            <i class="bi bi-chevron-expand"></i> Toggle
        </button>
    </div>
    <div id="dailyTable" class="collapse show">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th class="text-end">Actual (kWh)</th><th class="text-end">Expected (kWh)</th><th class="text-end">PR %</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in r.DailySeries)
                    {
                        <tr class="@(d.ActualKwh <= 0 ? "table-danger" : "")">
                            <td>@d.Date.ToString("ddd dd MMM")</td>
                            <td class="text-end">@d.ActualKwh.ToString("0.00")</td>
                            <td class="text-end text-muted">@d.ExpectedKwh.ToString("0.00")</td>
                            <td class="text-end fw-bold text-@(d.PerformanceRatio >= 0.85m ? "success" : d.PerformanceRatio >= 0.5m ? "warning" : "danger")">
                                @((d.PerformanceRatio * 100).ToString("0"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Cloud-resync handler: clean the chosen window's stored daily rows
    // then refetch from the inverter brand's API.  Sanity ceiling on the
    // server side rejects implausibly high values from a buggy adapter so
    // a refetch can't poison the dataset.
    document.getElementById('resyncBtn')?.addEventListener('click', async () => {
        const btn = document.getElementById('resyncBtn');
        const result = document.getElementById('resyncResult');
        const days = parseInt(document.getElementById('resyncDays').value, 10) || 365;
        if (!confirm(
            `ดึงข้อมูล ${days} วันจาก Cloud และเขียนทับข้อมูลเดิม?\n\n` +
            `จะลบข้อมูลในช่วง ${days} วันที่ผ่านมาทั้งหมด แล้วโหลดจาก API ใหม่.\n` +
            `อาจใช้เวลา 30 วินาที — หลายนาที (ขึ้นกับ rate limit ของ vendor).`
        )) return;

        btn.disabled = true;
        result.classList.remove('d-none', 'alert-success', 'alert-danger');
        result.classList.add('alert-light');
        result.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลังดึงข้อมูล... อย่าปิดหน้านี้';
        try {
            const r = await fetch(`/api/installations/@inst.Id/backfill?days=${days}&cleanFirst=true`,
                { method: 'POST', headers: { 'Accept': 'application/json' } });
            const data = await r.json();
            if (data.success) {
                result.classList.replace('alert-light', 'alert-success');
                result.innerHTML =
                    `<i class="bi bi-check-circle-fill"></i> ${data.message}<br>` +
                    `ช่วง: ${data.fromDate} → ${data.toDate}<br>` +
                    `<small><a href="">รีโหลดหน้าเพื่อดูตัวเลขใหม่</a></small>`;
            } else {
                result.classList.replace('alert-light', 'alert-danger');
                // Build a diagnostic block so the operator (or the support
                // team copying it back into Slack/LINE) can see exactly
                // what went wrong: brand, station id, login result, what
                // the adapter said.  Server-side details with no PII leaks.
                let html = `<i class="bi bi-x-circle-fill"></i> <strong>${data.message || 'ดึงข้อมูลไม่สำเร็จ'}</strong>`;
                const rows = [];
                if (data.brand)        rows.push(`Brand: <code>${data.brand}</code>`);
                if (data.plantId)      rows.push(`Plant ID: <code>${data.plantId}</code>`);
                if (typeof data.authOk === 'boolean')
                    rows.push(`Auth check: ${data.authOk
                        ? '<span class="text-success">✓ OK</span>'
                        : '<span class="text-danger">✗ failed</span>'}`);
                if (data.authMessage)  rows.push(`Auth message: <code>${escapeHtml(data.authMessage)}</code>`);
                if (data.diagnostic)   rows.push(`Diagnostic: ${escapeHtml(data.diagnostic)}`);
                if (data.inner)        rows.push(`Inner exception: <code>${escapeHtml(data.inner)}</code>`);
                if (typeof data.rejected === 'number' && data.rejected > 0)
                    rows.push(`Rejected (>cap × 18): ${data.rejected} day-records`);
                if (data.fromDate)     rows.push(`Window: ${data.fromDate} → ${data.toDate}`);
                if (rows.length > 0)
                    html += `<div class="small mt-2">${rows.map(r => `<div>${r}</div>`).join('')}</div>`;
                html += '<div class="small mt-2 text-muted">' +
                    'ตรวจ server log ดู WARN ที่ขึ้นต้นด้วย <code>Hoymiles GetHistoricalData</code> / ' +
                    '<code>Backfill failed</code> เพื่อดูรายละเอียดเพิ่มเติม</div>';
                result.innerHTML = html;
            }
        } catch (e) {
            result.classList.replace('alert-light', 'alert-danger');
            result.innerHTML = `<i class="bi bi-x-circle-fill"></i> ${e.message}`;
        } finally {
            btn.disabled = false;
        }
    });
    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
        }[c]));
    }

    // Admin probe.  Hoymiles uses the deep endpoint crawler (raw
    // HTTP body, content-type, hex preview); every other brand uses
    // the generic backfill probe that runs TestConnection → PlantInfo
    // → GetHistorical across 4 time windows and shows record counts +
    // sample rows.
    document.getElementById('probeBtn')?.addEventListener('click', async () => {
        const btn = document.getElementById('probeBtn');
        const box = document.getElementById('probeResult');
        const brand = btn.dataset.brand || '';
        const isHoymiles = brand === 'Hoymiles';
        const isFoxEss = brand === 'FoxESS';
        const endpoint = isHoymiles
            ? `/api/installations/@inst.Id/hoymiles-probe`
            : isFoxEss
                ? `/api/installations/@inst.Id/foxess-probe`
                : `/api/installations/@inst.Id/backfill-probe`;
        btn.disabled = true;
        box.classList.remove('d-none');
        box.innerHTML = `<div class="card-body"><i class="bi bi-hourglass-split"></i> กำลังทดสอบ ${escapeHtml(brand)} backfill…</div>`;
        try {
            const r = await fetch(endpoint, { headers: { 'Accept': 'application/json' } });
            const data = await r.json();
            if (!r.ok) {
                box.innerHTML = `<div class="card-body text-danger">${escapeHtml(data.error || ('HTTP ' + r.status))}</div>`;
                return;
            }
            if (isFoxEss) {
                renderFoxEssProbe(box, data);
                return;
            }
            if (!isHoymiles) {
                renderBackfillProbe(box, data);
                return;
            }
            const EXPECTED_VERSION = 'v5-2026-05-29-month-merge';
            const isStale = (data.probeVersion || 'v1-legacy') !== EXPECTED_VERSION;
            let html =
                '<div class="card-header bg-warning bg-opacity-25"><strong>Hoymiles endpoint probe</strong>' +
                ` — ${escapeHtml(data.brand)} · sid <code>${escapeHtml(data.plantId)}</code> · today ${escapeHtml(data.today)}</div>` +
                '<div class="card-body small">';
            if (isStale) {
                html +=
                    '<div class="alert alert-danger mb-3">' +
                    '<strong><i class="bi bi-exclamation-triangle-fill"></i> ' +
                    `Backend probe version <code>${escapeHtml(data.probeVersion || 'v1-legacy')}</code> ` +
                    `does not match expected <code>${EXPECTED_VERSION}</code>.</strong><br>` +
                    'The running app on the server is older than the source tree.  The newer probe ' +
                    'returns httpStatus, contentType, bodyLength, and raw response for each endpoint — ' +
                    'this older one only returns a string "result".<br><br>' +
                    '<strong>เพื่อให้ probe ทำงานเต็ม:</strong>' +
                    '<pre class="bg-light p-2 mt-2 small">' +
                    'git pull origin claude/fix-bugs-Vb7Ld\n' +
                    'dotnet publish SolarApp/SolarApp.csproj -c Release -o &lt;publish-path&gt;\n' +
                    'iisreset                 # หรือ recycle App Pool / restart Kestrel</pre>' +
                    'ดู <code>SolarApp.dll</code> mtime ใน publish folder ว่าใหม่กว่าตอนนี้ (' +
                    new Date().toISOString() + ')' +
                    '</div>';
            }
            // Highlight likely matches at the top.  v3 backend tags each
            // probe entry with .match=true when the body looks like a
            // JSON listing of dates + kWh.
            const sorted = (data.probes || []).slice().sort((a, b) => {
                const ma = a.match ? 1 : 0;
                const mb = b.match ? 1 : 0;
                if (ma !== mb) return mb - ma;
                const ca = a.canary ? 1 : 0;
                const cb = b.canary ? 1 : 0;
                return cb - ca;
            });
            for (const p of sorted) {
                // Status badge — works with both old (result) and new
                // (httpStatus + bodyLength) probe response shapes.
                const code = p.httpStatus || 0;
                let badge;
                if (p.match)
                    badge = '<span class="badge bg-success">★ match</span>';
                else if (code === 200 && (p.bodyLength || 0) > 0)
                    badge = '<span class="badge bg-success">200</span>';
                else if (code >= 200 && code < 300)
                    badge = `<span class="badge bg-warning text-dark">${code} empty</span>`;
                else if (code >= 400)
                    badge = `<span class="badge bg-danger">${code}</span>`;
                else if (p.error)
                    badge = '<span class="badge bg-danger">err</span>';
                else if (p.result === 'ok')
                    badge = '<span class="badge bg-success">ok</span>';
                else if (p.result)
                    badge = `<span class="badge bg-danger">${escapeHtml(p.result)}</span>`;
                else
                    badge = '<span class="badge bg-secondary">?</span>';
                if (p.canary) badge = '<span class="badge bg-info text-dark me-1">canary</span>' + badge;

                const baseChip = p.baseUrl
                    ? `<small class="text-muted"> @@ ${escapeHtml(p.baseUrl.replace(/^https?:\/\//, ''))}</small>`
                    : '';
                html +=
                    `<details class="mb-2"><summary>${badge} <code>${escapeHtml(p.path || '?')}</code>` +
                    `${baseChip} <small class="text-muted">body=${escapeHtml(p.body || '')}` +
                    (p.contentType ? ` · ct=${escapeHtml(p.contentType)}` : '') +
                    (typeof p.bodyLength === 'number' ? ` · ${p.bodyLength}B` : '') +
                    `</small></summary>`;
                // Always render SOMETHING inside the <details> so the
                // disclosure isn't empty when the backend is older than
                // expected and didn't include raw / error fields.  Fallback
                // = full JSON of the probe entry.
                let inner = '';
                if (p.error) inner += `<div class="text-danger mt-1">${escapeHtml(p.error)}</div>`;
                if (p.raw)
                    inner += `<pre class="bg-light p-2 mt-1" style="white-space:pre-wrap;max-height:300px;overflow:auto;font-size:.78rem">` +
                             `${escapeHtml(p.raw)}</pre>`;
                if (p.loginMsg) inner += `<div class="text-muted mt-1">${escapeHtml(p.loginMsg)}</div>`;
                if (!inner) {
                    // Backend gave us bare metadata; show the whole entry so
                    // operator can still tell what's going on.
                    inner = `<div class="text-muted small mt-1">No raw payload in response.  Backend may be older than UI.  Full entry:</div>` +
                            `<pre class="bg-light p-2 mt-1" style="white-space:pre-wrap;max-height:300px;overflow:auto;font-size:.78rem">` +
                            `${escapeHtml(JSON.stringify(p, null, 2))}</pre>`;
                }
                html += inner + '</details>';
            }
            html += '<div class="text-muted small mt-2">หา block <strong>200</strong> ที่ raw มี date+kWh — ส่ง raw มาให้ผมจะ map ให้ตรง</div>';
            html += '</div>';
            box.innerHTML = html;
        } catch (e) {
            box.innerHTML = `<div class="card-body text-danger">${escapeHtml(e.message)}</div>`;
        } finally {
            btn.disabled = false;
        }
    });

    // Renderer for the brand-agnostic backfill probe.  Each step shows
    // ok/kind badge, duration, and (for GetHistorical) record count +
    // first/last 3 sample rows so the operator can see whether real
    // production numbers came back or it's just empty.
    // FoxESS endpoint probe — shows what the vendor cloud answered for each
    // endpoint/parameter combination so we can settle spec questions with
    // evidence instead of guesswork.
    function renderFoxEssProbe(box, data) {
        let html =
            '<div class="card-header bg-warning bg-opacity-25"><strong>FoxESS endpoint probe</strong>' +
            ` — Plant/Station ID: <code>${escapeHtml(data.plantId)}</code>` +
            ` · API Key: ${data.hasApiKey ? '✅ มี' : '❌ ไม่มี'}` +
            ` · server UTC ${escapeHtml(data.serverTimeUtc || '')}</div>` +
            '<div class="card-body small">';

        const probes = data.probes || [];
        const anyOk = probes.some(p => p.ok);
        html += anyOk
            ? '<div class="alert alert-success py-2">มี endpoint ที่ตอบสำเร็จ — auth (API key + signature) ใช้งานได้</div>'
            : '<div class="alert alert-danger py-2">ไม่มี endpoint ไหนสำเร็จเลย — ปัญหาน่าจะอยู่ที่ API key หรือเวลาเซิร์ฟเวอร์</div>';

        for (const p of probes) {
            const badge = p.ok
                ? '<span class="badge bg-success">OK</span>'
                : (p.errno === null || p.errno === undefined)
                    ? '<span class="badge bg-secondary">—</span>'
                    : `<span class="badge bg-danger">errno ${p.errno}</span>`;
            html +=
                `<details class="mb-2" ${p.ok ? '' : 'open'}>` +
                `<summary>${badge} <strong>${escapeHtml(p.label)}</strong> ` +
                `<code>${escapeHtml(p.path)}</code> ` +
                `<small class="text-muted">${p.durationMs}ms</small><br>` +
                `<span class="text-muted">${escapeHtml(p.msg || '')}</span></summary>`;
            if (p.sample) {
                html += `<pre class="bg-light p-2 mt-1" style="white-space:pre-wrap;max-height:260px;overflow:auto;font-size:.78rem">${escapeHtml(p.sample)}</pre>`;
            }
            html += '</details>';
        }

        html += '<div class="text-muted small mt-2">' +
            'มองหา <strong>device/list</strong> ที่ขึ้น OK — ใน sample จะมี <code>deviceSN</code> ' +
            'นั่นคือค่าที่ต้องเอาไปใส่ช่อง Plant/Station ID' +
            '</div></div>';
        box.innerHTML = html;
    }

    function renderBackfillProbe(box, data) {
        let html =
            '<div class="card-header bg-warning bg-opacity-25"><strong>Backfill probe</strong>' +
            ` — ${escapeHtml(data.brand)} · plant <code>${escapeHtml(data.plantId || '?')}</code>` +
            ` · today ${escapeHtml(data.today)}` +
            ` · <small class="text-muted">v=${escapeHtml(data.probeVersion || '?')}</small></div>` +
            '<div class="card-body small">';
        for (const s of (data.steps || [])) {
            let badge;
            if (s.ok)               badge = '<span class="badge bg-success">OK</span>';
            else if (s.kind === 'AuthFailed')           badge = '<span class="badge bg-danger">AUTH</span>';
            else if (s.kind === 'PlantNotFound')        badge = '<span class="badge bg-danger">404</span>';
            else if (s.kind === 'RateLimited')          badge = '<span class="badge bg-warning text-dark">RATE</span>';
            else if (s.kind === 'Timeout')              badge = '<span class="badge bg-warning text-dark">TIMEOUT</span>';
            else if (s.kind === 'NetworkError')         badge = '<span class="badge bg-warning text-dark">NET</span>';
            else if (s.kind === 'CloudServerError')     badge = '<span class="badge bg-warning text-dark">5xx</span>';
            else                                        badge = `<span class="badge bg-danger">${escapeHtml(s.kind || 'FAIL')}</span>`;

            const duration = typeof s.durationMs === 'number' ? ` <small class="text-muted">${s.durationMs}ms</small>` : '';
            const recChip = typeof s.recordCount === 'number'
                ? ` <span class="badge bg-info text-dark">${s.recordCount} rec · ${(s.nonZeroDays ?? 0)} non-zero · ${(s.totalKwh ?? 0).toFixed(1)} kWh</span>`
                : '';
            const windowChip = s.fromDate
                ? ` <small class="text-muted">${escapeHtml(s.fromDate)} → ${escapeHtml(s.toDate)}</small>`
                : '';

            html +=
                `<details class="mb-2" ${s.ok ? '' : 'open'}>` +
                `<summary>${badge} <strong>${escapeHtml(s.step)}</strong>${duration}${recChip}${windowChip}` +
                ` — <span class="text-muted">${escapeHtml(s.message || '')}</span></summary>`;

            let inner = '';
            if (s.plant) {
                inner += `<div class="mt-1">Plant: <code>${escapeHtml(s.plant.plantId || '')}</code>` +
                         ` "${escapeHtml(s.plant.plantName || '')}"` +
                         ` — ${s.plant.capacityKw ?? '?'} kW</div>`;
            }
            if (s.sampleFirst && s.sampleFirst.length) {
                inner += '<div class="mt-1"><strong>First 3 days:</strong><pre class="bg-light p-2 small mb-1">' +
                         s.sampleFirst.map(r => `${r.d}  ${(r.kwh ?? 0).toFixed(2)} kWh`).join('\n') +
                         '</pre></div>';
            }
            if (s.sampleLast && s.sampleLast.length) {
                inner += '<div><strong>Last 3 days:</strong><pre class="bg-light p-2 small mb-1">' +
                         s.sampleLast.map(r => `${r.d}  ${(r.kwh ?? 0).toFixed(2)} kWh`).join('\n') +
                         '</pre></div>';
            }
            if (s.technical) {
                inner += `<div class="text-danger mt-1"><strong>Technical:</strong> ${escapeHtml(s.technical)}</div>`;
            }
            if (!inner) inner = '<div class="text-muted small mt-1">(no additional detail)</div>';
            html += inner + '</details>';
        }
        // Brand-specific extras (e.g. Huawei rate-gate cooldown).
        if (data.extra && data.extra.huaweiRateGate) {
            const g = data.extra.huaweiRateGate;
            const cls = g.cooldownRemainingSeconds > 1 ? 'alert-warning' : 'alert-success';
            html += `<div class="alert ${cls} mt-2 mb-0 small">` +
                `<strong>Huawei rate gate:</strong> ${g.cooldownRemainingSeconds}s cooldown remaining. ` +
                `<br>${escapeHtml(g.explanation)}</div>`;
        }
        html += '<div class="text-muted small mt-2">' +
            'ถ้า TestConnection ผ่านแต่ GetHistorical ได้ 0 records — แสดงว่า adapter หา endpoint ผลิตย้อนหลังของ brand นี้ไม่เจอ. ' +
            'ส่ง Technical detail มาเพื่อ map endpoint ใหม่.' +
            '</div>';
        html += '</div>';
        box.innerHTML = html;
    }
</script>
<script>
(function(){
    const series = @Html.Raw(seriesJson);
    const ctx = document.getElementById('prodChart');
    if (!ctx) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: series.map(s => s.d),
            datasets: [
                { label: 'Actual kWh', data: series.map(s => s.a), backgroundColor: '#198754' },
                { label: 'Expected kWh', data: series.map(s => s.e), backgroundColor: 'rgba(108,117,125,0.4)' }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true, title: { display: true, text: 'kWh' } } },
            plugins: { legend: { position: 'bottom' } }
        }
    });
})();
</script>
}
