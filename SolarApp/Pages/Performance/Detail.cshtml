@page "{id:int}"
@model SolarApp.Pages.Performance.DetailModel
@{
    var r = Model.Report;
    var inst = r.Installation;
    ViewData["Title"] = $"Performance - {inst.SiteName}";
    var seriesJson = System.Text.Json.JsonSerializer.Serialize(
        r.DailySeries.Select(d => new { d = d.Date.ToString("yyyy-MM-dd"), a = d.ActualKwh, e = d.ExpectedKwh, pr = d.PerformanceRatio * 100 })
    );
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">
            <span class="badge bg-@r.HealthColor me-2">Grade @r.HealthGrade</span>
            @inst.SiteName
        </h4>
        <small class="text-muted">@inst.InverterBrand · @inst.SystemCapacityKw kW · @Model.From.ToString("dd MMM") → @Model.To.ToString("dd MMM yyyy")</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Fleet</a>
        <a asp-page="/Installations/Detail" asp-route-id="@inst.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-info-circle"></i> Site Detail</a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Performance Ratio</div>
            <div class="fs-3 fw-bold text-@(r.PerformanceRatio >= 0.85m ? "success" : r.PerformanceRatio >= 0.7m ? "warning" : "danger")">
                @((r.PerformanceRatio * 100).ToString("0.0"))%
            </div>
            <small class="text-muted">Industry target ≥ 80%</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Uptime</div>
            <div class="fs-3 fw-bold text-@(r.UptimePercent >= 98 ? "success" : r.UptimePercent >= 90 ? "warning" : "danger")">
                @r.UptimePercent%
            </div>
            <small class="text-muted">@r.OfflineDays offline day(s)</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Specific Yield</div>
            <div class="fs-3 fw-bold">@r.SpecificYieldKwhPerKw.ToString("0.0")</div>
            <small class="text-muted">kWh / kW installed</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Capacity Factor</div>
            <div class="fs-3 fw-bold">@((r.CapacityFactor * 100).ToString("0.0"))%</div>
            <small class="text-muted">vs 24h theoretical max</small>
        </div></div>
    </div>
</div>

<!-- Revenue + Actual vs Expected -->
<div class="row g-2 mb-3">
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-cash-stack"></i> Financial Summary</h6></div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Energy Generated</span>
                    <strong>@r.TotalActualKwh.ToString("N1") kWh</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Estimated Savings</span>
                    <strong class="text-success">฿@r.EstimatedSavings.ToString("N2")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Export Revenue</span>
                    <strong class="text-info">฿@r.EstimatedRevenue.ToString("N2")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span><strong>Total Value</strong></span>
                    <strong class="fs-5">฿@((r.EstimatedSavings + r.EstimatedRevenue).ToString("N2"))</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-bar-chart"></i> Daily Actual vs Expected</h6></div>
            <div class="card-body">
                <canvas id="prodChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recommendations -->
@if (r.Recommendations.Any())
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-lightbulb"></i> Recommendations</h6></div>
        <ul class="list-group list-group-flush">
            @foreach (var rec in r.Recommendations)
            {
                <li class="list-group-item">@rec</li>
            }
        </ul>
    </div>
}

<!-- Daily table (collapsed on mobile) -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Daily Production</h6>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#dailyTable">
            <i class="bi bi-chevron-expand"></i> Toggle
        </button>
    </div>
    <div id="dailyTable" class="collapse show">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th class="text-end">Actual (kWh)</th><th class="text-end">Expected (kWh)</th><th class="text-end">PR %</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in r.DailySeries)
                    {
                        <tr class="@(d.ActualKwh <= 0 ? "table-danger" : "")">
                            <td>@d.Date.ToString("ddd dd MMM")</td>
                            <td class="text-end">@d.ActualKwh.ToString("0.00")</td>
                            <td class="text-end text-muted">@d.ExpectedKwh.ToString("0.00")</td>
                            <td class="text-end fw-bold text-@(d.PerformanceRatio >= 0.85m ? "success" : d.PerformanceRatio >= 0.5m ? "warning" : "danger")">
                                @((d.PerformanceRatio * 100).ToString("0"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function(){
    const series = @Html.Raw(seriesJson);
    const ctx = document.getElementById('prodChart');
    if (!ctx) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: series.map(s => s.d),
            datasets: [
                { label: 'Actual kWh', data: series.map(s => s.a), backgroundColor: '#198754' },
                { label: 'Expected kWh', data: series.map(s => s.e), backgroundColor: 'rgba(108,117,125,0.4)' }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true, title: { display: true, text: 'kWh' } } },
            plugins: { legend: { position: 'bottom' } }
        }
    });
})();
</script>
}
