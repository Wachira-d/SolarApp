@page
@model SolarApp.Pages.Installations.IndexModel
@{
    ViewData["Title"] = "ไซต์งาน";
}

<div class="d-flex justify-content-between mb-3">
    <h4>ไซต์งานติดตั้งโซลาร์</h4>
    @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
    {
        <a asp-page="Create" class="btn btn-warning">
            <i class="bi bi-plus-lg"></i> เพิ่มไซต์งานใหม่
        </a>
    }
</div>

<div class="row">
    @foreach (var inst in Model.Installations)
    {
        var statusClass = inst.Status switch
        {
            SolarApp.Models.Enums.InstallationStatus.Active => "bg-success",
            SolarApp.Models.Enums.InstallationStatus.Offline => "bg-danger",
            SolarApp.Models.Enums.InstallationStatus.Maintenance => "bg-warning",
            _ => "bg-secondary"
        };
        var statusLabel = inst.Status switch
        {
            SolarApp.Models.Enums.InstallationStatus.Active => "ใช้งาน",
            SolarApp.Models.Enums.InstallationStatus.Offline => "ออฟไลน์",
            SolarApp.Models.Enums.InstallationStatus.Maintenance => "บำรุงรักษา",
            SolarApp.Models.Enums.InstallationStatus.Inactive => "ปิดใช้งาน",
            _ => inst.Status.ToString()
        };
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <h6 class="card-title mb-0">@inst.SiteName</h6>
                        <span class="badge @statusClass">@statusLabel</span>
                    </div>
                    <p class="text-muted small mb-2">
                        <i class="bi bi-geo-alt"></i> @inst.Address
                    </p>
                    @{
                        var (svcLabel, svcClass) = inst.ServiceLevel switch
                        {
                            SolarApp.Models.Enums.ServiceLevel.FullOM         => ("Full O&M",   "bg-success"),
                            SolarApp.Models.Enums.ServiceLevel.MonitoringOnly => ("Monitoring", "bg-info text-dark"),
                            SolarApp.Models.Enums.ServiceLevel.CleaningOnly   => ("Cleaning",   "bg-primary"),
                            SolarApp.Models.Enums.ServiceLevel.PreventiveOnly => ("PM Only",    "bg-warning text-dark"),
                            _                                                  => ("Custom",     "bg-secondary"),
                        };
                    }
                    <div class="mb-2">
                        <span class="badge @svcClass" title="ขอบเขตการบริการ">@svcLabel</span>
                        @if (inst.IncludesMonitoring) { <i class="bi bi-cloud-arrow-down text-success ms-1" title="Monitoring"></i> }
                        @if (inst.IncludesCleaning) { <i class="bi bi-droplet text-primary ms-1" title="ล้างแผง"></i> }
                        @if (inst.IncludesPreventiveMaintenance) { <i class="bi bi-clipboard-check text-info ms-1" title="PM"></i> }
                        @if (inst.IncludesCorrectiveMaintenance) { <i class="bi bi-tools text-warning ms-1" title="CM"></i> }
                        @if (inst.IncludesWarrantyService) { <i class="bi bi-shield-check text-secondary ms-1" title="Warranty"></i> }
                    </div>
                    <div class="row text-center mb-3">
                        <div class="col-4">
                            <small class="text-muted d-block">กำลังผลิต</small>
                            <strong>@inst.SystemCapacityKw kWp</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block">จำนวนแผง</small>
                            <strong>@inst.NumberOfPanels</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block">ยี่ห้อ</small>
                            <strong>@inst.InverterBrand</strong>
                        </div>
                    </div>
                    <div class="small">
                        <div class="d-flex justify-content-between">
                            <span>ลูกค้า:</span>
                            <span>@inst.Customer.FullName</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>วันที่ติดตั้ง:</span>
                            <span>@inst.InstallationDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>ประกัน:</span>
                            <span class="@(inst.IsWarrantyExpired ? "text-danger" : "")">
                                @inst.WarrantyExpiryDate.ToString("dd/MM/yyyy")
                                @(inst.IsWarrantyExpired ? "(หมดอายุ)" : "")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>การล้างแผง:</span>
                            <span class="@(inst.IsCleaningDue ? "text-warning fw-bold" : "")">
                                @inst.CompletedCleaningCount / @inst.TotalCleaningCount
                                @(inst.IsCleaningDue ? " (ครบกำหนด!)" : "")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-page="Detail" asp-route-id="@inst.Id" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-eye"></i> ดูรายละเอียด
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Installations.Any())
{
    <div class="text-center py-5 px-3">
        <i class="bi bi-house-gear text-muted" style="font-size: 4rem;"></i>
        <h5 class="mt-3">ยังไม่มีไซต์งาน</h5>
        <p class="text-muted mb-4" style="max-width:480px;margin:0 auto">
            เริ่มต้นด้วยการเพิ่มไซต์โซลาร์เซลล์แห่งแรกของคุณ
            ระบบจะ sync ข้อมูลจากผู้ผลิตอินเวอร์เตอร์ให้อัตโนมัติ
        </p>
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> เพิ่มไซต์แรก
                </a>
                <a asp-page="/Help/Onboarding" class="btn btn-outline-secondary">
                    <i class="bi bi-book"></i> คู่มือเริ่มต้น
                </a>
            </div>
        }
        else
        {
            <p class="text-muted small">ติดต่อผู้ดูแลระบบเพื่อขอเพิ่มไซต์</p>
        }
    </div>
}
