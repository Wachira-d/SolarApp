@page "{id:int}"
@model SolarApp.Pages.Installations.EditModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "แก้ไขไซต์งาน";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Edit Installation</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    @* No hidden Input.CustomerId here — the <select> at line 56
                       already submits this field.  Having both produces TWO
                       form values with the same name, and ASP.NET model binding
                       takes the FIRST one (= the hidden's stale value from page
                       load), silently ignoring the dropdown selection.  That
                       caused the "switching customer renames the original"
                       bug because the reassign guards saw no change. *@

                    <!-- Site Information -->
                    <h6 class="text-muted mb-3">Site Information</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.SiteName" class="form-label">Site Name *</label>
                            <input asp-for="Input.SiteName" class="form-control" />
                            <span asp-validation-for="Input.SiteName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Address" class="form-label">Address *</label>
                            <input asp-for="Input.Address" id="edtAddress" class="form-control" />
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label asp-for="Input.Latitude" class="form-label">Latitude</label>
                            <input asp-for="Input.Latitude" id="edtLat" class="form-control" step="any" />
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Input.Longitude" class="form-label">Longitude</label>
                            <input asp-for="Input.Longitude" id="edtLng" class="form-control" step="any" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end gap-1">
                            <button type="button" id="btnReverseGeocode" class="btn btn-outline-info btn-sm w-100"
                                    title="Look up address from lat/lng">
                                <i class="bi bi-search"></i> Find
                            </button>
                        </div>
                    </div>

                    <!-- Customer & Partner -->
                    <h6 class="text-muted mb-3 mt-4">Customer & Partner</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CustomerId" class="form-label">Customer</label>
                            <select asp-for="Input.CustomerId" asp-items="Model.Customers" class="form-select" id="customerSelect">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PartnerId" class="form-label">Partner</label>
                            <select asp-for="Input.PartnerId" asp-items="Model.Partners" class="form-select">
                                <option value="">-- No Partner (Direct Sale) --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#customerEditSection">
                                <i class="bi bi-pencil"></i> แก้ไขข้อมูลลูกค้า
                            </button>
                        </div>
                    </div>
                    <div class="collapse" id="customerEditSection">
                        <div class="card card-body bg-light mb-3">
                            <div class="row mb-2">
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerFirstName" class="form-label">ชื่อ</label>
                                    <input asp-for="Input.CustomerFirstName" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerLastName" class="form-label">นามสกุล</label>
                                    <input asp-for="Input.CustomerLastName" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerPhone" class="form-label">เบอร์โทร</label>
                                    <input asp-for="Input.CustomerPhone" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerEmail" class="form-label">Email</label>
                                    <input asp-for="Input.CustomerEmail" class="form-control" type="email" />
                                </div>
                            </div>
                            <small class="text-muted">การแก้ไขจะเปลี่ยนข้อมูลลูกค้าที่เลือกอยู่ (ไม่ใช่แค่ไซต์นี้)</small>
                        </div>
                    </div>

                    <!-- System Specs -->
                    <h6 class="text-muted mb-3 mt-4">System Specifications</h6>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InverterBrand" class="form-label">Inverter Brand *</label>
                            <select asp-for="Input.InverterBrand" asp-items="Html.GetEnumSelectList<InverterBrand>()" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterModel" class="form-label">Inverter Model</label>
                            <input asp-for="Input.InverterModel" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterSizeKw" class="form-label">Inverter Size (kW) *</label>
                            <input asp-for="Input.InverterSizeKw" class="form-control" type="number" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterCount" class="form-label"># of Inverters *</label>
                            <input asp-for="Input.InverterCount" class="form-control" type="number" min="1" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.SystemCapacityKw" class="form-label">System Capacity (kWp) *</label>
                            <input asp-for="Input.SystemCapacityKw" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.NumberOfPanels" class="form-label"># of Panels *</label>
                            <input asp-for="Input.NumberOfPanels" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.PanelWattage" class="form-label">Panel Wattage (W) *</label>
                            <input asp-for="Input.PanelWattage" class="form-control" />
                        </div>
                    </div>

                    <!-- Cloud API -->
                    <h6 class="text-muted mb-3 mt-4">Cloud API Connection</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @* PlantId is NOT a secret — show actual value for verification *@
                            <label asp-for="Input.PlantId" class="form-label">
                                Plant/Station ID
                                @if (Model.HasPlantId) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <input asp-for="Input.PlantId" class="form-control"
                                   placeholder="Enter Plant/Station ID" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CloudApiKey" class="form-label">
                                API Key
                                @if (Model.HasApiKey) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <div class="input-group">
                                <input asp-for="Input.CloudApiKey" class="form-control" type="password"
                                       placeholder="@(Model.HasApiKey ? "•••••••••• (saved — leave blank to keep)" : "Enter API Key")" />
                                <button type="button" class="btn btn-outline-secondary credential-reveal"
                                        data-field="apiKey" data-target="Input.CloudApiKey"
                                        title="ดู / ซ่อน">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CloudUsername" class="form-label">
                                Cloud Username
                                @if (Model.HasUsername) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            @* Username is NOT a secret — show the actual value for verification *@
                            <div class="input-group">
                                <input asp-for="Input.CloudUsername" class="form-control"
                                       placeholder="Enter username (email/phone)" />
                                <button type="button" class="btn btn-outline-secondary credential-reveal"
                                        data-field="username" data-target="Input.CloudUsername"
                                        title="โหลดค่าที่บันทึกไว้">
                                    <i class="bi bi-download"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CloudPassword" class="form-label">
                                Cloud Password
                                @if (Model.HasPassword) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <div class="input-group">
                                <input asp-for="Input.CloudPassword" class="form-control" type="password"
                                       placeholder="@(Model.HasPassword ? "•••••••••• (saved — leave blank to keep)" : "Enter password")" />
                                <button type="button" class="btn btn-outline-secondary credential-reveal"
                                        data-field="password" data-target="Input.CloudPassword"
                                        title="ดู / ซ่อน">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Advanced: API endpoint override -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <label asp-for="Input.CloudApiBaseUrl" class="form-label">
                                <i class="bi bi-gear"></i> API Endpoint Override
                                <span class="badge bg-secondary ms-1">Advanced</span>
                            </label>
                            <input asp-for="Input.CloudApiBaseUrl" class="form-control"
                                   placeholder="เว้นว่างเพื่อให้ระบบเลือกอัตโนมัติ — กรอกเมื่อ login ผิด region" />
                            <div class="form-text">
                                ใช้เฉพาะเมื่อ account อยู่บน server ที่ระบบเลือกไม่ถูก. รับ 2 รูปแบบ:<br>
                                <strong>Base URL</strong> เช่น <code>https://global.hoymiles.com</code> —
                                ระบบจะลองหา login path เอง (V3, V0, web-tier)<br>
                                <strong>Full URL</strong> เช่น
                                <code>https://global.hoymiles.com/platform/api/gateway/iam/auth_login</code> —
                                ใช้เลย ไม่ต้องลอง. หา URL นี้ได้จาก Browser DevTools (F12 → Network) ตอน login บนเว็บ
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CloudApiSecret" class="form-label">
                                API Secret
                                @if (Model.HasApiSecret) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <div class="input-group">
                                <input asp-for="Input.CloudApiSecret" class="form-control" type="password"
                                       placeholder="@(Model.HasApiSecret ? "•••••••••• (saved — leave blank to keep)" : "Enter secret")" />
                                <button type="button" class="btn btn-outline-secondary credential-reveal"
                                        data-field="apiSecret" data-target="Input.CloudApiSecret"
                                        title="ดู / ซ่อน">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end gap-2 flex-wrap">
                            <button type="button" id="testConnectionBtn" class="btn btn-outline-info">
                                <i class="bi bi-plug"></i> Test Connection
                            </button>
                            <div class="input-group" style="max-width: 340px">
                                <select id="backfillDays" class="form-select form-select-sm" style="flex: 0 0 110px">
                                    <option value="30">30 วัน</option>
                                    <option value="90">90 วัน</option>
                                    <option value="180">180 วัน</option>
                                    <option value="365" selected>1 ปี</option>
                                    <option value="730">2 ปี</option>
                                    <option value="1095">3 ปี</option>
                                </select>
                                <button type="button" id="backfillBtn" class="btn btn-outline-success">
                                    <i class="bi bi-cloud-download"></i> ดึงข้อมูลย้อนหลังจาก API
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="testResult"></div>
                    <div id="backfillResult" class="mt-1 small"></div>

                    @if (!string.IsNullOrEmpty(Model.CredentialStorageNote))
                    {
                        <div class="alert alert-light small py-1 px-2 mt-2 mb-3">
                            <i class="bi bi-database"></i>
                            <strong>Storage:</strong> @Model.CredentialStorageNote
                            <br /><small class="text-muted">
                                Credential fields are blank on purpose — leave blank to keep existing saved values.
                                Only type a new value if you want to CHANGE it.
                            </small>
                        </div>
                    }

                    <!-- Warranty & Maintenance -->
                    <h6 class="text-muted mb-3 mt-4">Warranty & Maintenance</h6>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InstallationDate" class="form-label">Installation Date *</label>
                            <input asp-for="Input.InstallationDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.CommissionDate" class="form-label">Commission Date</label>
                            <input asp-for="Input.CommissionDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.WarrantyYears" class="form-label">Warranty (Years) *</label>
                            <input asp-for="Input.WarrantyYears" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.TotalCleaningCount" class="form-label">Total Cleanings</label>
                            <input asp-for="Input.TotalCleaningCount" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.ElectricityRatePerKwh" class="form-label">Electricity Rate (THB/kWh)</label>
                            <input asp-for="Input.ElectricityRatePerKwh" class="form-control" />
                        </div>
                    </div>

                    @* ─── Service Scope ───────────────────────────────────────────── *@
                    <hr />
                    <h5 class="mb-3">ขอบเขตการบริการ (Service Scope)</h5>
                    <p class="text-muted small mb-2">
                        เลือกรูปแบบบริการที่เราดูแลให้ไซต์นี้
                        Background jobs (sync ข้อมูล, แจ้งเตือนล้างแผง) จะทำงานตามฟิลด์เหล่านี้
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">รูปแบบสัญญา</label>
                        <div class="btn-group d-block" role="group" id="serviceLevelGroup">
                            @foreach (var level in new[] {
                                (SolarApp.Models.Enums.ServiceLevel.FullOM, "Full O&M", "ดูแลครบ: monitor + ล้าง + PM + CM + warranty"),
                                (SolarApp.Models.Enums.ServiceLevel.MonitoringOnly, "Monitoring", "เฝ้าระวังออนไลน์เท่านั้น"),
                                (SolarApp.Models.Enums.ServiceLevel.CleaningOnly, "Cleaning", "เข้าล้างแผงตามรอบเท่านั้น"),
                                (SolarApp.Models.Enums.ServiceLevel.PreventiveOnly, "PM Only", "PM round (ล้าง+ตรวจ) ไม่มี cloud account"),
                                (SolarApp.Models.Enums.ServiceLevel.Custom, "Custom", "เลือกเองด้านล่าง"),
                            })
                            {
                                <input type="radio" class="btn-check" name="Input.ServiceLevel"
                                       id="svc-@level.Item1" value="@((int)level.Item1)"
                                       checked="@(Model.Input.ServiceLevel == level.Item1)" autocomplete="off" />
                                <label class="btn btn-outline-primary mb-1 me-1" for="svc-@level.Item1"
                                       title="@level.Item3">@level.Item2</label>
                            }
                        </div>
                    </div>

                    <div class="row g-2 mb-2" id="serviceFlagsRow">
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesMonitoring" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesMonitoring" class="form-check-label">
                                    <i class="bi bi-cloud-arrow-down"></i> Monitoring (ดึงข้อมูล cloud)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesCleaning" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesCleaning" class="form-check-label">
                                    <i class="bi bi-droplet"></i> ล้างแผงตามรอบ
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesPreventiveMaintenance" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesPreventiveMaintenance" class="form-check-label">
                                    <i class="bi bi-clipboard-check"></i> Preventive Maintenance
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesCorrectiveMaintenance" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesCorrectiveMaintenance" class="form-check-label">
                                    <i class="bi bi-tools"></i> Corrective Maintenance
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesWarrantyService" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesWarrantyService" class="form-check-label">
                                    <i class="bi bi-shield-check"></i> Warranty service
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ServiceNotes" class="form-label">หมายเหตุเงื่อนไขบริการ (Service Notes)</label>
                        <textarea asp-for="Input.ServiceNotes" class="form-control" rows="2"
                                  placeholder="เช่น &quot;PM 2 ครั้ง/ปี เท่านั้น&quot; / &quot;Partner monitor เอง เราเข้าเฉพาะ PM&quot;"></textarea>
                    </div>

                    @* ─── End Service Scope ────────────────────────────────────────── *@

                    @* ─── Cloud Connection ─────────────────────────────────────────── *@
                    <hr />
                    <h5 class="mb-3">การเชื่อมต่อ Cloud API</h5>
                    @{
                        var cap = SolarApp.Services.InverterApi.Common.BrandCapabilities.Get(Model.Input.InverterBrand);
                    }
                    <p class="text-muted small mb-2">
                        Brand <strong>@Model.Input.InverterBrand</strong> รองรับ:
                        <code>@string.Join(", ", cap.SupportedMethods)</code>
                        — ขั้นต่ำ <strong>@cap.MinIntervalMinutes นาที</strong>/รอบ.
                        @cap.Notes
                    </p>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Input_ConnectionMethod" class="form-label">วิธีเชื่อมต่อ</label>
                            <select id="Input_ConnectionMethod" name="Input.ConnectionMethod" class="form-select">
                                @foreach (var m in cap.SupportedMethods)
                                {
                                    var methodLabel = m == SolarApp.Models.Enums.ConnectionMethod.OfficialApi  ? "Official API (API Key + Secret)"
                                                    : m == SolarApp.Models.Enums.ConnectionMethod.UserPassword ? "Username + Password (web-login)"
                                                    : m == SolarApp.Models.Enums.ConnectionMethod.Hybrid       ? "Hybrid"
                                                                                                                : m.ToString();
                                    var isSelected = Model.Input.ConnectionMethod == m;
                                    <option value="@((int)m)" selected="@isSelected">@methodLabel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="Input_SyncIntervalMinutes" class="form-label">ความถี่ในการดึงข้อมูล</label>
                            <select id="Input_SyncIntervalMinutes" name="Input.SyncIntervalMinutes" class="form-select">
                                @foreach (var v in SolarApp.Services.InverterApi.Common.BrandCapabilities.AllowedIntervalMinutes)
                                {
                                    var isDisabled = (v <= (cap.MinIntervalMinutes - 1));
                                    var isSelected = (Model.Input.SyncIntervalMinutes == v);
                                    var intervalLabel = (v == 1440) ? "วันละครั้ง"
                                                      : (v == 60)   ? "ทุก 1 ชั่วโมง"
                                                      : (v <= 59)   ? $"ทุก {v} นาที"
                                                      : (v <= 1439) ? $"ทุก {v / 60} ชั่วโมง"
                                                                    : $"{v} นาที";
                                    var displayLabel = intervalLabel + (isDisabled ? " (ต่ำกว่า brand ขั้นต่ำ)" : "");
                                    if (isDisabled)
                                    {
                                        <option value="@v" disabled selected="@isSelected">@displayLabel</option>
                                    }
                                    else
                                    {
                                        <option value="@v" selected="@isSelected">@displayLabel</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    @* ─── End Cloud Connection ──────────────────────────────────────── *@

                    @* ─── LINE Alerts ───────────────────────────────────────────────── *@
                    <hr />
                    <h5 class="mb-3"><i class="bi bi-line"></i> แจ้งเตือนลูกค้าผ่าน LINE</h5>
                    <p class="text-muted small mb-2">
                        ส่งแจ้งเตือนเข้า LINE Group / User ของลูกค้าได้โดยตรง
                        เลือกได้ว่าจะส่งเรื่องอะไรบ้าง — ปล่อยว่างถ้าไม่ต้องการส่ง
                    </p>
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="Input.LineGroupId" class="form-label">LINE Group / User ID</label>
                            <div class="input-group">
                                <input asp-for="Input.LineGroupId" class="form-control" placeholder="C1234... หรือ U1234..." />
                                <button type="button" id="lineTestBtn" class="btn btn-outline-success">
                                    <i class="bi bi-send"></i> ส่งทดสอบ
                                </button>
                            </div>
                            <small class="text-muted">
                                ถ้าเว้นว่าง — ระบบจะใช้ LineUserId ของลูกค้าใน Customer แทน.
                                ปุ่ม "ส่งทดสอบ" จะใช้ค่าที่บันทึกแล้วใน DB (กด Save Changes ก่อนถ้าเพิ่งแก้)
                            </small>
                            <div id="lineTestResult" class="mt-2 small"></div>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6 col-12">
                            <div class="form-check">
                                <input asp-for="Input.NotifyOnGridLoss" class="form-check-input" />
                                <label asp-for="Input.NotifyOnGridLoss" class="form-check-label">
                                    <strong class="text-danger">🚨 ระบบดับ / ไม่ผลิตไฟฟ้า</strong>
                                    <small class="d-block text-muted">เช่น ไฟดับ inverter ออฟไลน์ Grid loss — แนะนำให้เปิด</small>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-check">
                                <input asp-for="Input.NotifyOnLowProduction" class="form-check-input" />
                                <label asp-for="Input.NotifyOnLowProduction" class="form-check-label">
                                    ⚡ ผลิตไฟต่ำกว่าปกติ
                                    <small class="d-block text-muted">production ต่ำกว่ากราฟปกติของวันนั้น ๆ</small>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-check">
                                <input asp-for="Input.NotifyOnCleaningDue" class="form-check-input" />
                                <label asp-for="Input.NotifyOnCleaningDue" class="form-check-label">
                                    💧 ครบรอบล้างแผง
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-check">
                                <input asp-for="Input.NotifyOnWarrantyExpiry" class="form-check-input" />
                                <label asp-for="Input.NotifyOnWarrantyExpiry" class="form-check-label">
                                    📋 ใกล้หมดประกัน
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="form-check">
                                <input asp-for="Input.NotifyOnApiFailure" class="form-check-input" />
                                <label asp-for="Input.NotifyOnApiFailure" class="form-check-label">
                                    🔌 API เชื่อมต่อ cloud ไม่ได้
                                    <small class="d-block text-muted">เป็นปัญหาทางเทคนิคของระบบ มักไม่แนะนำให้ส่งหาลูกค้า</small>
                                </label>
                            </div>
                        </div>
                    </div>
                    @* ─── End LINE Alerts ──────────────────────────────────────────────── *@

                    <div class="mb-3">
                        <label asp-for="Input.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ─── Reverse geocode: lat/lng → Address ───
        document.getElementById('btnReverseGeocode')?.addEventListener('click', async () => {
            const btn = document.getElementById('btnReverseGeocode');
            const lat = parseFloat(document.getElementById('edtLat').value);
            const lng = parseFloat(document.getElementById('edtLng').value);
            if (isNaN(lat) || isNaN(lng)) { window.toast.warning('Please fill both Latitude and Longitude first'); return; }

            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            try {
                const r = await fetch(`/api/geocode/reverse?lat=${lat}&lng=${lng}&lang=th,en`);
                const data = await r.json();
                if (data.success && data.address) {
                    if (!document.getElementById('edtAddress').value
                        || confirm(`Replace current address with:\n${data.address}`)) {
                        document.getElementById('edtAddress').value = data.address;
                        window.toast.success('Address resolved');
                    }
                } else {
                    window.toast.error('Could not resolve address: ' + (data.message || 'unknown'));
                }
            } catch (e) {
                window.toast.error('Geocoding failed: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });

        document.getElementById('testConnectionBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('testConnectionBtn');
            const result = document.getElementById('testResult');
            const formData = new FormData();
            formData.append('brand', document.querySelector('[name="Input.InverterBrand"]').value);
            formData.append('apiKey', document.querySelector('[name="Input.CloudApiKey"]').value);
            formData.append('apiSecret', document.querySelector('[name="Input.CloudApiSecret"]').value);
            formData.append('username', document.querySelector('[name="Input.CloudUsername"]').value);
            formData.append('password', document.querySelector('[name="Input.CloudPassword"]').value);
            formData.append('plantId', document.querySelector('[name="Input.PlantId"]').value);
            formData.append('apiBaseUrl', document.querySelector('[name="Input.CloudApiBaseUrl"]').value);
            // Send installation ID so the endpoint can fall back to stored credentials
            // when fields are left blank (Edit page preserves existing saved values).
            formData.append('installationId', '@Model.Input.Id');

            btn.disabled = true;
            result.innerHTML = '<span class="text-muted"><i class="spinner-border spinner-border-sm"></i> Testing...</span>';

            try {
                const r = await fetch('/api/test-inverter-connection', { method: 'POST', body: formData });
                const data = await r.json();
                if (data.success) {
                    let html = '<div class="alert alert-success mt-2 mb-0 p-2"><i class="bi bi-check-circle-fill"></i> ' + data.message + '</div>';

                    if (data.plantInfo) {
                        html += '<div class="card mt-2 border-success"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-success">Plant Info</h6>';
                        html += '<div><strong>ID:</strong> ' + (data.plantInfo.plantId || '-') + '</div>';
                        html += '<div><strong>Name:</strong> ' + (data.plantInfo.plantName || '-') + '</div>';
                        html += '<div><strong>Capacity:</strong> ' + (data.plantInfo.capacityKw || 0) + ' kW</div>';
                        if (data.plantInfo.address) html += '<div><strong>Address:</strong> ' + data.plantInfo.address + '</div>';
                        html += '</div></div>';
                    }

                    if (data.realtime) {
                        const rt = data.realtime;
                        html += '<div class="card mt-2 border-info"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-info">Live Data</h6>';
                        html += '<div><strong>Status:</strong> <span class="badge bg-' + (rt.isOnline ? 'success' : 'secondary') + '">' + (rt.isOnline ? 'ONLINE' : 'OFFLINE') + '</span></div>';
                        html += '<div><strong>Current Power:</strong> ' + (rt.currentPowerKw || 0).toFixed(2) + ' kW</div>';
                        html += '<div><strong>Today Energy:</strong> ' + (rt.todayEnergyKwh || 0).toFixed(2) + ' kWh</div>';
                        html += '<div><strong>Total Energy:</strong> ' + (rt.totalEnergyKwh || 0).toFixed(2) + ' kWh</div>';
                        if (rt.batterySocPercent !== null) html += '<div><strong>Battery SOC:</strong> ' + rt.batterySocPercent + '%</div>';
                        html += '<div class="text-muted small">Updated: ' + new Date(rt.timestamp).toLocaleString() + '</div>';
                        html += '</div></div>';
                    }

                    if (data.deviceCount > 0) {
                        html += '<div class="card mt-2 border-warning"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-warning">Devices (' + data.deviceCount + ')</h6>';
                        for (const d of data.devices) {
                            html += '<div>• ' + d.deviceName + ' (' + (d.model || d.deviceId) + ') - ' + (d.isOnline ? 'Online' : 'Offline') + '</div>';
                        }
                        html += '</div></div>';
                    }

                    if (!data.plantInfo && !data.realtime) {
                        html += '<div class="alert alert-warning mt-2 mb-0 p-2"><i class="bi bi-exclamation-triangle"></i> Connected, but no plant/realtime data returned. Check Plant ID.</div>';
                    }

                    result.innerHTML = html;
                } else {
                    result.innerHTML = '<div class="alert alert-danger mt-2 mb-0 p-2"><i class="bi bi-x-circle-fill"></i> ' + data.message + '</div>';
                }
            } catch (e) {
                result.innerHTML = '<div class="alert alert-danger mt-2 mb-0 p-2"><i class="bi bi-x-circle-fill"></i> Test failed: ' + e.message + '</div>';
            } finally {
                btn.disabled = false;
            }
        });

        // ─── Backfill historical data from inverter brand's API ─────────────
        document.getElementById('backfillBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('backfillBtn');
            const result = document.getElementById('backfillResult');
            const daysSel = document.getElementById('backfillDays');
            const days = parseInt(daysSel?.value || '365', 10);
            if (!confirm(`ดึงข้อมูลย้อนหลัง ${days} วัน?\nอาจใช้เวลา 30 วินาที - หลายนาที ขึ้นกับจำนวน + brand API rate limit`)) return;
            btn.disabled = true;
            result.innerHTML = '<span class="text-muted"><i class="bi bi-hourglass-split"></i> กำลังดึงข้อมูล… (อย่าปิดหน้า)</span>';
            try {
                const r = await fetch(`/api/installations/@Model.Input.Id/backfill?days=${days}`,
                    { method: 'POST', headers: { 'Accept': 'application/json' } });
                const data = await r.json();
                if (data.success) {
                    result.innerHTML =
                        `<span class="text-success"><i class="bi bi-check-circle-fill"></i> ${data.message} — ` +
                        `<strong>เพิ่มใหม่ ${data.inserted}</strong> · <strong>อัพเดท ${data.updated}</strong> วัน ` +
                        `(${data.fromDate} → ${data.toDate})</span>`;
                } else {
                    result.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle-fill"></i> ${data.message}</span>`;
                }
            } catch (e) {
                result.innerHTML = `<span class="text-danger">❌ Error: ${e.message}</span>`;
            } finally {
                btn.disabled = false;
            }
        });

        // ─── Credential reveal toggles (admin-only) ──────────────────────────
        // Each "eye" button next to a credential field either:
        //   * If the field has user input (operator just typed a new value) →
        //     toggle the input's type between password and text so they can
        //     verify the typed value without re-submitting.
        //   * Otherwise (input is empty = "keep saved value") → fetch the
        //     decrypted stored value from /api/installations/{id}/credential/
        //     {field}, populate the input AND switch to text type.  A second
        //     click hides again (type=password) but keeps the loaded value.
        // The server endpoint is Admin-only and audit-logs every reveal.
        document.querySelectorAll('.credential-reveal').forEach(btn => {
            btn.addEventListener('click', async () => {
                const fieldKey = btn.dataset.field;       // apiKey / apiSecret / username / password
                const target = btn.dataset.target;        // "Input.CloudPassword" etc.
                const input = document.querySelector(`[name="${target}"]`);
                if (!input) return;

                const icon = btn.querySelector('i');
                const isPasswordType = input.type === 'password';

                // If already populated → just toggle visibility
                if (input.value && input.value.length > 0) {
                    if (isPasswordType) {
                        input.type = 'text';
                        icon.className = 'bi bi-eye-slash';
                    } else if (fieldKey === 'username') {
                        // username is always plain text — nothing to toggle
                    } else {
                        input.type = 'password';
                        icon.className = 'bi bi-eye';
                    }
                    return;
                }

                // Empty input + Saved value exists → fetch from server
                btn.disabled = true;
                icon.className = 'bi bi-hourglass-split';
                try {
                    const r = await fetch(`/api/installations/@Model.Input.Id/credential/${fieldKey}`,
                        { headers: { 'Accept': 'application/json' } });
                    if (r.status === 403) {
                        alert('เฉพาะ Admin เท่านั้นที่ดูค่าที่บันทึกไว้ได้');
                        icon.className = 'bi bi-eye';
                        return;
                    }
                    if (!r.ok) {
                        alert(`โหลดไม่สำเร็จ (HTTP ${r.status})`);
                        icon.className = 'bi bi-eye';
                        return;
                    }
                    const data = await r.json();
                    if (!data.value) {
                        alert(data.note || '(no value stored)');
                        icon.className = 'bi bi-eye';
                        return;
                    }
                    input.value = data.value;
                    if (fieldKey !== 'username') {
                        input.type = 'text';
                        icon.className = 'bi bi-eye-slash';
                    } else {
                        icon.className = 'bi bi-check2';
                    }
                } catch (e) {
                    alert('ผิดพลาด: ' + e.message);
                    icon.className = 'bi bi-eye';
                } finally {
                    btn.disabled = false;
                }
            });
        });

        // ─── LINE test-send button ───────────────────────────────────────────
        document.getElementById('lineTestBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('lineTestBtn');
            const result = document.getElementById('lineTestResult');
            btn.disabled = true;
            result.innerHTML = '<span class="text-muted"><i class="bi bi-hourglass-split"></i> กำลังส่ง...</span>';
            try {
                const r = await fetch(`/api/installations/@Model.Input.Id/notify-test`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                const data = await r.json();
                if (data.success) {
                    result.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> ${data.message}</span>`;
                } else {
                    result.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle-fill"></i> ${data.message}</span>`;
                }
            } catch (e) {
                result.innerHTML = `<span class="text-danger">❌ Error: ${e.message}</span>`;
            } finally {
                btn.disabled = false;
            }
        });

        // ─── Service-scope preset → flag auto-toggling ───────────────────────
        // Maps each preset to the five Includes* flags so picking a preset
        // updates the checkboxes in one click. Picking "Custom" preserves
        // whatever's currently ticked (so the operator can fine-tune).
        // Values mirror the ServiceLevel enum in code.
        const SERVICE_LEVEL_PRESETS = {
            0:  { mon: true,  clean: true,  pm: true,  cm: true,  warr: true  }, // FullOM
            1:  { mon: true,  clean: false, pm: false, cm: false, warr: false }, // MonitoringOnly
            2:  { mon: false, clean: true,  pm: false, cm: false, warr: false }, // CleaningOnly
            3:  { mon: false, clean: true,  pm: true,  cm: false, warr: false }, // PreventiveOnly
            // 99 (Custom) intentionally absent → no auto-fill
        };
        const flagMap = {
            mon:   'Input.IncludesMonitoring',
            clean: 'Input.IncludesCleaning',
            pm:    'Input.IncludesPreventiveMaintenance',
            cm:    'Input.IncludesCorrectiveMaintenance',
            warr:  'Input.IncludesWarrantyService',
        };
        document.querySelectorAll('input[name="Input.ServiceLevel"]').forEach(radio => {
            radio.addEventListener('change', e => {
                const preset = SERVICE_LEVEL_PRESETS[parseInt(e.target.value, 10)];
                if (!preset) return; // Custom: leave checkboxes alone
                Object.entries(flagMap).forEach(([k, name]) => {
                    const el = document.querySelector(`[name="${name}"]`);
                    if (el) el.checked = preset[k];
                });
            });
        });
        // Reverse direction: if the operator un-ticks any flag manually,
        // jump the preset to "Custom" so the saved state reflects the actual
        // configuration (avoids the preset claiming FullOM while a flag is off).
        document.querySelectorAll('.service-flag').forEach(cb => {
            cb.addEventListener('change', () => {
                const customRadio = document.getElementById('svc-Custom');
                if (customRadio) customRadio.checked = true;
            });
        });

        // When customer dropdown changes, fetch customer info to populate edit fields
        document.getElementById('customerSelect')?.addEventListener('change', async (e) => {
            const cid = e.target.value;
            if (!cid) return;
            try {
                const r = await fetch(`/api/customers/${cid}`);
                if (r.ok) {
                    const c = await r.json();
                    const fn = document.querySelector('[name="Input.CustomerFirstName"]');
                    const ln = document.querySelector('[name="Input.CustomerLastName"]');
                    const ph = document.querySelector('[name="Input.CustomerPhone"]');
                    const em = document.querySelector('[name="Input.CustomerEmail"]');
                    if (fn) fn.value = c.firstName || '';
                    if (ln) ln.value = c.lastName || '';
                    if (ph) ph.value = c.phone || '';
                    if (em) em.value = c.email || '';
                }
            } catch { /* ignore — fields stay as-is */ }
        });
    </script>
}
