@page "{id:int}"
@model SolarApp.Pages.Installations.EditModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "แก้ไขไซต์งาน";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Edit Installation</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    <input type="hidden" asp-for="Input.CustomerId" />

                    <!-- Site Information -->
                    <h6 class="text-muted mb-3">Site Information</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.SiteName" class="form-label">Site Name *</label>
                            <input asp-for="Input.SiteName" class="form-control" />
                            <span asp-validation-for="Input.SiteName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Address" class="form-label">Address *</label>
                            <input asp-for="Input.Address" id="edtAddress" class="form-control" />
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label asp-for="Input.Latitude" class="form-label">Latitude</label>
                            <input asp-for="Input.Latitude" id="edtLat" class="form-control" step="any" />
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Input.Longitude" class="form-label">Longitude</label>
                            <input asp-for="Input.Longitude" id="edtLng" class="form-control" step="any" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end gap-1">
                            <button type="button" id="btnReverseGeocode" class="btn btn-outline-info btn-sm w-100"
                                    title="Look up address from lat/lng">
                                <i class="bi bi-search"></i> Find
                            </button>
                        </div>
                    </div>

                    <!-- Customer & Partner -->
                    <h6 class="text-muted mb-3 mt-4">Customer & Partner</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CustomerId" class="form-label">Customer</label>
                            <select asp-for="Input.CustomerId" asp-items="Model.Customers" class="form-select" id="customerSelect">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PartnerId" class="form-label">Partner</label>
                            <select asp-for="Input.PartnerId" asp-items="Model.Partners" class="form-select">
                                <option value="">-- No Partner (Direct Sale) --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#customerEditSection">
                                <i class="bi bi-pencil"></i> แก้ไขข้อมูลลูกค้า
                            </button>
                        </div>
                    </div>
                    <div class="collapse" id="customerEditSection">
                        <div class="card card-body bg-light mb-3">
                            <div class="row mb-2">
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerFirstName" class="form-label">ชื่อ</label>
                                    <input asp-for="Input.CustomerFirstName" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerLastName" class="form-label">นามสกุล</label>
                                    <input asp-for="Input.CustomerLastName" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerPhone" class="form-label">เบอร์โทร</label>
                                    <input asp-for="Input.CustomerPhone" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.CustomerEmail" class="form-label">Email</label>
                                    <input asp-for="Input.CustomerEmail" class="form-control" type="email" />
                                </div>
                            </div>
                            <small class="text-muted">การแก้ไขจะเปลี่ยนข้อมูลลูกค้าที่เลือกอยู่ (ไม่ใช่แค่ไซต์นี้)</small>
                        </div>
                    </div>

                    <!-- System Specs -->
                    <h6 class="text-muted mb-3 mt-4">System Specifications</h6>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InverterBrand" class="form-label">Inverter Brand *</label>
                            <select asp-for="Input.InverterBrand" asp-items="Html.GetEnumSelectList<InverterBrand>()" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterModel" class="form-label">Inverter Model</label>
                            <input asp-for="Input.InverterModel" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterSizeKw" class="form-label">Inverter Size (kW) *</label>
                            <input asp-for="Input.InverterSizeKw" class="form-control" type="number" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterCount" class="form-label"># of Inverters *</label>
                            <input asp-for="Input.InverterCount" class="form-control" type="number" min="1" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.SystemCapacityKw" class="form-label">System Capacity (kWp) *</label>
                            <input asp-for="Input.SystemCapacityKw" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.NumberOfPanels" class="form-label"># of Panels *</label>
                            <input asp-for="Input.NumberOfPanels" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.PanelWattage" class="form-label">Panel Wattage (W) *</label>
                            <input asp-for="Input.PanelWattage" class="form-control" />
                        </div>
                    </div>

                    <!-- Cloud API -->
                    <h6 class="text-muted mb-3 mt-4">Cloud API Connection</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            @* PlantId is NOT a secret — show actual value for verification *@
                            <label asp-for="Input.PlantId" class="form-label">
                                Plant/Station ID
                                @if (Model.HasPlantId) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <input asp-for="Input.PlantId" class="form-control"
                                   placeholder="Enter Plant/Station ID" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CloudApiKey" class="form-label">
                                API Key
                                @if (Model.HasApiKey) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <input asp-for="Input.CloudApiKey" class="form-control"
                                   placeholder="@(Model.HasApiKey ? "•••••••••• (saved — leave blank to keep)" : "Enter API Key")" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CloudUsername" class="form-label">
                                Cloud Username
                                @if (Model.HasUsername) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            @* Username is NOT a secret — show the actual value for verification *@
                            <input asp-for="Input.CloudUsername" class="form-control"
                                   placeholder="Enter username (email/phone)" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CloudPassword" class="form-label">
                                Cloud Password
                                @if (Model.HasPassword) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <input asp-for="Input.CloudPassword" class="form-control" type="password"
                                   placeholder="@(Model.HasPassword ? "•••••••••• (saved — leave blank to keep)" : "Enter password")" />
                        </div>
                    </div>

                    <!-- Advanced: API endpoint override -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <label asp-for="Input.CloudApiBaseUrl" class="form-label">
                                <i class="bi bi-gear"></i> API Endpoint Override
                                <span class="badge bg-secondary ms-1">Advanced</span>
                            </label>
                            <input asp-for="Input.CloudApiBaseUrl" class="form-control"
                                   placeholder="เว้นว่างเพื่อให้ระบบเลือกอัตโนมัติ — กรอกเมื่อ login ผิด region" />
                            <div class="form-text">
                                ใช้เฉพาะเมื่อ account อยู่บน server ที่ระบบเลือกไม่ถูก (เช่น
                                <code>https://global.hoymiles.com</code> สำหรับ Hoymiles S-Miles Cloud Global)
                                — โดยปกติเว้นว่างไว้
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CloudApiSecret" class="form-label">
                                API Secret
                                @if (Model.HasApiSecret) { <span class="badge bg-success ms-1">Saved</span> }
                            </label>
                            <input asp-for="Input.CloudApiSecret" class="form-control" type="password"
                                   placeholder="@(Model.HasApiSecret ? "•••••••••• (saved — leave blank to keep)" : "Enter secret")" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="button" id="testConnectionBtn" class="btn btn-outline-info">
                                <i class="bi bi-plug"></i> Test Connection & Fetch Data
                            </button>
                        </div>
                    </div>
                    <div id="testResult"></div>

                    @if (!string.IsNullOrEmpty(Model.CredentialStorageNote))
                    {
                        <div class="alert alert-light small py-1 px-2 mt-2 mb-3">
                            <i class="bi bi-database"></i>
                            <strong>Storage:</strong> @Model.CredentialStorageNote
                            <br /><small class="text-muted">
                                Credential fields are blank on purpose — leave blank to keep existing saved values.
                                Only type a new value if you want to CHANGE it.
                            </small>
                        </div>
                    }

                    <!-- Warranty & Maintenance -->
                    <h6 class="text-muted mb-3 mt-4">Warranty & Maintenance</h6>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InstallationDate" class="form-label">Installation Date *</label>
                            <input asp-for="Input.InstallationDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.CommissionDate" class="form-label">Commission Date</label>
                            <input asp-for="Input.CommissionDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.WarrantyYears" class="form-label">Warranty (Years) *</label>
                            <input asp-for="Input.WarrantyYears" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.TotalCleaningCount" class="form-label">Total Cleanings</label>
                            <input asp-for="Input.TotalCleaningCount" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.ElectricityRatePerKwh" class="form-label">Electricity Rate (THB/kWh)</label>
                            <input asp-for="Input.ElectricityRatePerKwh" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ─── Reverse geocode: lat/lng → Address ───
        document.getElementById('btnReverseGeocode')?.addEventListener('click', async () => {
            const btn = document.getElementById('btnReverseGeocode');
            const lat = parseFloat(document.getElementById('edtLat').value);
            const lng = parseFloat(document.getElementById('edtLng').value);
            if (isNaN(lat) || isNaN(lng)) { window.toast.warning('Please fill both Latitude and Longitude first'); return; }

            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            try {
                const r = await fetch(`/api/geocode/reverse?lat=${lat}&lng=${lng}&lang=th,en`);
                const data = await r.json();
                if (data.success && data.address) {
                    if (!document.getElementById('edtAddress').value
                        || confirm(`Replace current address with:\n${data.address}`)) {
                        document.getElementById('edtAddress').value = data.address;
                        window.toast.success('Address resolved');
                    }
                } else {
                    window.toast.error('Could not resolve address: ' + (data.message || 'unknown'));
                }
            } catch (e) {
                window.toast.error('Geocoding failed: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });

        document.getElementById('testConnectionBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('testConnectionBtn');
            const result = document.getElementById('testResult');
            const formData = new FormData();
            formData.append('brand', document.querySelector('[name="Input.InverterBrand"]').value);
            formData.append('apiKey', document.querySelector('[name="Input.CloudApiKey"]').value);
            formData.append('apiSecret', document.querySelector('[name="Input.CloudApiSecret"]').value);
            formData.append('username', document.querySelector('[name="Input.CloudUsername"]').value);
            formData.append('password', document.querySelector('[name="Input.CloudPassword"]').value);
            formData.append('plantId', document.querySelector('[name="Input.PlantId"]').value);
            formData.append('apiBaseUrl', document.querySelector('[name="Input.CloudApiBaseUrl"]').value);
            // Send installation ID so the endpoint can fall back to stored credentials
            // when fields are left blank (Edit page preserves existing saved values).
            formData.append('installationId', '@Model.Input.Id');

            btn.disabled = true;
            result.innerHTML = '<span class="text-muted"><i class="spinner-border spinner-border-sm"></i> Testing...</span>';

            try {
                const r = await fetch('/api/test-inverter-connection', { method: 'POST', body: formData });
                const data = await r.json();
                if (data.success) {
                    let html = '<div class="alert alert-success mt-2 mb-0 p-2"><i class="bi bi-check-circle-fill"></i> ' + data.message + '</div>';

                    if (data.plantInfo) {
                        html += '<div class="card mt-2 border-success"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-success">Plant Info</h6>';
                        html += '<div><strong>ID:</strong> ' + (data.plantInfo.plantId || '-') + '</div>';
                        html += '<div><strong>Name:</strong> ' + (data.plantInfo.plantName || '-') + '</div>';
                        html += '<div><strong>Capacity:</strong> ' + (data.plantInfo.capacityKw || 0) + ' kW</div>';
                        if (data.plantInfo.address) html += '<div><strong>Address:</strong> ' + data.plantInfo.address + '</div>';
                        html += '</div></div>';
                    }

                    if (data.realtime) {
                        const rt = data.realtime;
                        html += '<div class="card mt-2 border-info"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-info">Live Data</h6>';
                        html += '<div><strong>Status:</strong> <span class="badge bg-' + (rt.isOnline ? 'success' : 'secondary') + '">' + (rt.isOnline ? 'ONLINE' : 'OFFLINE') + '</span></div>';
                        html += '<div><strong>Current Power:</strong> ' + (rt.currentPowerKw || 0).toFixed(2) + ' kW</div>';
                        html += '<div><strong>Today Energy:</strong> ' + (rt.todayEnergyKwh || 0).toFixed(2) + ' kWh</div>';
                        html += '<div><strong>Total Energy:</strong> ' + (rt.totalEnergyKwh || 0).toFixed(2) + ' kWh</div>';
                        if (rt.batterySocPercent !== null) html += '<div><strong>Battery SOC:</strong> ' + rt.batterySocPercent + '%</div>';
                        html += '<div class="text-muted small">Updated: ' + new Date(rt.timestamp).toLocaleString() + '</div>';
                        html += '</div></div>';
                    }

                    if (data.deviceCount > 0) {
                        html += '<div class="card mt-2 border-warning"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-warning">Devices (' + data.deviceCount + ')</h6>';
                        for (const d of data.devices) {
                            html += '<div>• ' + d.deviceName + ' (' + (d.model || d.deviceId) + ') - ' + (d.isOnline ? 'Online' : 'Offline') + '</div>';
                        }
                        html += '</div></div>';
                    }

                    if (!data.plantInfo && !data.realtime) {
                        html += '<div class="alert alert-warning mt-2 mb-0 p-2"><i class="bi bi-exclamation-triangle"></i> Connected, but no plant/realtime data returned. Check Plant ID.</div>';
                    }

                    result.innerHTML = html;
                } else {
                    result.innerHTML = '<div class="alert alert-danger mt-2 mb-0 p-2"><i class="bi bi-x-circle-fill"></i> ' + data.message + '</div>';
                }
            } catch (e) {
                result.innerHTML = '<div class="alert alert-danger mt-2 mb-0 p-2"><i class="bi bi-x-circle-fill"></i> Test failed: ' + e.message + '</div>';
            } finally {
                btn.disabled = false;
            }
        });

        // When customer dropdown changes, fetch customer info to populate edit fields
        document.getElementById('customerSelect')?.addEventListener('change', async (e) => {
            const cid = e.target.value;
            if (!cid) return;
            try {
                const r = await fetch(`/api/customers/${cid}`);
                if (r.ok) {
                    const c = await r.json();
                    const fn = document.querySelector('[name="Input.CustomerFirstName"]');
                    const ln = document.querySelector('[name="Input.CustomerLastName"]');
                    const ph = document.querySelector('[name="Input.CustomerPhone"]');
                    const em = document.querySelector('[name="Input.CustomerEmail"]');
                    if (fn) fn.value = c.firstName || '';
                    if (ln) ln.value = c.lastName || '';
                    if (ph) ph.value = c.phone || '';
                    if (em) em.value = c.email || '';
                }
            } catch { /* ignore — fields stay as-is */ }
        });
    </script>
}
