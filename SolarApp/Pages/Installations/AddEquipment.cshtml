@page "{installationId:int}"
@model SolarApp.Pages.Installations.AddEquipmentModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "เพิ่มอุปกรณ์";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Add Equipment to @Model.Installation.SiteName</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.EquipmentType" class="form-label">Equipment Type *</label>
                            <select asp-for="Input.EquipmentType" asp-items="Html.GetEnumSelectList<EquipmentType>()" class="form-select"></select>
                            <span asp-validation-for="Input.EquipmentType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Brand" class="form-label">Brand *</label>
                            <input asp-for="Input.Brand" class="form-control" />
                            <span asp-validation-for="Input.Brand" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Model" class="form-label">Model *</label>
                            <input asp-for="Input.Model" class="form-control" />
                            <span asp-validation-for="Input.Model" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.SerialNumber" class="form-label">หมายเลขเครื่อง</label>
                            <input asp-for="Input.SerialNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.Quantity" class="form-label">Quantity *</label>
                            <input asp-for="Input.Quantity" class="form-control" />
                            <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-3" id="ratingKwWrap">
                            <label asp-for="Input.RatingKw" class="form-label">
                                Rating (kW) <span class="text-muted small" id="ratingKwHint">กำลังต่อหน่วย</span>
                            </label>
                            <input asp-for="Input.RatingKw" class="form-control" type="number" step="any" placeholder="เช่น 10" />
                        </div>
                        <div class="col-md-3" id="ratingWattsWrap" style="display:none">
                            <label asp-for="Input.RatingWatts" class="form-label">กำลังต่อแผง (W)</label>
                            <input asp-for="Input.RatingWatts" class="form-control" type="number" placeholder="เช่น 450" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.WarrantyYears" class="form-label">Warranty (Years) *</label>
                            <input asp-for="Input.WarrantyYears" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InstalledDate" class="form-label">Installed Date *</label>
                            <input asp-for="Input.InstalledDate" class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Notes" class="form-label">หมายเหตุ</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Detail" asp-route-id="@Model.Installation.Id" class="btn btn-outline-secondary">ยกเลิก</a>
                        <button type="submit" class="btn btn-warning">เพิ่มอุปกรณ์</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the right rating field based on equipment type
        const typeSelect = document.querySelector('[name="Input.EquipmentType"]');
        const kwWrap = document.getElementById('ratingKwWrap');
        const wattsWrap = document.getElementById('ratingWattsWrap');
        const kwHint = document.getElementById('ratingKwHint');

        function updateRatingField() {
            const val = typeSelect.value;
            // SolarPanel = 2
            if (val === '2' || val === 'SolarPanel') {
                kwWrap.style.display = 'none';
                wattsWrap.style.display = '';
            } else {
                kwWrap.style.display = '';
                wattsWrap.style.display = 'none';

                // Inverter=1, Battery=3, Meter=4
                if (val === '1' || val === 'Inverter') kwHint.textContent = 'kW per inverter';
                else if (val === '3' || val === 'Battery') kwHint.textContent = 'kWh per battery';
                else kwHint.textContent = 'Power per unit';
            }
        }
        typeSelect?.addEventListener('change', updateRatingField);
        updateRatingField();
    </script>
}
