@page "{id:int}"
@model SolarApp.Pages.Installations.DiagnosticsModel
@{
    ViewData["Title"] = $"ตรวจสอบการเชื่อมต่อ - {Model.Installation.SiteName}";
    var inst = Model.Installation;
    var r = Model.Report;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">ตรวจสอบการเชื่อมต่อ</h4>
        <small class="text-muted">@inst.SiteName · @inst.InverterBrand</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Detail" asp-route-id="@inst.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> กลับ
        </a>
        <a asp-page="Diagnostics" asp-route-id="@inst.Id" asp-route-run="true" class="btn btn-warning btn-sm">
            <i class="bi bi-arrow-clockwise"></i> ตรวจแบบเร็ว
        </a>
        <a asp-page="Diagnostics" asp-route-id="@inst.Id" asp-route-deep="true" class="btn btn-danger btn-sm">
            <i class="bi bi-shield-check"></i> ตรวจเชิงลึก
        </a>
    </div>
</div>

<!-- Installation Summary -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 small">
            <div class="col-6 col-md-3">
                <div class="text-muted">ยี่ห้อ</div>
                <strong>@inst.InverterBrand</strong>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted">Plant ID</div>
                <strong class="text-break">@(inst.PlantId ?? "-")</strong>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted">สถานะ</div>
                <span class="badge @(inst.Status.ToString() == "Active" ? "bg-success" : "bg-secondary")">@inst.Status</span>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted">ออนไลน์ล่าสุด</div>
                <strong>@(inst.LastOnlineAt?.ToString("dd/MM HH:mm") ?? "ไม่เคย")</strong>
            </div>
        </div>
    </div>
</div>

@if (r == null)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body text-center py-5">
            <i class="bi bi-clipboard-check text-muted" style="font-size:3rem"></i>
            <h5 class="mt-3">ตรวจสอบการเชื่อมต่อ</h5>
            <p class="text-muted">ทดสอบการเชื่อมต่อครบทุกขั้นตอน:</p>
            <ul class="list-unstyled small text-start d-inline-block mb-4">
                <li>✓ ตรวจข้อมูลรับรอง (credentials)</li>
                <li>✓ การเข้าสู่ระบบผู้ผลิต</li>
                <li>✓ ดึงข้อมูลโรงไฟฟ้า</li>
                <li>✓ ข้อมูลเรียลไทม์</li>
                <li>✓ ข้อมูลย้อนหลัง (7 วัน)</li>
                <li>✓ รายการอุปกรณ์</li>
                <li>✓ การแจ้งเตือนจากผู้ผลิต</li>
            </ul>
            <div>
                <a asp-page="Diagnostics" asp-route-id="@inst.Id" asp-route-run="true" class="btn btn-warning">
                    <i class="bi bi-play-fill"></i> เริ่มตรวจสอบเดี๋ยวนี้
                </a>
            </div>
        </div>
    </div>
}
else
{
    var alertClass = r.OverallSuccess ? "alert-success" : r.FailedCount >= 3 ? "alert-danger" : "alert-warning";
    <div class="alert @alertClass d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h6 class="mb-1">
                @if (r.OverallSuccess)
                {
                    <span><i class="bi bi-check-circle-fill"></i> ผ่านทุกขั้นตอน</span>
                }
                else
                {
                    <span><i class="bi bi-exclamation-triangle-fill"></i> มีบางขั้นตอนไม่ผ่าน</span>
                }
            </h6>
            <div class="small">@r.Summary · ตรวจเมื่อ @r.RunAt.ToString("HH:mm:ss")</div>
        </div>
        <div class="d-flex gap-3">
            <div class="text-center">
                <div class="fs-4 fw-bold text-success">@r.PassedCount</div>
                <small>ผ่าน</small>
            </div>
            <div class="text-center">
                <div class="fs-4 fw-bold text-danger">@r.FailedCount</div>
                <small>ไม่ผ่าน</small>
            </div>
        </div>
    </div>

    <!-- Step-by-step results -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><h6 class="mb-0">ผลตรวจแต่ละขั้นตอน</h6></div>
        <div class="list-group list-group-flush">
            @foreach (var step in r.Steps)
            {
                var icon = step.Success ? "check-circle-fill text-success" : "x-circle-fill text-danger";
                <div class="list-group-item">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-@icon fs-5 mt-1"></i>
                        <div class="flex-grow-1 min-width-0">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <strong>@step.Name</strong>
                                <div class="small text-muted">
                                    @if (step.ItemCount > 0)
                                    {
                                        <span class="me-2"><i class="bi bi-list-ol"></i> @step.ItemCount รายการ</span>
                                    }
                                    <span><i class="bi bi-clock"></i> @step.DurationMs ms</span>
                                </div>
                            </div>
                            <div class="mt-1 @(step.Success ? "" : "text-danger")">@step.Message</div>
                            @if (!string.IsNullOrEmpty(step.Detail))
                            {
                                <div class="small text-muted mt-1">
                                    <code class="text-body-secondary">@step.Detail</code>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (Model.HealthReport is { } hr)
{
    var hrClass = hr.OverallHealthy ? "alert-success"
        : hr.ApiReachable && !hr.DeviceOnline ? "alert-warning"
        : "alert-danger";
    <div class="alert @hrClass d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h6 class="mb-1">
                @if (hr.OverallHealthy)
                { <i class="bi bi-check-circle-fill text-success"></i> <span>ผ่านครบทุกชั้น</span> }
                else if (hr.ApiReachable && !hr.DeviceOnline)
                { <i class="bi bi-exclamation-triangle-fill text-warning"></i> <span>API ปกติ แต่อุปกรณ์ออฟไลน์</span> }
                else
                { <i class="bi bi-x-circle-fill text-danger"></i> <span>พบปัญหาการเชื่อมต่อ</span> }
            </h6>
            <div class="small">@hr.Summary</div>
        </div>
        <div class="d-flex gap-3">
            <div class="text-center"><div class="fs-5 fw-bold text-success">@hr.PassedCount</div><small>ผ่าน</small></div>
            <div class="text-center"><div class="fs-5 fw-bold text-danger">@hr.FailedCount</div><small>ไม่ผ่าน</small></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-layers"></i> ตรวจสุขภาพการเชื่อมต่อ 6 ชั้น</h6></div>
        <div class="list-group list-group-flush">
            @foreach (var step in hr.Steps)
            {
                var icon = step.Passed ? "check-circle-fill text-success" : "x-circle-fill text-danger";
                var issueTag = step.IssueType switch
                {
                    SolarApp.Services.InverterApi.Common.ConnectionIssueType.DeviceOffline => "badge bg-warning text-dark",
                    SolarApp.Services.InverterApi.Common.ConnectionIssueType.None => "d-none",
                    _ => "badge bg-danger"
                };
                <div class="list-group-item">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-@icon fs-5 mt-1"></i>
                        <div class="flex-grow-1 min-width-0">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <strong>@step.Layer — @step.Name</strong>
                                    @if (step.IssueType != SolarApp.Services.InverterApi.Common.ConnectionIssueType.None)
                                    {
                                        <span class="@issueTag ms-2">@step.IssueType</span>
                                    }
                                </div>
                                <small class="text-muted"><i class="bi bi-clock"></i> @step.DurationMs ms</small>
                            </div>
                            <div class="mt-1 small @(step.Passed ? "" : "text-danger")">
                                @step.Message
                            </div>
                            @if (!string.IsNullOrEmpty(step.TechnicalDetail))
                            {
                                <div class="mt-1 small text-muted"><code>@step.TechnicalDetail</code></div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Recent API Call Logs -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h6 class="mb-0">การเรียก API ล่าสุด (20 รายการ)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>เวลา</th>
                        <th>ปลายทาง</th>
                        <th>ผล</th>
                        <th>HTTP</th>
                        <th>ข้อผิดพลาด</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.RecentLogs)
                    {
                        <tr>
                            <td class="text-nowrap"><small>@log.RequestTime.ToString("dd/MM HH:mm:ss")</small></td>
                            <td><small>@log.Endpoint</small></td>
                            <td>
                                @if (log.IsSuccess)
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">FAIL</span>
                                }
                            </td>
                            <td><small>@log.ResponseStatusCode</small></td>
                            <td class="text-truncate" style="max-width:300px">
                                <small class="text-danger">@log.ErrorMessage</small>
                            </td>
                        </tr>
                    }
                    @if (!Model.RecentLogs.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">ยังไม่มีบันทึกการเรียก API</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
