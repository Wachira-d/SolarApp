@page "{id:int}"
@model SolarApp.Pages.Installations.DeleteEquipmentModel
@{
    ViewData["Title"] = "ลบอุปกรณ์";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0 text-danger">Delete Equipment</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Are you sure you want to delete this equipment? This action cannot be undone.
                </div>

                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="text-muted">Installation</td>
                        <td class="fw-bold">@Model.Equipment.Installation.SiteName</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Type</td>
                        <td>@Model.Equipment.EquipmentType</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Brand</td>
                        <td>@Model.Equipment.Brand</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Model</td>
                        <td>@Model.Equipment.Model</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Serial Number</td>
                        <td>@(Model.Equipment.SerialNumber ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Quantity</td>
                        <td>@Model.Equipment.Quantity</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Installed Date</td>
                        <td>@Model.Equipment.InstalledDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Warranty Expiry</td>
                        <td>@(Model.Equipment.WarrantyExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Equipment.Notes))
                    {
                        <tr>
                            <td class="text-muted">Notes</td>
                            <td>@Model.Equipment.Notes</td>
                        </tr>
                    }
                </table>

                <form method="post" class="d-flex justify-content-between mt-3">
                    <a asp-page="Detail" asp-route-id="@Model.Equipment.InstallationId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">Delete Equipment</button>
                </form>
            </div>
        </div>
    </div>
</div>
