@page "{id:int}"
@model SolarApp.Pages.Installations.CleaningModel
@{
    ViewData["Title"] = $"ล้างแผง - {Model.Installation.SiteName}";
    var inst = Model.Installation;
}

<div class="d-flex justify-content-between mb-3">
    <div>
        <h4>ล้างแผงโซลาร์: @inst.SiteName</h4>
        <p class="text-muted mb-0">
            @if (inst.TotalCleaningCount > 0)
            {
                <span>ล้างแล้ว: @inst.CompletedCleaningCount / @inst.TotalCleaningCount ครั้ง | คงเหลือ: @Math.Max(0, inst.RemainingCleanings) ครั้ง |</span>
            }
            else
            {
                <span>ล้างแล้ว: @inst.CompletedCleaningCount ครั้ง (ตามรอบ ไม่จำกัด) |</span>
            }
            ครบกำหนดครั้งถัดไป: @(inst.NextCleaningDueDate?.ToString("dd/MM/yyyy") ?? "ไม่มี")
        </p>
    </div>
    <a asp-page="Detail" asp-route-id="@inst.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> กลับ
    </a>
</div>

@* Recording a cleaning on a site we don't clean is allowed — a one-off job
   still needs its photos kept — but it must be obvious that doing so won't
   start a schedule, or someone will wonder why no reminder ever comes. *@
@if (!inst.IncludesCleaning)
{
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle"></i>
        ไซต์นี้<strong>ไม่อยู่ในสัญญาล้างแผง</strong> — บันทึกการล้างได้ (เช่น งานครั้งเดียว)
        แต่ระบบจะไม่ตั้งรอบนัดถัดไปและไม่แจ้งเตือน
        เปิดได้ที่ <a asp-page="Edit" asp-route-id="@inst.Id">ขอบเขตบริการ</a>
    </div>
}
else if (inst.CleaningContractUsedUp)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        ล้างครบ @inst.TotalCleaningCount ครั้งตามสัญญาแล้ว — ไม่มีรอบนัดถัดไปและไม่แจ้งเตือน
        ถ้าต่อสัญญา ให้เพิ่มจำนวนครั้งใน <a asp-page="Edit" asp-route-id="@inst.Id">หน้าแก้ไข</a>
    </div>
}

<!-- Add New Cleaning -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white"><h6 class="mb-0">บันทึกการล้างแผง</h6></div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Input.InstallationId" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">วันที่นัดหมาย</label>
                    <input asp-for="Input.ScheduledDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">วันที่ล้างจริง</label>
                    <input asp-for="Input.ActualDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">ผู้ดำเนินการ</label>
                    <input asp-for="Input.PerformedByExternal" class="form-control" placeholder="ชื่อผู้รับเหมา" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">หมายเหตุ</label>
                    <input asp-for="Input.Notes" class="form-control" />
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label">รูปก่อนล้าง</label>
                    <input type="file" name="BeforePhotoFiles" class="form-control" multiple accept="image/*" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">รูปหลังล้าง</label>
                    <input type="file" name="AfterPhotoFiles" class="form-control" multiple accept="image/*" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2 align-items-center">
                <div class="form-check">
                    <input asp-for="Input.MarkCompleted" class="form-check-input" />
                    <label asp-for="Input.MarkCompleted" class="form-check-label">ทำเครื่องหมายว่าเสร็จแล้ว</label>
                </div>
                <button type="submit" class="btn btn-warning btn-sm ms-auto">
                    <i class="bi bi-plus"></i> เพิ่มรายการ
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Cleaning History -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">ประวัติการล้างแผง</h6></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>#</th><th>วันนัดหมาย</th><th>วันที่ล้างจริง</th><th>สถานะ</th><th>ผู้ดำเนินการ</th><th>รูปภาพ</th><th>หมายเหตุ</th><th></th></tr>
                </thead>
                <tbody>
                    @{ var idx = Model.Records.Count; }
                    @foreach (var r in Model.Records)
                    {
                        var statusClass = r.Status switch
                        {
                            SolarApp.Models.Enums.CleaningStatus.Completed => "bg-success",
                            SolarApp.Models.Enums.CleaningStatus.Scheduled => "bg-primary",
                            SolarApp.Models.Enums.CleaningStatus.Missed => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>@(idx--)</td>
                            <td>@r.ScheduledDate.ToString("dd/MM/yyyy")</td>
                            <td>@(r.ActualDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td><span class="badge @statusClass">@r.Status</span></td>
                            <td>@(r.PerformedByExternal ?? r.PerformedByUser?.FullName ?? "-")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var url in r.BeforePhotoList.Take(3))
                                    {
                                        <a href="@url" target="_blank"><img src="@url" style="width:40px;height:40px;object-fit:cover" class="img-thumbnail" title="ก่อนล้าง" /></a>
                                    }
                                    @foreach (var url in r.AfterPhotoList.Take(3))
                                    {
                                        <a href="@url" target="_blank"><img src="@url" style="width:40px;height:40px;object-fit:cover" class="img-thumbnail border-success" title="หลังล้าง" /></a>
                                    }
                                    @if (!r.BeforePhotoList.Any() && !r.AfterPhotoList.Any())
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </div>
                            </td>
                            <td><small>@(r.Notes ?? "-")</small></td>
                            <td class="text-nowrap">
                                @if (r.Status == SolarApp.Models.Enums.CleaningStatus.Scheduled)
                                {
                                    <form method="post" asp-page-handler="Complete" class="d-inline">
                                        <input type="hidden" name="recordId" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">เสร็จสิ้น</button>
                                    </form>
                                }
                                <button class="btn btn-sm btn-outline-info" type="button" data-bs-toggle="collapse" data-bs-target="#photos-@r.Id" title="เพิ่ม/ลบรูปภาพ">
                                    <i class="bi bi-camera"></i>
                                </button>
                            </td>
                        </tr>
                        <tr class="collapse" id="photos-@r.Id">
                            <td colspan="8" class="bg-light">
                                <div class="row g-3 py-2">
                                    <div class="col-md-6">
                                        <strong>รูปก่อนล้าง</strong>
                                        <div class="d-flex flex-wrap gap-2 my-2">
                                            @foreach (var url in r.BeforePhotoList)
                                            {
                                                <div class="position-relative" style="width:100px">
                                                    <a href="@url" target="_blank"><img src="@url" style="width:100px;height:100px;object-fit:cover" class="img-thumbnail" /></a>
                                                    <form method="post" asp-page-handler="RemovePhoto" class="position-absolute top-0 end-0">
                                                        <input type="hidden" name="recordId" value="@r.Id" />
                                                        <input type="hidden" name="url" value="@url" />
                                                        <input type="hidden" name="kind" value="before" />
                                                        <button type="submit" class="btn btn-sm btn-danger rounded-circle" style="width:22px;height:22px;padding:0;font-size:11px" onclick="return confirm('ลบรูปนี้?');">×</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="AddPhoto" enctype="multipart/form-data" class="d-flex gap-2">
                                            <input type="hidden" name="recordId" value="@r.Id" />
                                            <input type="hidden" name="kind" value="before" />
                                            <input type="file" name="BeforePhotoFiles" class="form-control form-control-sm" multiple accept="image/*" />
                                            <button type="submit" class="btn btn-sm btn-primary">อัปโหลด</button>
                                        </form>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>รูปหลังล้าง</strong>
                                        <div class="d-flex flex-wrap gap-2 my-2">
                                            @foreach (var url in r.AfterPhotoList)
                                            {
                                                <div class="position-relative" style="width:100px">
                                                    <a href="@url" target="_blank"><img src="@url" style="width:100px;height:100px;object-fit:cover" class="img-thumbnail border-success" /></a>
                                                    <form method="post" asp-page-handler="RemovePhoto" class="position-absolute top-0 end-0">
                                                        <input type="hidden" name="recordId" value="@r.Id" />
                                                        <input type="hidden" name="url" value="@url" />
                                                        <input type="hidden" name="kind" value="after" />
                                                        <button type="submit" class="btn btn-sm btn-danger rounded-circle" style="width:22px;height:22px;padding:0;font-size:11px" onclick="return confirm('ลบรูปนี้?');">×</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="AddPhoto" enctype="multipart/form-data" class="d-flex gap-2">
                                            <input type="hidden" name="recordId" value="@r.Id" />
                                            <input type="hidden" name="kind" value="after" />
                                            <input type="file" name="AfterPhotoFiles" class="form-control form-control-sm" multiple accept="image/*" />
                                            <button type="submit" class="btn btn-sm btn-success">อัปโหลด</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Records.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-3">ยังไม่มีประวัติการล้างแผง</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
