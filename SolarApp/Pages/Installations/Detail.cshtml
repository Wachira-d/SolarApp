@page "{id:int}"
@model SolarApp.Pages.Installations.DetailModel
@{
    ViewData["Title"] = Model.Installation.SiteName;
    var inst = Model.Installation;
    var statusClass = SolarApp.Models.Enums.UiLabels.Badge(inst.Status);
    var canWork = User.IsInRole("Admin") || User.IsInRole("Partner");
    var openOrders = Model.WorkOrders.Where(w => w.Status < SolarApp.Models.Enums.WorkOrderStatus.Completed).ToList();
    var openTickets = Model.ServiceTickets.Where(t => t.Status != SolarApp.Models.Enums.TicketStatus.Resolved
                                                   && t.Status != SolarApp.Models.Enums.TicketStatus.Closed).ToList();
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Flash banners from POST handlers (Force Recover, etc.) *@
@if (TempData["FlashSuccess"] is string flashSuccess)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @flashSuccess
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["FlashWarning"] is string flashWarning)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @flashWarning
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h4 class="mb-1">@inst.SiteName <span class="badge @statusClass fs-6 align-middle">@SolarApp.Models.Enums.UiLabels.Label(inst.Status)</span></h4>
        <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @inst.Address</p>
        @* The technician who opened this site from the map still has to get
           there. Coordinates beat the address string — Thai addresses often
           don't geocode to the roof the panels are on. *@
        @if (inst.Latitude.HasValue && inst.Longitude.HasValue
             && Math.Abs(inst.Latitude.Value) > 0.0001 && Math.Abs(inst.Longitude.Value) > 0.0001)
        {
            var coords = $"{inst.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{inst.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
            <div class="d-flex gap-2 flex-wrap">
                <a href="https://www.google.com/maps/dir/?api=1&amp;destination=@coords"
                   target="_blank" rel="noopener" class="btn btn-sm btn-success">
                    <i class="bi bi-sign-turn-right-fill"></i> นำทางไปไซต์
                </a>
                <a href="https://www.google.com/maps/search/?api=1&amp;query=@coords"
                   target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-geo-alt"></i> เปิดใน Google Maps
                </a>
                <span class="align-self-center small text-muted font-monospace">@coords</span>
            </div>
        }
        else
        {
            <small class="text-muted">
                <i class="bi bi-exclamation-triangle"></i>
                ยังไม่ได้ใส่พิกัด GPS — ไซต์นี้จะไม่ขึ้นบนแผนที่และนำทางไม่ได้
                <a asp-page="Edit" asp-route-id="@inst.Id">เพิ่มพิกัด</a>
            </small>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (!string.IsNullOrEmpty(inst.PlantId))
        {
            <button type="button" id="syncNowBtn" data-id="@inst.Id" class="btn btn-success btn-sm">
                <i class="bi bi-cloud-download"></i> ดึงข้อมูลตอนนี้
            </button>
            <button type="button" id="refreshDevicesBtn" data-id="@inst.Id" class="btn btn-outline-success btn-sm">
                <i class="bi bi-cpu"></i> รีเฟรชอุปกรณ์
            </button>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            @* "Force Recover" — visible only when the site is stuck in
               Maintenance OR has at least one open Station Faulty alert.
               Lets the operator clear the alert + send the ✅ LINE
               recovery immediately, for when the FusionSolar app shows
               the site is back to normal but our cloud poll hasn't
               caught up yet. *@
            @if (Model.OpenStationFaultCount > 0
                 || inst.Status == SolarApp.Models.Enums.InstallationStatus.Maintenance)
            {
                <form method="post" asp-page-handler="ForceRecover" asp-route-id="@inst.Id"
                      class="d-inline"
                      onsubmit="return confirm('ยืนยันการ Force Recover: จะปลดล็อก @Model.OpenStationFaultCount alert และส่ง LINE recovery ทันที — ใช้เมื่อ FusionSolar/inverter app ขึ้นปกติแล้วแต่ SolarApp ยังค้าง.');">
                    <button type="submit" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-arrow-counterclockwise"></i> Force Recover
                    </button>
                </form>
            }
            <a asp-page="Edit" asp-route-id="@inst.Id" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil"></i> แก้ไข
            </a>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots"></i> เพิ่มเติม
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-page="/Performance/Detail" asp-route-id="@inst.Id"><i class="bi bi-speedometer"></i> ผลการผลิต</a></li>
                    <li><a class="dropdown-item" asp-page="Diagnostics" asp-route-id="@inst.Id"><i class="bi bi-clipboard-pulse"></i> ตรวจระบบ / การเชื่อมต่อ</a></li>
                    <li><a class="dropdown-item" asp-page="Warranty" asp-route-id="@inst.Id"><i class="bi bi-shield-check"></i> ประกัน</a></li>
                    <li><a class="dropdown-item" asp-page="Documents" asp-route-id="@inst.Id"><i class="bi bi-file-earmark"></i> เอกสาร</a></li>
                    <li><a class="dropdown-item" asp-page="AddEquipment" asp-route-installationId="@inst.Id"><i class="bi bi-plus-lg"></i> เพิ่มอุปกรณ์</a></li>
                </ul>
            </div>
        }
        <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> กลับ
        </a>
    </div>
</div>

@* ── Field work: where a visit is booked or written up. Before, cleaning
   had a button, maintenance had a menu page, work orders had nothing here,
   and tickets were loaded but never shown. ── *@
@if (canWork)
{
    <div class="card border-0 shadow-sm mb-4 border-start border-warning border-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h6 class="mb-0"><i class="bi bi-calendar2-check text-warning"></i> งานภาคสนามของไซต์นี้</h6>
                @if (openOrders.Count + openTickets.Count > 0)
                {
                    <small class="text-muted">ค้าง @openOrders.Count งาน@(openTickets.Count > 0 ? $" · แจ้งซ่อมรอ {openTickets.Count} เรื่อง" : "")</small>
                }
            </div>
            @* Most visits are written up after the crew is back, and a contract
               round is usually cleaning + PM together — so the main button
               records a finished visit, with the contract's work pre-selected. *@
            <a asp-page="/WorkOrders/Create" asp-route-installationId="@inst.Id" asp-route-done="true"
               class="btn btn-warning btn-lg w-100 mb-2 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-clipboard2-check fs-4"></i>
                <span class="text-start">
                    <span class="fw-semibold d-block">บันทึกการเข้าบริการ</span>
                    <small>ล้างแผง + บำรุงรักษา · บำรุงรักษาอย่างเดียว · ซ่อม</small>
                </span>
            </a>
            <div class="row g-2 mb-3">
                <div class="col-4">
                    <a asp-page="Cleaning" asp-route-id="@inst.Id" class="btn btn-outline-info w-100 py-2">
                        <i class="bi bi-droplet"></i><span class="d-block small">ประวัติ/รอบล้างแผง</span>
                    </a>
                </div>
                <div class="col-4">
                    <a asp-page="/WorkOrders/Create" asp-route-installationId="@inst.Id" asp-route-done="false" class="btn btn-outline-primary w-100 py-2">
                        <i class="bi bi-calendar-plus"></i><span class="d-block small">นัดล่วงหน้า</span>
                    </a>
                </div>
                <div class="col-4">
                    <a asp-page="/ServiceTickets/Create" asp-route-installationId="@inst.Id" class="btn btn-outline-secondary w-100 py-2">
                        <i class="bi bi-ticket-detailed"></i><span class="d-block small">แจ้งซ่อม</span>
                    </a>
                </div>
            </div>
            @if (openTickets.Any())
            {
                <div class="list-group list-group-flush mb-2">
                    @foreach (var t in openTickets)
                    {
                        <div class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <span class="badge @SolarApp.Models.Enums.UiLabels.Badge(t.Priority) me-1">@SolarApp.Models.Enums.UiLabels.Label(t.Priority)</span>
                                <a asp-page="/ServiceTickets/Edit" asp-route-id="@t.Id" class="text-decoration-none fw-semibold">@t.Subject</a>
                                <small class="text-muted d-block">แจ้งซ่อม @t.TicketNumber · @SolarApp.Models.Enums.UiLabels.Label(t.Status) · @SolarApp.Services.SiteTime.ToSiteTime(t.CreatedAt).ToString("dd/MM/yy")</small>
                            </div>
                            @if (!Model.WorkOrders.Any(w => w.ServiceTicketId == t.Id && w.Status != SolarApp.Models.Enums.WorkOrderStatus.Cancelled))
                            {
                                <a asp-page="/WorkOrders/Create" asp-route-ticketId="@t.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-clipboard2-plus"></i> นัดช่าง</a>
                            }
                        </div>
                    }
                </div>
            }
            @if (openOrders.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var w in openOrders)
                    {
                        <a asp-page="/WorkOrders/Detail" asp-route-id="@w.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center gap-2">
                            <div>
                                <i class="bi bi-@SolarApp.Models.Enums.UiLabels.Icon(w.Type)"></i>
                                <span class="fw-semibold">@w.Title</span>
                                <small class="text-muted d-block">
                                    @w.ScheduledDate.ToString("dd/MM/yyyy")
                                    @if (w.IsOverdue) { <span class="text-danger fw-bold">· เลยกำหนด</span> }
                                    · @(w.AssignedToUser?.FullName ?? w.AssignedTeam ?? "ยังไม่ระบุช่าง")
                                </small>
                            </div>
                            <span class="badge @SolarApp.Models.Enums.UiLabels.Badge(w.Status) text-nowrap">@SolarApp.Models.Enums.UiLabels.Label(w.Status)</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

<!-- Sync Result Area -->
<div id="syncResult"></div>

<!-- System Overview -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">ข้อมูลระบบ</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted">ยี่ห้ออินเวอร์เตอร์</td><td class="text-end fw-bold">@inst.InverterBrand @(string.IsNullOrEmpty(inst.InverterModel) ? "" : $"({inst.InverterModel})")</td></tr>
                        <tr>
                            <td class="text-muted">ขนาดอินเวอร์เตอร์</td>
                            <td class="text-end">
                                @if (inst.InverterSizeKw > 0)
                                {
                                    <span>@inst.InverterSizeKw kW × @inst.InverterCount = <strong>@inst.TotalInverterCapacityKw kW</strong></span>
                                }
                                else
                                {
                                    <span class="text-muted">ยังไม่ระบุ</span>
                                }
                            </td>
                        </tr>
                        <tr><td class="text-muted">กำลังติดตั้งรวม</td><td class="text-end">@inst.SystemCapacityKw kWp (DC)</td></tr>
                        <tr><td class="text-muted">จำนวนแผง</td><td class="text-end">@inst.NumberOfPanels × @inst.PanelWattage W</td></tr>
                        <tr><td class="text-muted">ลูกค้า</td><td class="text-end">@inst.Customer.FullName</td></tr>
                        <tr><td class="text-muted">พาร์ทเนอร์</td><td class="text-end">@(inst.Partner?.CompanyName ?? "Direct")</td></tr>
                        @* วันส่งมอบงาน lives in the warranty card beside the term it
                           starts. It was repeated here as "วันที่ติดตั้ง" — the same
                           field under a second name, five centimetres away, which
                           reads as two different dates that happen to match. *@
                        @if (inst.CommissionDate.HasValue)
                        {
                            <tr>
                                <td class="text-muted">วันที่เริ่มจ่ายไฟ</td>
                                <td class="text-end">@inst.CommissionDate.Value.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                        <tr><td class="text-muted">ออนไลน์ล่าสุด</td><td class="text-end">@(SolarApp.Services.SiteTime.ToSiteTime(inst.LastOnlineAt)?.ToString("dd/MM HH:mm") ?? "N/A")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">ประกัน</h6></div>
            <div class="card-body">
                @if (!inst.HasWarrantyDate)
                {
                    @* An unset date sits at 0001-01-01. Rendering that as
                       "หมดอายุ 01/01/0001" told the operator the warranty had
                       lapsed when in fact nobody had entered it. *@
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        ยังไม่ได้ระบุวันสิ้นสุดรับประกัน — ไซต์นี้จะไม่เข้าระบบแจ้งเตือนประกันใกล้หมด
                        <a asp-page="Edit" asp-route-id="@inst.Id">ตั้งค่า</a>
                    </div>
                }
                else
                {
                    @* Counted in site-local days. The old sum used UtcNow, so
                       the number flipped at 07:00 Thailand time. *@
                    var daysLeft = inst.WarrantyDaysRemaining ?? 0;
                    var calculatedEnd = SolarApp.Models.Installation.CalculateWarrantyEnd(
                        inst.InstallationDate, inst.WarrantyYears);
                    var isOverridden = calculatedEnd.Date != inst.WarrantyExpiryDate.Date;

                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted">วันส่งมอบงาน</td>
                                <td class="text-end">@inst.InstallationDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr><td class="text-muted">ระยะประกัน</td><td class="text-end">@inst.WarrantyYears ปี</td></tr>
                            <tr>
                                <td class="text-muted">สิ้นสุดรับประกัน</td>
                                <td class="text-end @(inst.IsWarrantyExpired ? "text-danger fw-bold" : "text-success")">
                                    @inst.WarrantyExpiryDate.ToString("dd/MM/yyyy")
                                    @if (isOverridden)
                                    {
                                        <br />
                                        <small class="text-muted" title="ไม่ได้คำนวณจากวันส่งมอบ + ระยะประกัน">
                                            กำหนดเอง
                                        </small>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">เหลืออีก</td>
                                <td class="text-end">
                                    @if (daysLeft > 0)
                                    {
                                        @($"{daysLeft} วัน")
                                    }
                                    else if (daysLeft == 0)
                                    {
                                        <span class="text-danger fw-bold">หมดวันนี้</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">หมดอายุแล้ว @(-daysLeft) วัน</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>

                    @if (daysLeft >= 0)
                    {
                        @* Elapsed against the real term (handover → end), not
                           WarrantyYears × 365. With an overridden end date the
                           old formula could exceed 100% or go negative, and the
                           bar rendered as full or empty either way. *@
                        var totalDays = Math.Max(1, (inst.WarrantyExpiryDate.Date - inst.InstallationDate.Date).TotalDays);
                        var elapsed = Math.Clamp(100 - (daysLeft / totalDays * 100), 0, 100);
                        <div class="progress mt-2" style="height: 8px;" role="progressbar"
                             aria-valuenow="@((int)elapsed)" aria-valuemin="0" aria-valuemax="100"
                             title="ใช้ไปแล้ว @((int)elapsed)% ของระยะประกัน">
                            <div class="progress-bar @(daysLeft <= 90 ? "bg-danger" : "bg-warning")"
                                 style="width: @((int)elapsed)%"></div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">การล้างแผง</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        @if (!inst.IncludesCleaning)
                        {
                            <tr>
                                <td colspan="2" class="text-muted">
                                    <i class="bi bi-slash-circle"></i> ไม่อยู่ในสัญญาล้างแผง — ไม่มีรอบนัดและไม่แจ้งเตือน
                                </td>
                            </tr>
                        }
                        <tr><td class="text-muted">รวมตามสัญญา</td><td class="text-end">@(inst.TotalCleaningCount > 0 ? $"{inst.TotalCleaningCount} ครั้ง" : "ตามรอบ ไม่จำกัด")</td></tr>
                        <tr><td class="text-muted">ทำแล้ว</td><td class="text-end">@inst.CompletedCleaningCount ครั้ง</td></tr>
                        @if (inst.TotalCleaningCount > 0)
                        {
                            <tr><td class="text-muted">คงเหลือ</td><td class="text-end fw-bold">@Math.Max(0, inst.RemainingCleanings) ครั้ง</td></tr>
                        }
                        <tr><td class="text-muted">ล้างล่าสุด</td><td class="text-end">@(inst.LastCleaningDate?.ToString("dd/MM/yyyy") ?? "ยังไม่เคย")</td></tr>
                        @if (inst.IncludesCleaning)
                        {
                            <tr>
                                <td class="text-muted">ครบกำหนดถัดไป</td>
                                <td class="text-end @(inst.IsCleaningDue ? "text-warning fw-bold" : "")">
                                    @if (inst.CleaningContractUsedUp)
                                    {
                                        <span class="text-muted">ครบตามสัญญาแล้ว</span>
                                    }
                                    else
                                    {
                                        <span>@(inst.NextCleaningDueDate?.ToString("dd/MM/yyyy") ?? "ยังไม่ได้กำหนด")@(inst.IsCleaningDue ? " (ครบกำหนด!)" : "")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                </div>

                @if (inst.TotalCleaningCount > 0)
                {
                    var cleanProgress = (int)((double)inst.CompletedCleaningCount / inst.TotalCleaningCount * 100);
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-info" style="width: @cleanProgress%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Equipment -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">อุปกรณ์ (@inst.Equipment.Count)</h6>
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-outline-danger btn-sm" id="clearAllEquipBtn" data-id="@inst.Id"
                        onclick="if(confirm('ลบ Equipment ทั้งหมด (@inst.Equipment.Count รายการ)?')){
                            fetch('/api/installations/'+this.dataset.id+'/equipment',{method:'DELETE'})
                            .then(r=>r.json()).then(d=>{window.toast.success(d.message);setTimeout(()=>location.reload(),800)})
                            .catch(e=>window.toast.error('Error: '+e.message));}">
                    <i class="bi bi-trash"></i> Clear All
                </button>
                <a asp-page="AddEquipment" asp-route-installationId="@inst.Id" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr><th>ประเภท</th><th>ยี่ห้อ</th><th>รุ่น</th><th>ซีเรียล</th><th>จำนวน</th><th>ขนาด</th><th>รวม</th><th>ประกัน</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var eq in inst.Equipment)
                {
                    var ratingText = "";
                    var totalText = "";
                    if (eq.RatingKw.HasValue && eq.RatingKw > 0)
                    {
                        var unit = eq.EquipmentType == SolarApp.Models.Enums.EquipmentType.Battery ? "kWh" : "kW";
                        ratingText = $"{eq.RatingKw.Value:N2} {unit}";
                        totalText = $"{eq.RatingKw.Value * eq.Quantity:N2} {unit}";
                    }
                    else if (eq.RatingWatts.HasValue && eq.RatingWatts > 0)
                    {
                        ratingText = $"{eq.RatingWatts.Value} W";
                        totalText = $"{(eq.RatingWatts.Value * eq.Quantity) / 1000.0:N2} kW";
                    }
                    <tr>
                        <td><small>@eq.EquipmentType</small></td>
                        <td><small>@eq.Brand</small></td>
                        <td><small>@eq.Model</small></td>
                        <td><small class="text-break">@eq.SerialNumber</small></td>
                        <td>@eq.Quantity</td>
                        <td><small>@(string.IsNullOrEmpty(ratingText) ? "-" : ratingText)</small></td>
                        <td class="fw-bold"><small>@(string.IsNullOrEmpty(totalText) ? "-" : totalText)</small></td>
                        <td class="@(eq.IsWarrantyExpired ? "text-danger" : "")">
                            <small>@(eq.WarrantyExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</small>
                        </td>
                        <td class="text-end">
                            @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
                            {
                                <a asp-page="DeleteEquipment" asp-route-id="@eq.Id"
                                   class="btn btn-sm btn-outline-danger py-0 px-1" title="ลบ"
                                   onclick="return confirm('Delete @eq.Model (@eq.SerialNumber)?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (!inst.Equipment.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">ยังไม่ได้บันทึกอุปกรณ์</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- Active Alerts -->
@if (inst.Alerts.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0">แจ้งเตือนที่ยังเปิดอยู่</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>ระดับ</th><th>ประเภท</th><th>หัวข้อ</th><th>เวลา</th><th>วิเคราะห์</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in inst.Alerts)
                        {
                            var alertClass = alert.Severity switch
                            {
                                SolarApp.Models.Enums.AlertSeverity.Critical => "text-danger fw-bold",
                                SolarApp.Models.Enums.AlertSeverity.High => "text-warning fw-bold",
                                _ => ""
                            };
                            <tr>
                                <td class="@alertClass">@alert.Severity</td>
                                <td>@alert.AlertType</td>
                                <td>@alert.DisplayTitle</td>
                                <td>@SolarApp.Services.SiteTime.ToSiteTime(alert.OccurredAt).ToString("dd/MM HH:mm")</td>
                                <td><small>@(alert.RootCauseAnalysis ?? "-")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Service history: work orders + legacy maintenance records -->
@{
    var doneOrders = Model.WorkOrders.Where(w => w.Status >= SolarApp.Models.Enums.WorkOrderStatus.Completed).ToList();
}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-clock-history"></i> ประวัติงานเข้าไซต์</h6>
        <small class="text-muted">การล้างแผงดูที่หน้า <a asp-page="Cleaning" asp-route-id="@inst.Id">ล้างแผง</a></small>
    </div>
    <div class="list-group list-group-flush">
        @foreach (var w in doneOrders)
        {
            <a asp-page="/WorkOrders/Detail" asp-route-id="@w.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2">
                <div>
                    <i class="bi bi-@SolarApp.Models.Enums.UiLabels.Icon(w.Type)"></i>
                    <span class="fw-semibold">@w.Title</span>
                    <small class="text-muted d-block">
                        @SolarApp.Models.Enums.UiLabels.Label(w.Type, w.IncludesCleaning)
                        · @((w.ActualEndTime.HasValue ? SolarApp.Services.SiteTime.ToSiteTime(w.ActualEndTime.Value) : w.ScheduledDate).ToString("dd/MM/yyyy"))
                        · @(w.AssignedToUser?.FullName ?? w.AssignedTeam ?? "—")
                        @if (w.TotalCost > 0) { <span>· ฿@w.TotalCost.ToString("N0")</span> }
                    </small>
                </div>
                <span class="badge @SolarApp.Models.Enums.UiLabels.Badge(w.Status) text-nowrap">@SolarApp.Models.Enums.UiLabels.Label(w.Status)</span>
            </a>
        }
        @foreach (var m in Model.MaintenanceRecords)
        {
            var mRowClass = "list-group-item d-flex justify-content-between align-items-center gap-2" + (canWork ? " list-group-item-action" : "");
            if (canWork)
            {
                <a asp-page="/Maintenance/Edit" asp-route-id="@m.Id" class="@mRowClass">
                <div>
                    <i class="bi bi-tools"></i>
                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(m.Description) ? SolarApp.Models.Enums.UiLabels.Label(m.MaintenanceType) : m.Description)</span>
                    <small class="text-muted d-block">
                        @SolarApp.Models.Enums.UiLabels.Label(m.MaintenanceType) (รายการเดิม)
                        · @((m.CompletedDate ?? m.ScheduledDate).ToString("dd/MM/yyyy"))
                        · @(m.PerformedByUser?.FullName ?? "—")
                        @if (m.Cost is > 0) { <span>· ฿@m.Cost.Value.ToString("N0")</span> }
                    </small>
                </div>
                <span class="badge @SolarApp.Models.Enums.UiLabels.Badge(m.Status) text-nowrap">@SolarApp.Models.Enums.UiLabels.Label(m.Status)</span>
                </a>
            }
            else
            {
                <div class="@mRowClass">
                <div>
                    <i class="bi bi-tools"></i>
                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(m.Description) ? SolarApp.Models.Enums.UiLabels.Label(m.MaintenanceType) : m.Description)</span>
                    <small class="text-muted d-block">
                        @SolarApp.Models.Enums.UiLabels.Label(m.MaintenanceType) (รายการเดิม)
                        · @((m.CompletedDate ?? m.ScheduledDate).ToString("dd/MM/yyyy"))
                        · @(m.PerformedByUser?.FullName ?? "—")
                        @if (m.Cost is > 0) { <span>· ฿@m.Cost.Value.ToString("N0")</span> }
                    </small>
                </div>
                <span class="badge @SolarApp.Models.Enums.UiLabels.Badge(m.Status) text-nowrap">@SolarApp.Models.Enums.UiLabels.Label(m.Status)</span>
                </div>
            }
        }
        @if (!doneOrders.Any() && !Model.MaintenanceRecords.Any())
        {
            <div class="list-group-item text-center text-muted py-3">ยังไม่มีประวัติงานเข้าไซต์</div>
        }
    </div>
</div>

<!-- Notes -->
@if (!string.IsNullOrEmpty(inst.Notes))
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h6 class="mb-0">บันทึก</h6></div>
        <div class="card-body">@inst.Notes</div>
    </div>
}


@section Scripts {
    <script>
        // ─── Refresh device info from cloud (inverter model / serial / firmware) ───
        document.getElementById('refreshDevicesBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('refreshDevicesBtn');
            const id = btn.dataset.id;
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Fetching...';
            try {
                const r = await fetch(`/api/installations/${id}/refresh-devices`, { method: 'POST' });
                const data = await r.json();
                const lines = [
                    data.message,
                    `Devices: ${data.devicesFetched} | Created: ${data.equipmentCreated} | Updated: ${data.equipmentUpdated}`,
                    data.installationNote || ''
                ].filter(x => x).join(' — ');
                if (data.success) {
                    window.toast.success(lines);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    window.toast.error(lines);
                }
            } catch (e) {
                window.toast.error('Refresh failed: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });

        document.getElementById('syncNowBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('syncNowBtn');
            const result = document.getElementById('syncResult');
            const id = btn.dataset.id;

            btn.disabled = true;
            btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Syncing...';
            result.innerHTML = '';

            try {
                const r = await fetch('/api/installations/' + id + '/sync', { method: 'POST' });
                const data = await r.json();

                if (data.success) {
                    const d = data.data;
                    let html = '<div class="alert alert-success alert-dismissible fade show">';
                    html += '<h6><i class="bi bi-check-circle-fill"></i> ' + data.message + '</h6>';

                    // Row 1: Status + Today's Production
                    html += '<div class="row mt-3 g-2">';
                    // Health, not just the online bit: a station that answers but
                    // reports a fault is "ต้องตรวจสอบ", not OFFLINE.
                    const st = d.health === 'Faulty' ? ['warning text-dark', 'ต้องตรวจสอบ']
                             : d.isOnline ? ['success', 'ONLINE']
                             : d.health === 'OfflineNight' ? ['secondary', 'OFFLINE (กลางคืน)']
                             : ['secondary', 'OFFLINE'];
                    html += '<div class="col-md-2"><small class="text-muted">สถานะ</small><br/><span class="badge bg-' + st[0] + '" title="' + (d.faultReason || '') + '">' + st[1] + '</span></div>';
                    html += '<div class="col-md-2"><small class="text-muted">กำลังผลิตขณะนี้</small><br/><strong>' + (d.currentPowerKw || 0).toFixed(2) + ' kW</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">วันนี้</small><br/><strong class="text-warning">' + (d.todayEnergyKwh || 0).toFixed(2) + ' kWh</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">สะสมทั้งหมด</small><br/><strong>' + (d.totalEnergyKwh || 0).toFixed(0) + ' kWh</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">ดึงข้อมูลย้อนหลัง</small><br/><strong>' + (d.historicalDaysAdded || 0) + ' วัน</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">แจ้งเตือนที่เพิ่ม</small><br/><strong>' + (d.alarmsAdded || 0) + '</strong></div>';
                    html += '</div>';

                    // Row 2: Grid + Battery
                    html += '<div class="row mt-3 g-2">';
                    if (d.gridExportKw !== null && d.gridExportKw !== undefined) {
                        html += '<div class="col-md-3"><small class="text-muted">ขายไฟเข้ากริด</small><br/><strong class="text-success">' + (d.gridExportKw || 0).toFixed(2) + ' kW</strong></div>';
                    }
                    if (d.gridImportKw !== null && d.gridImportKw !== undefined) {
                        html += '<div class="col-md-3"><small class="text-muted">ซื้อไฟจากกริด</small><br/><strong class="text-danger">' + (d.gridImportKw || 0).toFixed(2) + ' kW</strong></div>';
                    }
                    // Only render battery tiles when the site is flagged as
                    // having a battery — Razor stamps HAS_BATTERY at render
                    // time so the JS doesn't need a server roundtrip.
                    const HAS_BATTERY = @(inst.HasBattery ? "true" : "false");
                    if (HAS_BATTERY && d.batterySocPercent !== null && d.batterySocPercent !== undefined) {
                        html += '<div class="col-md-3"><small class="text-muted">ระดับแบตเตอรี่</small><br/><strong class="text-info">' + d.batterySocPercent + '%</strong></div>';
                    }
                    if (HAS_BATTERY && d.batteryPowerKw !== null && d.batteryPowerKw !== undefined && d.batteryPowerKw !== 0) {
                        const bp = d.batteryPowerKw;
                        const bpLabel = bp > 0 ? 'Charging' : 'Discharging';
                        const bpClass = bp > 0 ? 'text-primary' : 'text-warning';
                        html += '<div class="col-md-3"><small class="text-muted">แบตเตอรี่ ' + bpLabel + '</small><br/><strong class="' + bpClass + '">' + Math.abs(bp).toFixed(2) + ' kW</strong></div>';
                    }
                    html += '</div>';

                    html += '<hr class="my-2" />';
                    html += '<small class="text-muted">ดึงข้อมูลเมื่อ ' + new Date().toLocaleString() + ' — ข้อมูลจะไปแสดงในหน้าหลักและรายงาน <a href="" onclick="location.reload();return false;">รีเฟรชหน้านี้</a> เพื่อดูแจ้งเตือน/กราฟล่าสุด</small>';
                    html += '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                    result.innerHTML = html;
                } else {
                    result.innerHTML = '<div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-x-circle-fill"></i> ' + data.message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                }
            } catch (e) {
                result.innerHTML = '<div class="alert alert-danger"><i class="bi bi-x-circle-fill"></i> Sync failed: ' + e.message + '</div>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-download"></i> ดึงข้อมูลตอนนี้';
            }
        });
    </script>
}
