@page "{id:int}"
@model SolarApp.Pages.Installations.DetailModel
@{
    ViewData["Title"] = Model.Installation.SiteName;
    var inst = Model.Installation;
    var statusClass = inst.Status switch
    {
        SolarApp.Models.Enums.InstallationStatus.Active => "bg-success",
        SolarApp.Models.Enums.InstallationStatus.Offline => "bg-danger",
        SolarApp.Models.Enums.InstallationStatus.Maintenance => "bg-warning",
        _ => "bg-secondary"
    };
}

@* Flash banners from POST handlers (Force Recover, etc.) *@
@if (TempData["FlashSuccess"] is string flashSuccess)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @flashSuccess
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["FlashWarning"] is string flashWarning)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @flashWarning
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between mb-4">
    <div>
        <h4>@inst.SiteName <span class="badge @statusClass">@inst.Status</span></h4>
        <p class="text-muted"><i class="bi bi-geo-alt"></i> @inst.Address</p>
    </div>
    <div class="d-flex gap-2">
        @if (!string.IsNullOrEmpty(inst.PlantId))
        {
            <button type="button" id="syncNowBtn" data-id="@inst.Id" class="btn btn-success btn-sm">
                <i class="bi bi-cloud-download"></i> ดึงข้อมูลตอนนี้
            </button>
            <button type="button" id="refreshDevicesBtn" data-id="@inst.Id" class="btn btn-outline-success btn-sm">
                <i class="bi bi-cpu"></i> รีเฟรชอุปกรณ์
            </button>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            @* "Force Recover" — visible only when the site is stuck in
               Maintenance OR has at least one open Station Faulty alert.
               Lets the operator clear the alert + send the ✅ LINE
               recovery immediately, for when the FusionSolar app shows
               the site is back to normal but our cloud poll hasn't
               caught up yet. *@
            @if (Model.OpenStationFaultCount > 0
                 || inst.Status == SolarApp.Models.Enums.InstallationStatus.Maintenance)
            {
                <form method="post" asp-page-handler="ForceRecover" asp-route-id="@inst.Id"
                      class="d-inline"
                      onsubmit="return confirm('ยืนยันการ Force Recover: จะปลดล็อก @Model.OpenStationFaultCount alert และส่ง LINE recovery ทันที — ใช้เมื่อ FusionSolar/inverter app ขึ้นปกติแล้วแต่ SolarApp ยังค้าง.');">
                    <button type="submit" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-arrow-counterclockwise"></i> Force Recover
                    </button>
                </form>
            }
            <a asp-page="/Performance/Detail" asp-route-id="@inst.Id" class="btn btn-outline-success btn-sm">
                <i class="bi bi-speedometer"></i> ผลการผลิต
            </a>
            <a asp-page="Diagnostics" asp-route-id="@inst.Id" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-clipboard-pulse"></i> ตรวจระบบ
            </a>
            <a asp-page="Edit" asp-route-id="@inst.Id" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil"></i> แก้ไข
            </a>
            <a asp-page="AddEquipment" asp-route-installationId="@inst.Id" class="btn btn-outline-info btn-sm">
                <i class="bi bi-plus-lg"></i> เพิ่มอุปกรณ์
            </a>
            <a asp-page="Cleaning" asp-route-id="@inst.Id" class="btn btn-outline-info btn-sm">
                <i class="bi bi-droplet"></i> ล้างแผง
            </a>
            <a asp-page="Warranty" asp-route-id="@inst.Id" class="btn btn-outline-info btn-sm">
                <i class="bi bi-shield-check"></i> ประกัน
            </a>
            <a asp-page="Documents" asp-route-id="@inst.Id" class="btn btn-outline-info btn-sm">
                <i class="bi bi-file-earmark"></i> เอกสาร
            </a>
        }
        <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> กลับ
        </a>
    </div>
</div>

<!-- Sync Result Area -->
<div id="syncResult"></div>

<!-- System Overview -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">ข้อมูลระบบ</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted">Inverter Brand</td><td class="text-end fw-bold">@inst.InverterBrand @(string.IsNullOrEmpty(inst.InverterModel) ? "" : $"({inst.InverterModel})")</td></tr>
                        <tr>
                            <td class="text-muted">Inverter Size</td>
                            <td class="text-end">
                                @if (inst.InverterSizeKw > 0)
                                {
                                    <span>@inst.InverterSizeKw kW × @inst.InverterCount = <strong>@inst.TotalInverterCapacityKw kW</strong></span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </td>
                        </tr>
                        <tr><td class="text-muted">System Capacity</td><td class="text-end">@inst.SystemCapacityKw kWp (DC)</td></tr>
                        <tr><td class="text-muted">Panels</td><td class="text-end">@inst.NumberOfPanels × @inst.PanelWattage W</td></tr>
                        <tr><td class="text-muted">ลูกค้า</td><td class="text-end">@inst.Customer.FullName</td></tr>
                        <tr><td class="text-muted">Partner</td><td class="text-end">@(inst.Partner?.CompanyName ?? "Direct")</td></tr>
                        <tr><td class="text-muted">Installed</td><td class="text-end">@inst.InstallationDate.ToString("dd/MM/yyyy")</td></tr>
                        <tr><td class="text-muted">Last Online</td><td class="text-end">@(inst.LastOnlineAt?.ToString("dd/MM HH:mm") ?? "N/A")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">ประกัน</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted">ระยะเวลา</td><td class="text-end">@inst.WarrantyYears ปี</td></tr>
                        <tr>
                            <td class="text-muted">Expires</td>
                            <td class="text-end @(inst.IsWarrantyExpired ? "text-danger fw-bold" : "text-success")">
                                @inst.WarrantyExpiryDate.ToString("dd/MM/yyyy")
                                @(inst.IsWarrantyExpired ? " (หมดอายุ)" : "")
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Days Left</td>
                            <td class="text-end">
                                @{
                                    var daysLeft = (inst.WarrantyExpiryDate - DateTime.UtcNow).Days;
                                }
                                @(daysLeft > 0 ? $"{daysLeft} days" : "Expired")
                            </td>
                        </tr>
                    </table>
                </div>

                @if (inst.WarrantyExpiryDate > DateTime.UtcNow)
                {
                    var progress = (int)(100 - ((double)daysLeft / (inst.WarrantyYears * 365.0) * 100));
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: @progress%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">การล้างแผง</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted">รวม</td><td class="text-end">@inst.TotalCleaningCount ครั้ง</td></tr>
                        <tr><td class="text-muted">ทำแล้ว</td><td class="text-end">@inst.CompletedCleaningCount ครั้ง</td></tr>
                        <tr><td class="text-muted">คงเหลือ</td><td class="text-end fw-bold">@inst.RemainingCleanings ครั้ง</td></tr>
                        <tr><td class="text-muted">ล้างล่าสุด</td><td class="text-end">@(inst.LastCleaningDate?.ToString("dd/MM/yyyy") ?? "ยังไม่เคย")</td></tr>
                        <tr>
                            <td class="text-muted">Next Due</td>
                            <td class="text-end @(inst.IsCleaningDue ? "text-warning fw-bold" : "")">
                                @(inst.NextCleaningDueDate?.ToString("dd/MM/yyyy") ?? "N/A")
                                @(inst.IsCleaningDue ? " (DUE!)" : "")
                            </td>
                        </tr>
                    </table>
                </div>

                @if (inst.TotalCleaningCount > 0)
                {
                    var cleanProgress = (int)((double)inst.CompletedCleaningCount / inst.TotalCleaningCount * 100);
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar bg-info" style="width: @cleanProgress%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Equipment -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">อุปกรณ์ (@inst.Equipment.Count)</h6>
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-outline-danger btn-sm" id="clearAllEquipBtn" data-id="@inst.Id"
                        onclick="if(confirm('ลบ Equipment ทั้งหมด (@inst.Equipment.Count รายการ)?')){
                            fetch('/api/installations/'+this.dataset.id+'/equipment',{method:'DELETE'})
                            .then(r=>r.json()).then(d=>{window.toast.success(d.message);setTimeout(()=>location.reload(),800)})
                            .catch(e=>window.toast.error('Error: '+e.message));}">
                    <i class="bi bi-trash"></i> Clear All
                </button>
                <a asp-page="AddEquipment" asp-route-installationId="@inst.Id" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr><th>ประเภท</th><th>ยี่ห้อ</th><th>รุ่น</th><th>ซีเรียล</th><th>จำนวน</th><th>ขนาด</th><th>รวม</th><th>ประกัน</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var eq in inst.Equipment)
                {
                    var ratingText = "";
                    var totalText = "";
                    if (eq.RatingKw.HasValue && eq.RatingKw > 0)
                    {
                        var unit = eq.EquipmentType == SolarApp.Models.Enums.EquipmentType.Battery ? "kWh" : "kW";
                        ratingText = $"{eq.RatingKw.Value:N2} {unit}";
                        totalText = $"{eq.RatingKw.Value * eq.Quantity:N2} {unit}";
                    }
                    else if (eq.RatingWatts.HasValue && eq.RatingWatts > 0)
                    {
                        ratingText = $"{eq.RatingWatts.Value} W";
                        totalText = $"{(eq.RatingWatts.Value * eq.Quantity) / 1000.0:N2} kW";
                    }
                    <tr>
                        <td><small>@eq.EquipmentType</small></td>
                        <td><small>@eq.Brand</small></td>
                        <td><small>@eq.Model</small></td>
                        <td><small class="text-break">@eq.SerialNumber</small></td>
                        <td>@eq.Quantity</td>
                        <td><small>@(string.IsNullOrEmpty(ratingText) ? "-" : ratingText)</small></td>
                        <td class="fw-bold"><small>@(string.IsNullOrEmpty(totalText) ? "-" : totalText)</small></td>
                        <td class="@(eq.IsWarrantyExpired ? "text-danger" : "")">
                            <small>@(eq.WarrantyExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</small>
                        </td>
                        <td class="text-end">
                            @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
                            {
                                <a asp-page="DeleteEquipment" asp-route-id="@eq.Id"
                                   class="btn btn-sm btn-outline-danger py-0 px-1" title="ลบ"
                                   onclick="return confirm('Delete @eq.Model (@eq.SerialNumber)?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (!inst.Equipment.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">No equipment recorded</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- Active Alerts -->
@if (inst.Alerts.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0">แจ้งเตือนที่ยังเปิดอยู่</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>ระดับ</th><th>ประเภท</th><th>หัวข้อ</th><th>เวลา</th><th>วิเคราะห์</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in inst.Alerts)
                        {
                            var alertClass = alert.Severity switch
                            {
                                SolarApp.Models.Enums.AlertSeverity.Critical => "text-danger fw-bold",
                                SolarApp.Models.Enums.AlertSeverity.High => "text-warning fw-bold",
                                _ => ""
                            };
                            <tr>
                                <td class="@alertClass">@alert.Severity</td>
                                <td>@alert.AlertType</td>
                                <td>@alert.Title</td>
                                <td>@alert.OccurredAt.ToString("dd/MM HH:mm")</td>
                                <td><small>@(alert.RootCauseAnalysis ?? "-")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Maintenance History -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h6 class="mb-0">ประวัติการบำรุงรักษา</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>ประเภท</th><th>นัด</th><th>ทำแล้ว</th><th>สถานะ</th><th>ผู้ทำ</th><th>ค่าใช้จ่าย</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.MaintenanceRecords)
                    {
                        <tr>
                            <td>@m.MaintenanceType</td>
                            <td>@m.ScheduledDate.ToString("dd/MM/yyyy")</td>
                            <td>@(m.CompletedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <span class="badge @(m.Status == SolarApp.Models.Enums.MaintenanceStatus.Completed ? "bg-success" : "bg-warning")">
                                    @m.Status
                                </span>
                            </td>
                            <td>@(m.PerformedByUser?.FullName ?? "-")</td>
                            <td>@(m.Cost?.ToString("N0") ?? "-") THB</td>
                        </tr>
                    }
                    @if (!Model.MaintenanceRecords.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">No maintenance records</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Notes -->
@if (!string.IsNullOrEmpty(inst.Notes))
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h6 class="mb-0">บันทึก</h6></div>
        <div class="card-body">@inst.Notes</div>
    </div>
}


@section Scripts {
    <script>
        // ─── Refresh device info from cloud (inverter model / serial / firmware) ───
        document.getElementById('refreshDevicesBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('refreshDevicesBtn');
            const id = btn.dataset.id;
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Fetching...';
            try {
                const r = await fetch(`/api/installations/${id}/refresh-devices`, { method: 'POST' });
                const data = await r.json();
                const lines = [
                    data.message,
                    `Devices: ${data.devicesFetched} | Created: ${data.equipmentCreated} | Updated: ${data.equipmentUpdated}`,
                    data.installationNote || ''
                ].filter(x => x).join(' — ');
                if (data.success) {
                    window.toast.success(lines);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    window.toast.error(lines);
                }
            } catch (e) {
                window.toast.error('Refresh failed: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });

        document.getElementById('syncNowBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('syncNowBtn');
            const result = document.getElementById('syncResult');
            const id = btn.dataset.id;

            btn.disabled = true;
            btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Syncing...';
            result.innerHTML = '';

            try {
                const r = await fetch('/api/installations/' + id + '/sync', { method: 'POST' });
                const data = await r.json();

                if (data.success) {
                    const d = data.data;
                    let html = '<div class="alert alert-success alert-dismissible fade show">';
                    html += '<h6><i class="bi bi-check-circle-fill"></i> ' + data.message + '</h6>';

                    // Row 1: Status + Today's Production
                    html += '<div class="row mt-3 g-2">';
                    html += '<div class="col-md-2"><small class="text-muted">Status</small><br/><span class="badge bg-' + (d.isOnline ? 'success' : 'secondary') + '">' + (d.isOnline ? 'ONLINE' : 'OFFLINE') + '</span></div>';
                    html += '<div class="col-md-2"><small class="text-muted">Current Power</small><br/><strong>' + (d.currentPowerKw || 0).toFixed(2) + ' kW</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">Today</small><br/><strong class="text-warning">' + (d.todayEnergyKwh || 0).toFixed(2) + ' kWh</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">Total</small><br/><strong>' + (d.totalEnergyKwh || 0).toFixed(0) + ' kWh</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">History synced</small><br/><strong>' + (d.historicalDaysAdded || 0) + ' days</strong></div>';
                    html += '<div class="col-md-2"><small class="text-muted">Alarms added</small><br/><strong>' + (d.alarmsAdded || 0) + '</strong></div>';
                    html += '</div>';

                    // Row 2: Grid + Battery
                    html += '<div class="row mt-3 g-2">';
                    if (d.gridExportKw !== null && d.gridExportKw !== undefined) {
                        html += '<div class="col-md-3"><small class="text-muted">Grid Export (selling)</small><br/><strong class="text-success">' + (d.gridExportKw || 0).toFixed(2) + ' kW</strong></div>';
                    }
                    if (d.gridImportKw !== null && d.gridImportKw !== undefined) {
                        html += '<div class="col-md-3"><small class="text-muted">Grid Import (buying)</small><br/><strong class="text-danger">' + (d.gridImportKw || 0).toFixed(2) + ' kW</strong></div>';
                    }
                    // Only render battery tiles when the site is flagged as
                    // having a battery — Razor stamps HAS_BATTERY at render
                    // time so the JS doesn't need a server roundtrip.
                    const HAS_BATTERY = @(inst.HasBattery ? "true" : "false");
                    if (HAS_BATTERY && d.batterySocPercent !== null && d.batterySocPercent !== undefined) {
                        html += '<div class="col-md-3"><small class="text-muted">Battery SOC</small><br/><strong class="text-info">' + d.batterySocPercent + '%</strong></div>';
                    }
                    if (HAS_BATTERY && d.batteryPowerKw !== null && d.batteryPowerKw !== undefined && d.batteryPowerKw !== 0) {
                        const bp = d.batteryPowerKw;
                        const bpLabel = bp > 0 ? 'Charging' : 'Discharging';
                        const bpClass = bp > 0 ? 'text-primary' : 'text-warning';
                        html += '<div class="col-md-3"><small class="text-muted">Battery ' + bpLabel + '</small><br/><strong class="' + bpClass + '">' + Math.abs(bp).toFixed(2) + ' kW</strong></div>';
                    }
                    html += '</div>';

                    html += '<hr class="my-2" />';
                    html += '<small class="text-muted">Synced at: ' + new Date().toLocaleString() + ' | Data appears in Dashboard/Reports. <a href="" onclick="location.reload();return false;">Refresh page</a> to see updated alerts/charts.</small>';
                    html += '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                    result.innerHTML = html;
                } else {
                    result.innerHTML = '<div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-x-circle-fill"></i> ' + data.message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                }
            } catch (e) {
                result.innerHTML = '<div class="alert alert-danger"><i class="bi bi-x-circle-fill"></i> Sync failed: ' + e.message + '</div>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-download"></i> ดึงข้อมูลตอนนี้';
            }
        });
    </script>
}
