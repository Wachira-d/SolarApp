@page
@model SolarApp.Pages.Installations.CreateModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "เพิ่มไซต์งานใหม่";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">เพิ่มไซต์งานใหม่</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Site Information -->
                    <h6 class="text-muted mb-3">ข้อมูลไซต์งาน</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.SiteName" class="form-label">ชื่อไซต์งาน *</label>
                            <input asp-for="Input.SiteName" class="form-control" />
                            <span asp-validation-for="Input.SiteName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Address" class="form-label">ที่อยู่ *</label>
                            <input asp-for="Input.Address" class="form-control" />
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>
                    </div>
                    @* City, province and postcode had no inputs here, so new sites
                       were created without them — and province is what the map's route planner
                       groups by. *@
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.City" class="form-label">อำเภอ / เขต</label>
                            <input asp-for="Input.City" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Province" class="form-label">จังหวัด</label>
                            <input asp-for="Input.Province" class="form-control" list="provinceList" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.PostalCode" class="form-label">รหัสไปรษณีย์</label>
                            <input asp-for="Input.PostalCode" class="form-control" inputmode="numeric" maxlength="5" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Latitude" class="form-label">ละติจูด</label>
                            <input asp-for="Input.Latitude" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Longitude" class="form-label">ลองจิจูด</label>
                            <input asp-for="Input.Longitude" class="form-control" />
                        </div>
                    </div>

                    <!-- Customer & Partner -->
                    <h6 class="text-muted mb-3 mt-4">ลูกค้าและพาร์ทเนอร์</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CustomerId" class="form-label">ลูกค้า *</label>
                            <select asp-for="Input.CustomerId" asp-items="Model.Customers" class="form-select">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="Input.CustomerId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PartnerId" class="form-label">พาร์ทเนอร์</label>
                            <select asp-for="Input.PartnerId" asp-items="Model.Partners" class="form-select">
                                <option value="">-- No Partner (Direct Sale) --</option>
                            </select>
                        </div>
                    </div>

                    <!-- System Specs -->
                    <h6 class="text-muted mb-3 mt-4">สเปกระบบ</h6>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InverterBrand" class="form-label">ยี่ห้ออินเวอร์เตอร์ *</label>
                            <select asp-for="Input.InverterBrand" asp-items="Html.GetEnumSelectList<InverterBrand>()" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterModel" class="form-label">รุ่นอินเวอร์เตอร์</label>
                            <input asp-for="Input.InverterModel" class="form-control" placeholder="เช่น SUN2000-10KTL" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterSizeKw" class="form-label">ขนาดอินเวอร์เตอร์ (kW) *</label>
                            <input asp-for="Input.InverterSizeKw" class="form-control" type="number" step="any" placeholder="เช่น 10" />
                            <small class="text-muted">กำลังของอินเวอร์เตอร์แต่ละตัว</small>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterCount" class="form-label">จำนวนอินเวอร์เตอร์ *</label>
                            <input asp-for="Input.InverterCount" class="form-control" type="number" min="1" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.SystemCapacityKw" class="form-label">กำลังติดตั้งรวม (kWp) *</label>
                            <input asp-for="Input.SystemCapacityKw" class="form-control" />
                            <small class="text-muted">กำลัง DC รวมทั้งระบบ</small>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.NumberOfPanels" class="form-label">จำนวนแผง *</label>
                            <input asp-for="Input.NumberOfPanels" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.PanelWattage" class="form-label">กำลังต่อแผง (W) *</label>
                            <input asp-for="Input.PanelWattage" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.SystemType" class="form-label">ประเภทระบบ</label>
                            <select asp-for="Input.SystemType" asp-items="Html.GetEnumSelectList<SystemType>()" class="form-select"></select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.PanelBrand" class="form-label">ยี่ห้อแผง</label>
                            <input asp-for="Input.PanelBrand" class="form-control" placeholder="เช่น Jinko, LONGi, Trina" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PanelModel" class="form-label">รุ่นแผง</label>
                            <input asp-for="Input.PanelModel" class="form-control" />
                        </div>
                    </div>

                    <!-- Battery storage — opt-in (same UX as Edit page) -->
                    <h6 class="text-muted mb-2 mt-3">แบตเตอรี่สำรอง</h6>
                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Input.HasBattery" class="form-check-input" id="Input_HasBattery" />
                                <label asp-for="Input.HasBattery" class="form-check-label" for="Input_HasBattery">
                                    <strong>มี Battery</strong>
                                    <small class="text-muted ms-2">ติ๊กถ้าไซต์นี้มีระบบกักเก็บไฟฟ้า</small>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3 battery-fields-row">
                        <div class="col-md-3">
                            <label asp-for="Input.BatteryBrand" class="form-label">ยี่ห้อแบตเตอรี่</label>
                            <input asp-for="Input.BatteryBrand" class="form-control" placeholder="เช่น BYD, Pylontech" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.BatteryModel" class="form-label">รุ่นแบตเตอรี่</label>
                            <input asp-for="Input.BatteryModel" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.BatteryCapacityKwh" class="form-label">ความจุ (kWh)</label>
                            <input asp-for="Input.BatteryCapacityKwh" class="form-control" type="number" step="any" min="0" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.BatteryCount" class="form-label">จำนวนแบตเตอรี่</label>
                            <input asp-for="Input.BatteryCount" class="form-control" type="number" min="1" />
                        </div>
                    </div>

                    <!-- Cloud API -->
                    <h6 class="text-muted mb-3 mt-4">การเชื่อมต่อคลาวด์ผู้ผลิต</h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.PlantId" class="form-label">Plant/Station ID</label>
                            <input asp-for="Input.PlantId" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CloudApiKey" class="form-label">API Key</label>
                            <input asp-for="Input.CloudApiKey" class="form-control" autocomplete="new-password" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CloudUsername" class="form-label">ชื่อผู้ใช้คลาวด์</label>
                            <input asp-for="Input.CloudUsername" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.CloudPassword" class="form-label">รหัสผ่านคลาวด์</label>
                            <input asp-for="Input.CloudPassword" class="form-control" type="password" autocomplete="new-password" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CloudApiSecret" class="form-label">API Secret</label>
                            <input asp-for="Input.CloudApiSecret" class="form-control" type="password" autocomplete="new-password" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="button" id="testConnectionBtn" class="btn btn-outline-info">
                                <i class="bi bi-plug"></i> ทดสอบเชื่อมต่อและดึงข้อมูล
                            </button>
                        </div>
                    </div>

                    <!-- Advanced: API endpoint override -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <label asp-for="Input.CloudApiBaseUrl" class="form-label">
                                <i class="bi bi-gear"></i> API Endpoint Override
                                <span class="badge bg-secondary ms-1">ขั้นสูง</span>
                            </label>
                            <input asp-for="Input.CloudApiBaseUrl" class="form-control"
                                   placeholder="เว้นว่างเพื่อให้ระบบเลือกอัตโนมัติ — กรอกเมื่อ login ผิด region" />
                            <div class="form-text">
                                ใช้เฉพาะเมื่อ account อยู่บน server ที่ระบบเลือกไม่ถูก. รับ 2 รูปแบบ:<br>
                                <strong>Base URL</strong> เช่น <code>https://global.hoymiles.com</code> —
                                ระบบจะลองหา login path เอง<br>
                                <strong>Full URL</strong> ของ login endpoint — หาได้จาก Browser DevTools (F12 → Network)
                            </div>
                        </div>
                    </div>

                    <div id="testResult"></div>

                    <!-- Warranty & Maintenance -->
                    <h6 class="text-muted mb-3 mt-4">ประกันและการบำรุงรักษา</h6>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InstallationDate" class="form-label">
                                วันที่ส่งมอบงาน <span class="text-muted">(วันเริ่มรับประกัน)</span> *
                            </label>
                            <input asp-for="Input.InstallationDate" class="form-control" type="date"
                                   id="warrantyStart" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.WarrantyYears" class="form-label">ระยะประกัน (ปี) *</label>
                            <input asp-for="Input.WarrantyYears" class="form-control" id="warrantyYears" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.WarrantyExpiryDate" class="form-label">
                                วันที่สิ้นสุดรับประกัน
                                <span class="badge bg-light text-muted border" id="warrantyEndState">คำนวณอัตโนมัติ</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="Input.WarrantyExpiryDate" class="form-control" type="date"
                                       id="warrantyEnd" />
                                <button type="button" class="btn btn-outline-secondary" id="warrantyEndReset"
                                        title="คำนวณใหม่จากวันส่งมอบ + ระยะประกัน">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <div class="form-text" id="warrantyEndHint"></div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.CommissionDate" class="form-label">วันที่เริ่มจ่ายไฟ</label>
                            <input asp-for="Input.CommissionDate" class="form-control" type="date" />
                            <div class="form-text">ไม่ใช้นับประกัน — ใช้เป็นวันเริ่มนับอายุอุปกรณ์ สำหรับการคาดการณ์ความเสี่ยง</div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.TotalCleaningCount" class="form-label">จำนวนครั้งล้างแผงในสัญญา</label>
                            <input asp-for="Input.TotalCleaningCount" class="form-control" min="0" />
                            <small class="text-muted">0 = ล้างตามรอบ ไม่จำกัดจำนวนครั้ง</small>
                        </div>
                    </div>
                    @* The inverter carries its own warranty, usually longer than
                       the installation's. It had no input here, so every new
                       site got ten years from handover — and the
                       predictive engine and device import both read it. *@
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="Input.InverterWarrantyYears" class="form-label">ประกันอินเวอร์เตอร์ (ปี)</label>
                            <input asp-for="Input.InverterWarrantyYears" class="form-control" type="number"
                                   min="0" max="30" id="invWarrantyYears" />
                            <small class="text-muted">0 = ไม่มีประกันแยกจากระบบ</small>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.InverterWarrantyExpiryDate" class="form-label">
                                สิ้นสุดประกันอินเวอร์เตอร์
                                <span class="badge bg-light text-muted border" id="invWarrantyEndState">คำนวณอัตโนมัติ</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="Input.InverterWarrantyExpiryDate" class="form-control" type="date"
                                       id="invWarrantyEnd" />
                                <button type="button" class="btn btn-outline-secondary" id="invWarrantyEndReset"
                                        title="คำนวณใหม่จากวันส่งมอบ + ระยะประกันอินเวอร์เตอร์">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <div class="form-text" id="invWarrantyEndHint"></div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.CleaningFrequencyMonths" class="form-label">ความถี่ในการล้างแผง</label>
                            @{
                                // Same preset table as Edit page — keep them in sync.  See
                                // Edit.cshtml for rationale (warranty / cleaning interval may differ).
                                var freqPresetsC = new (int Months, string Label)[]
                                {
                                    (12, "ปีละครั้ง (ทุก 12 เดือน)"),
                                    (6,  "ปีละ 2 ครั้ง (ทุก 6 เดือน)"),
                                    (4,  "ปีละ 3 ครั้ง (ทุก 4 เดือน)"),
                                    (3,  "ปีละ 4 ครั้ง (ทุก 3 เดือน)"),
                                    (2,  "ปีละ 6 ครั้ง (ทุก 2 เดือน)"),
                                    (24, "ทุก 2 ปี"),
                                    (36, "ทุก 3 ปี"),
                                    (60, "ทุก 5 ปี"),
                                };
                                var freqSelC = Model.Input.CleaningFrequencyMonths;
                            }
                            <select asp-for="Input.CleaningFrequencyMonths" class="form-select">
                                @foreach (var (m, lbl) in freqPresetsC)
                                {
                                    var isSelC = freqSelC == m;
                                    <option value="@m" selected="@isSelC">@lbl</option>
                                }
                                @if (!freqPresetsC.Any(p => p.Months == freqSelC))
                                {
                                    <option value="@freqSelC" selected="selected">กำหนดเอง (@freqSelC เดือน)</option>
                                }
                            </select>
                            <small class="text-muted">
                                คนละค่ากับระยะประกันได้ — เช่น ประกัน 2 ปี แต่สัญญาล้างแผงทุก 5 ปี
                            </small>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.ElectricityRatePerKwh" class="form-label">ค่าไฟ (บาท/kWh)</label>
                            <input asp-for="Input.ElectricityRatePerKwh" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.FeedInTariffRate" class="form-label">ค่าขายไฟคืน (บาท/kWh)</label>
                            <input asp-for="Input.FeedInTariffRate" class="form-control" type="number" step="any" min="0" />
                            <small class="text-muted">เว้นว่าง = ไม่ได้ขายไฟคืน</small>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.ContractValue" class="form-label">มูลค่าโครงการ (บาท)</label>
                            <input asp-for="Input.ContractValue" class="form-control" type="number" step="any" min="0" />
                        </div>
                    </div>

                    @* ─── Service Scope ───────────────────────────────────────────── *@
                    <hr />
                    <h5 class="mb-3">ขอบเขตการบริการ</h5>
                    <p class="text-muted small mb-2">
                        เลือกรูปแบบบริการที่เราดูแลให้ไซต์นี้
                        Background jobs (sync ข้อมูล, แจ้งเตือนล้างแผง) จะทำงานตามฟิลด์เหล่านี้
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">รูปแบบสัญญา</label>
                        <div class="btn-group d-block" role="group" id="serviceLevelGroup">
                            @foreach (var level in new[] {
                                (SolarApp.Models.Enums.ServiceLevel.FullOM, "Full O&M", "ดูแลครบ: monitor + ล้าง + PM + CM + warranty"),
                                (SolarApp.Models.Enums.ServiceLevel.MonitoringOnly, "Monitoring", "เฝ้าระวังออนไลน์เท่านั้น"),
                                (SolarApp.Models.Enums.ServiceLevel.CleaningOnly, "Cleaning", "เข้าล้างแผงตามรอบเท่านั้น"),
                                (SolarApp.Models.Enums.ServiceLevel.PreventiveOnly, "PM Only", "PM round (ล้าง+ตรวจ) ไม่มี cloud account"),
                                (SolarApp.Models.Enums.ServiceLevel.Custom, "Custom", "เลือกเองด้านล่าง"),
                            })
                            {
                                <input type="radio" class="btn-check" name="Input.ServiceLevel"
                                       id="svc-@level.Item1" value="@((int)level.Item1)"
                                       checked="@(Model.Input.ServiceLevel == level.Item1)" autocomplete="off" />
                                <label class="btn btn-outline-primary mb-1 me-1" for="svc-@level.Item1"
                                       title="@level.Item3">@level.Item2</label>
                            }
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesMonitoring" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesMonitoring" class="form-check-label">มอนิเตอร์ระบบ</label>
                                <div class="form-text small mt-0">ดึงข้อมูลจาก cloud · แจ้งเตือนออฟไลน์/ผลิตต่ำ</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesCleaning" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesCleaning" class="form-check-label">ล้างแผงตามรอบ</label>
                                <div class="form-text small mt-0">นัดล้าง · แจ้งเตือนครบกำหนดล้าง</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesPreventiveMaintenance" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesPreventiveMaintenance" class="form-check-label">บำรุงรักษาเชิงป้องกัน</label>
                                <div class="form-text small mt-0">ระบุในสัญญา (ยังไม่มีแจ้งเตือนอัตโนมัติ)</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesCorrectiveMaintenance" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesCorrectiveMaintenance" class="form-check-label">ซ่อมแก้ไขเมื่อเสีย</label>
                                <div class="form-text small mt-0">ระบุในสัญญา (ยังไม่มีแจ้งเตือนอัตโนมัติ)</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="form-check">
                                <input asp-for="Input.IncludesWarrantyService" class="form-check-input service-flag" />
                                <label asp-for="Input.IncludesWarrantyService" class="form-check-label">ดูแลงานประกัน</label>
                                <div class="form-text small mt-0">แจ้งเตือนประกันใกล้หมด (90 วัน)</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ServiceNotes" class="form-label">หมายเหตุเงื่อนไขบริการ</label>
                        <textarea asp-for="Input.ServiceNotes" class="form-control" rows="2"
                                  placeholder="เช่น &quot;PM 2 ครั้ง/ปี เท่านั้น&quot;"></textarea>
                    </div>
                    @* ─── End Service Scope ────────────────────────────────────────── *@

                    <div class="mb-3">
                        <label asp-for="Input.Notes" class="form-label">หมายเหตุ</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                        <button type="submit" class="btn btn-warning">สร้างไซต์งาน</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ─── Warranty end dates ────────────────────────────────────────
        // Keeps each calculated date in its box while nobody has touched it,
        // and stops the moment someone types their own — the server used to
        // overwrite it on every save, which made a correct end date impossible
        // to record. Used for the site warranty and the inverter warranty.
        function bindWarrantyEnd(ids) {
            const start = document.getElementById('warrantyStart');
            const years = document.getElementById(ids.years);
            const end = document.getElementById(ids.end);
            const state = document.getElementById(ids.state);
            const hint = document.getElementById(ids.hint);
            const reset = document.getElementById(ids.reset);
            if (!start || !years || !end) return;

            function calculated() {
                if (!start.value) return '';
                const y = parseInt(years.value, 10);
                if (isNaN(y) || y <= 0) return '';

                // Built from Y/M/D parts: a local Date round-trip shifts the day
                // by one in UTC+7. And 29 Feb clamps to 28 Feb, matching
                // DateTime.AddYears on the server — otherwise the two disagree
                // and the stored date loads as "กำหนดเอง" for no reason.
                const [yy, mm, dd] = start.value.split('-').map(Number);
                let d = new Date(Date.UTC(yy + y, mm - 1, dd));
                if (d.getUTCMonth() !== mm - 1) d = new Date(Date.UTC(yy + y, mm, 0));
                return d.toISOString().slice(0, 10);
            }

            function thai(iso) {
                if (!iso) return '';
                const [y, m, d] = iso.split('-');
                return d + '/' + m + '/' + y;
            }

            // A stored date that already differs from the calculation was set
            // deliberately — don't recompute over it on load.
            let overridden = end.value !== '' && end.value !== calculated();

            function refresh() {
                const calc = calculated();
                if (!overridden) end.value = calc;

                const differs = calc && end.value && end.value !== calc;
                if (state) {
                    state.textContent = differs ? 'กำหนดเอง' : 'คำนวณอัตโนมัติ';
                    state.className = differs
                        ? 'badge bg-warning text-dark'
                        : 'badge bg-light text-muted border';
                }
                if (hint) {
                    hint.innerHTML = differs
                        ? 'แก้ไขเอง — ระบบจะใช้วันที่นี้ ไม่ทับด้วยค่าที่คำนวณ ' +
                          '<span class="text-muted">(คำนวณได้ ' + thai(calc) + ')</span>'
                        : (calc ? 'คำนวณจากวันส่งมอบ + ระยะประกัน — แก้ไขได้' : '');
                }
            }

            start.addEventListener('change', refresh);
            years.addEventListener('input', refresh);
            end.addEventListener('keydown', () => { overridden = true; });
            end.addEventListener('change', () => { overridden = true; refresh(); });
            reset?.addEventListener('click', () => { overridden = false; refresh(); });

            refresh();
        }

        bindWarrantyEnd({ years: 'warrantyYears', end: 'warrantyEnd', state: 'warrantyEndState',
                          hint: 'warrantyEndHint', reset: 'warrantyEndReset' });
        bindWarrantyEnd({ years: 'invWarrantyYears', end: 'invWarrantyEnd', state: 'invWarrantyEndState',
                          hint: 'invWarrantyEndHint', reset: 'invWarrantyEndReset' });


        // ─── Service-scope preset → flag auto-toggling ───────────────────────
        const SERVICE_LEVEL_PRESETS = {
            0:  { mon: true,  clean: true,  pm: true,  cm: true,  warr: true  },
            1:  { mon: true,  clean: false, pm: false, cm: false, warr: false },
            2:  { mon: false, clean: true,  pm: false, cm: false, warr: false },
            3:  { mon: false, clean: true,  pm: true,  cm: false, warr: false },
        };
        const flagMap = {
            mon:   'Input.IncludesMonitoring',
            clean: 'Input.IncludesCleaning',
            pm:    'Input.IncludesPreventiveMaintenance',
            cm:    'Input.IncludesCorrectiveMaintenance',
            warr:  'Input.IncludesWarrantyService',
        };
        document.querySelectorAll('input[name="Input.ServiceLevel"]').forEach(radio => {
            radio.addEventListener('change', e => {
                const preset = SERVICE_LEVEL_PRESETS[parseInt(e.target.value, 10)];
                if (!preset) return;
                Object.entries(flagMap).forEach(([k, name]) => {
                    const el = document.querySelector(`[name="${name}"]`);
                    if (el) el.checked = preset[k];
                });
            });
        });
        document.querySelectorAll('.service-flag').forEach(cb => {
            cb.addEventListener('change', () => {
                // Select the preset the switches now describe, or Custom when
                // none matches — the server derives it the same way on save.
                const cur = {};
                Object.entries(flagMap).forEach(([k, name]) => {
                    cur[k] = !!document.querySelector(`[name="${name}"]`)?.checked;
                });
                const match = Object.entries(SERVICE_LEVEL_PRESETS).find(([, p]) =>
                    Object.keys(flagMap).every(k => p[k] === cur[k]));
                const radio = document.querySelector(
                    `input[name="Input.ServiceLevel"][value="${match ? match[0] : 99}"]`);
                if (radio) radio.checked = true;
            });
        });

        document.getElementById('testConnectionBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('testConnectionBtn');
            const result = document.getElementById('testResult');
            const formData = new FormData();
            formData.append('brand', document.querySelector('[name="Input.InverterBrand"]').value);
            formData.append('apiKey', document.querySelector('[name="Input.CloudApiKey"]').value);
            formData.append('apiSecret', document.querySelector('[name="Input.CloudApiSecret"]').value);
            formData.append('username', document.querySelector('[name="Input.CloudUsername"]').value);
            formData.append('password', document.querySelector('[name="Input.CloudPassword"]').value);
            formData.append('plantId', document.querySelector('[name="Input.PlantId"]').value);
            formData.append('apiBaseUrl', document.querySelector('[name="Input.CloudApiBaseUrl"]')?.value || '');

            btn.disabled = true;
            result.innerHTML = '<span class="text-muted"><i class="spinner-border spinner-border-sm"></i> Testing...</span>';

            try {
                const r = await fetch('/api/test-inverter-connection', { method: 'POST', body: formData });
                const data = await r.json();
                if (data.success) {
                    let html = '<div class="alert alert-success mt-2 mb-0 p-2"><i class="bi bi-check-circle-fill"></i> ' + data.message + '</div>';

                    if (data.plantInfo) {
                        html += '<div class="card mt-2 border-success"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-success">ข้อมูลโรงไฟฟ้า</h6>';
                        html += '<div><strong>ID:</strong> ' + (data.plantInfo.plantId || '-') + '</div>';
                        html += '<div><strong>ชื่อ:</strong> ' + (data.plantInfo.plantName || '-') + '</div>';
                        html += '<div><strong>กำลังติดตั้ง:</strong> ' + (data.plantInfo.capacityKw || 0) + ' kW</div>';
                        if (data.plantInfo.address) html += '<div><strong>ที่อยู่:</strong> ' + data.plantInfo.address + '</div>';
                        html += '</div></div>';
                    }

                    if (data.realtime) {
                        const rt = data.realtime;
                        html += '<div class="card mt-2 border-info"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-info">ข้อมูลสด</h6>';
                        html += '<div><strong>สถานะ:</strong> <span class="badge bg-' + (rt.isOnline ? 'success' : 'secondary') + '">' + (rt.isOnline ? 'ONLINE' : 'OFFLINE') + '</span></div>';
                        html += '<div><strong>กำลังผลิตขณะนี้:</strong> ' + (rt.currentPowerKw || 0).toFixed(2) + ' kW</div>';
                        html += '<div><strong>พลังงานวันนี้:</strong> ' + (rt.todayEnergyKwh || 0).toFixed(2) + ' kWh</div>';
                        html += '<div><strong>พลังงานสะสม:</strong> ' + (rt.totalEnergyKwh || 0).toFixed(2) + ' kWh</div>';
                        if (rt.batterySocPercent !== null) html += '<div><strong>ระดับแบตเตอรี่:</strong> ' + rt.batterySocPercent + '%</div>';
                        html += '<div class="text-muted small">Updated: ' + new Date(rt.timestamp).toLocaleString() + '</div>';
                        html += '</div></div>';
                    }

                    if (data.deviceCount > 0) {
                        html += '<div class="card mt-2 border-warning"><div class="card-body p-2">';
                        html += '<h6 class="mb-2 text-warning">อุปกรณ์ (' + data.deviceCount + ')</h6>';
                        for (const d of data.devices) {
                            html += '<div>• ' + d.deviceName + ' (' + (d.model || d.deviceId) + ') - ' + (d.isOnline ? 'Online' : 'Offline') + '</div>';
                        }
                        html += '</div></div>';
                    }

                    if (!data.plantInfo && !data.realtime) {
                        html += '<div class="alert alert-warning mt-2 mb-0 p-2"><i class="bi bi-exclamation-triangle"></i> Connected, but no plant/realtime data returned. Check Plant ID.</div>';
                    }

                    result.innerHTML = html;
                } else {
                    result.innerHTML = '<div class="alert alert-danger mt-2 mb-0 p-2"><i class="bi bi-x-circle-fill"></i> ' + data.message + '</div>';
                }
            } catch (e) {
                result.innerHTML = '<div class="alert alert-danger mt-2 mb-0 p-2"><i class="bi bi-x-circle-fill"></i> Test failed: ' + e.message + '</div>';
            } finally {
                btn.disabled = false;
            }
        });

        // Battery section toggle — same behaviour as Edit page.
        function applyBatteryVisibility() {
            const cb = document.getElementById('Input_HasBattery');
            if (!cb) return;
            document.querySelectorAll('.battery-fields-row').forEach(row => {
                row.style.display = cb.checked ? '' : 'none';
            });
        }
        document.getElementById('Input_HasBattery')?.addEventListener('change', applyBatteryVisibility);
        applyBatteryVisibility();
    </script>
}

