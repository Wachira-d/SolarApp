@page
@model SolarApp.Pages.Map.IndexModel
@{
    ViewData["Title"] = "แผนที่ไซต์งาน";
    var markersJson = System.Text.Json.JsonSerializer.Serialize(Model.Markers);
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
    #siteMap { height: calc(100vh - 200px); min-height: 450px; border-radius: 0.5rem; }
    html[data-theme="dark"] .leaflet-tile-pane { filter: brightness(0.85) invert(0.95) hue-rotate(180deg); }
    .legend-dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; vertical-align: middle; margin-right: 5px; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-geo-alt"></i> แผนที่ไซต์งาน</h4>
        <small class="text-muted">แสดงบนแผนที่ @Model.MappedSites / ทั้งหมด @Model.TotalSites ไซต์</small>
    </div>
    <div class="d-flex gap-3 align-items-center small flex-wrap">
        <span><span class="legend-dot" style="background:#198754"></span> ปกติ (ครั้งต่อไป &gt; 30 วัน)</span>
        <span title="ใกล้กำหนดเข้าล้าง / PM ภายใน 8-30 วัน — เผื่อวางแผนเส้นทาง">
            <span class="legend-dot" style="background:#ffc107"></span> ใกล้กำหนด (8-30 วัน)
        </span>
        <span title="ภายใน 1 สัปดาห์">
            <span class="legend-dot" style="background:#fd7e14"></span> เร่งด่วน (≤ 7 วัน)
        </span>
        <span><span class="legend-dot" style="background:#dc3545"></span> เลยกำหนด / ออฟไลน์</span>
        <span><span class="legend-dot" style="background:#6c757d"></span> ปิดใช้งาน</span>
    </div>
</div>

@if (Model.MappedSites == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        ยังไม่มีไซต์ที่กรอกพิกัด GPS — ไปที่หน้าไซต์งานแล้วเพิ่ม Latitude / Longitude เพื่อให้แสดงบนแผนที่
    </div>
}
else
{
    @* Cleaning is planned a province at a time — two sites due the same week
       but 400 km apart is not a route. The map already knows what's due and
       where; without this the operator read the pins, wrote the addresses on
       paper, and typed them into Maps one by one. *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0"><i class="bi bi-signpost-split"></i> วางแผนเส้นทางเข้าไซต์</h6>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <select id="routeDue" class="form-select form-select-sm" style="width:auto">
                    <option value="0">เลยกำหนดแล้ว</option>
                    <option value="7">ครบกำหนดใน 7 วัน</option>
                    <option value="30" selected>ครบกำหนดใน 30 วัน</option>
                    <option value="90">ครบกำหนดใน 90 วัน</option>
                </select>
                <select id="routeProvince" class="form-select form-select-sm" style="width:auto">
                    <option value="">ทุกจังหวัด</option>
                </select>
                <button type="button" id="routeBuild" class="btn btn-sm btn-success">
                    <i class="bi bi-sign-turn-right-fill"></i> เปิดเส้นทางใน Google Maps
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="routeList" class="small"></div>
            <div class="form-text mt-2">
                Google Maps รับได้สูงสุด 10 จุดต่อเส้นทาง — ถ้าเลือกเกินนั้น
                ระบบจะพาไป 10 จุดแรกตามลำดับเส้นทางที่จัดให้ แล้วค่อยวางแผนรอบถัดไป
            </div>
        </div>
    </div>

    <div id="siteMap"></div>
}

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function(){
    const markers = @Html.Raw(markersJson);
    if (!markers.length) return;

    const map = L.map('siteMap').setView([markers[0].Lat, markers[0].Lng], 6);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    // Pin colour gradient.  We pick the SOONEST of (cleaning, PM) and pick
    // a band from it.  Offline always wins (red); Inactive always grey.
    // Within Active, the gradient is purely a "do I need to drive there
    // soon?" hint — so a perfectly-running site whose cleaning is 12 days
    // out is yellow even if no MA is needed.
    function colorFor(m) {
        if (m.Status === 'Offline') return '#dc3545';
        if (m.Status === 'Inactive') return '#6c757d';

        const candidates = [];
        if (m.DaysToNextCleaning !== null && m.DaysToNextCleaning !== undefined) candidates.push(m.DaysToNextCleaning);
        if (m.DaysToNextPm !== null && m.DaysToNextPm !== undefined) candidates.push(m.DaysToNextPm);
        const soonest = candidates.length ? Math.min.apply(null, candidates) : null;

        // Open work orders / pending maintenance count as "needs visit now".
        const hasPendingWork = (m.OpenMaintenanceCount || 0) > 0 || (m.OpenWorkOrderCount || 0) > 0;
        if (m.CleaningOverdue || hasPendingWork) return '#dc3545';

        if (soonest === null) return '#198754';        // no scheduled visit → green
        if (soonest < 0)  return '#dc3545';            // overdue → red
        if (soonest <= 7) return '#fd7e14';            // ≤ 1 week → orange
        if (soonest <= 30) return '#ffc107';           // 8-30 days → yellow
        return '#198754';                              // > 30 days → green
    }

    // Short Thai status descriptor for tooltips ("ใน 12 วัน", "วันนี้",
    // "เลยมาแล้ว 3 วัน").  Keeps the hover terse — the popup has the
    // full date.
    function relativeDay(days) {
        if (days === null || days === undefined) return null;
        if (days < 0) return `เลยกำหนด ${-days} วัน`;
        if (days === 0) return 'วันนี้';
        if (days === 1) return 'พรุ่งนี้';
        return `อีก ${days} วัน`;
    }

    const group = L.featureGroup();
    markers.forEach(m => {
        const marker = L.circleMarker([m.Lat, m.Lng], {
            radius: Math.max(8, Math.min(20, m.CapacityKw / 5)),
            fillColor: colorFor(m),
            color: '#fff',
            weight: 2,
            fillOpacity: 0.85
        });

        const alertBadge = m.UnresolvedAlerts > 0
            ? `<span class="badge bg-danger ms-1">${m.UnresolvedAlerts} แจ้งเตือน</span>` : '';
        const maBadge = m.NeedsMaintenance
            ? `<span class="badge bg-warning text-dark ms-1"><i class="bi bi-tools"></i> ต้องเข้า MA</span>` : '';

        const maDetails = [];
        if (m.CleaningOverdue) maDetails.push('🧽 ล้างแผงเลยกำหนด');
        if (m.OpenMaintenanceCount > 0) maDetails.push(`🔧 มีรายการบำรุงรักษาค้าง ${m.OpenMaintenanceCount} รายการ`);
        if (m.OpenWorkOrderCount > 0) maDetails.push(`📋 มีใบสั่งงานค้าง ${m.OpenWorkOrderCount} รายการ`);
        const maHtml = maDetails.length
            ? `<div class="alert alert-warning small mt-2 mb-0 py-1 px-2">${maDetails.join('<br>')}</div>`
            : '';

        const cleaningRel = relativeDay(m.DaysToNextCleaning);
        const pmRel = relativeDay(m.DaysToNextPm);

        // Hover tooltip — fast glance while planning a route.
        const tooltipParts = [m.Name];
        if (m.NextCleaningDueDate) tooltipParts.push(`🧽 ล้างแผง: ${m.NextCleaningDueDate}${cleaningRel ? ' (' + cleaningRel + ')' : ''}`);
        if (m.NextPmDueDate)       tooltipParts.push(`🔧 PM: ${m.NextPmDueDate}${pmRel ? ' (' + pmRel + ')' : ''}`);
        if (m.NeedsMaintenance && !m.NextCleaningDueDate && !m.NextPmDueDate)
            tooltipParts.push('⚠ ต้องเข้า MA');
        marker.bindTooltip(tooltipParts.join('<br>'), { direction: 'top', sticky: false, opacity: 0.95 });

        // Popup — full details on click.
        const schedRows = [];
        if (m.NextCleaningDueDate) schedRows.push(`🧽 ล้างแผงครั้งต่อไป: <strong>${m.NextCleaningDueDate}</strong>${cleaningRel ? ` <span class="text-muted">(${cleaningRel})</span>` : ''}`);
        if (m.NextPmDueDate)       schedRows.push(`🔧 PM ครั้งต่อไป: <strong>${m.NextPmDueDate}</strong>${pmRel ? ` <span class="text-muted">(${pmRel})</span>` : ''}`);
        const schedHtml = schedRows.length
            ? `<div class="mt-2 small">${schedRows.join('<br>')}</div>` : '';

        // Handing the technician the coordinates and letting them retype those
        // into a maps app is the slow way to do the only thing this pin is for.
        // api=1 links open the installed Google Maps app on a phone and the web
        // map on a desktop, so one URL covers both.
        const coords = `${m.Lat},${m.Lng}`;
        const navUrl = `https://www.google.com/maps/dir/?api=1&destination=${coords}`;
        const viewUrl = `https://www.google.com/maps/search/?api=1&query=${coords}`;

        marker.bindPopup(`
            <div style="min-width:230px">
                <strong>${m.Name}</strong>${alertBadge}${maBadge}<br>
                <small class="text-muted">${m.SiteCode || ''}</small><br>
                <div class="mt-1">
                    <span class="badge" style="background:${colorFor(m)}">${m.Status}</span>
                    <span class="badge bg-info">${m.Brand}</span>
                </div>
                <div class="mt-1 small">${m.CapacityKw} kW</div>
                ${schedHtml}
                ${maHtml}
                <a href="/Installations/Detail/${m.Id}" class="btn btn-sm btn-primary mt-2 w-100">
                    เปิดดูไซต์
                </a>
                <div class="d-flex gap-1 mt-1">
                    <a href="${navUrl}" target="_blank" rel="noopener"
                       class="btn btn-sm btn-success flex-fill">
                        <i class="bi bi-sign-turn-right-fill"></i> นำทาง
                    </a>
                    <a href="${viewUrl}" target="_blank" rel="noopener"
                       class="btn btn-sm btn-outline-secondary flex-fill">
                        <i class="bi bi-geo-alt"></i> Google Maps
                    </a>
                </div>
            </div>
        `);

        marker.addTo(map);
        group.addLayer(marker);
    });

    if (markers.length > 1) {
        map.fitBounds(group.getBounds().pad(0.1));
    }

    // ─── Route planner ───────────────────────────────────────────────
    // Nearest-neighbour from the northernmost site. Not the optimal tour —
    // that's NP-hard and the operator knows the roads better than we do —
    // but it beats the arrival order, which is alphabetical by accident.
    (function () {
        const dueSel = document.getElementById('routeDue');
        const provSel = document.getElementById('routeProvince');
        const listEl = document.getElementById('routeList');
        const buildBtn = document.getElementById('routeBuild');
        if (!dueSel || !provSel || !listEl || !buildBtn) return;

        const MAX_STOPS = 10;   // Google Maps: origin + 8 waypoints + destination

        // Only sites with a cleaning date can be planned around; a site with
        // no schedule has nothing to be "due".
        const plannable = markers.filter(m => m.DaysToNextCleaning !== null
                                              && m.DaysToNextCleaning !== undefined);

        [...new Set(plannable.map(m => m.Province).filter(Boolean))]
            .sort((a, b) => a.localeCompare(b, 'th'))
            .forEach(p => {
                const o = document.createElement('option');
                o.value = p; o.textContent = p;
                provSel.appendChild(o);
            });

        function selected() {
            const within = parseInt(dueSel.value, 10);
            const prov = provSel.value;
            return plannable
                .filter(m => m.DaysToNextCleaning <= within)
                .filter(m => !prov || m.Province === prov);
        }

        // Equirectangular approximation. Over one Thai province the error is
        // metres, and we only need the ordering to be sane.
        function dist(a, b) {
            const dLat = a.Lat - b.Lat;
            const dLng = (a.Lng - b.Lng) * Math.cos((a.Lat + b.Lat) / 2 * Math.PI / 180);
            return Math.sqrt(dLat * dLat + dLng * dLng);
        }

        function order(sites) {
            if (sites.length < 3) return sites.slice();
            const remaining = sites.slice();
            // Start from the northernmost so the run reads top-to-bottom,
            // which is how a day out of Bangkok is usually planned.
            remaining.sort((a, b) => b.Lat - a.Lat);
            const route = [remaining.shift()];
            while (remaining.length) {
                const last = route[route.length - 1];
                let best = 0;
                for (let i = 1; i < remaining.length; i++) {
                    if (dist(last, remaining[i]) < dist(last, remaining[best])) best = i;
                }
                route.push(remaining.splice(best, 1)[0]);
            }
            return route;
        }

        function escapeHtml(v) {
            return String(v ?? '').replace(/[&<>"']/g, c => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));
        }

        let current = [];

        function refresh() {
            current = order(selected());
            if (!current.length) {
                listEl.innerHTML = '<span class="text-muted">ไม่มีไซต์ที่ตรงเงื่อนไข</span>';
                buildBtn.disabled = true;
                return;
            }
            buildBtn.disabled = false;
            listEl.innerHTML =
                '<div class="mb-2"><strong>' + current.length + ' ไซต์</strong> ตามลำดับเส้นทางที่แนะนำ</div>' +
                '<ol class="mb-0 ps-3">' + current.map((m, i) => {
                    const d = m.DaysToNextCleaning;
                    const label = d < 0 ? 'เลยกำหนด ' + Math.abs(d) + ' วัน'
                        : d === 0 ? 'ครบกำหนดวันนี้' : 'อีก ' + d + ' วัน';
                    const cls = d < 0 ? 'text-danger' : d <= 7 ? 'text-warning' : 'text-muted';
                    const over = i >= MAX_STOPS ? ' class="text-muted"' : '';
                    return '<li' + over + '>' + escapeHtml(m.Name) +
                        ' <small class="' + cls + '">(' + label + ')</small>' +
                        (m.Province ? ' <small class="text-muted">· ' + escapeHtml(m.Province) + '</small>' : '') +
                        (i >= MAX_STOPS ? ' <small class="text-muted">— รอบถัดไป</small>' : '') +
                        '</li>';
                }).join('') + '</ol>';
        }

        dueSel.addEventListener('change', refresh);
        provSel.addEventListener('change', refresh);

        buildBtn.addEventListener('click', () => {
            const stops = current.slice(0, MAX_STOPS);
            if (!stops.length) return;

            const coords = stops.map(m => m.Lat + ',' + m.Lng);
            const destination = coords[coords.length - 1];
            const waypoints = coords.slice(0, -1);

            // Single stop: no waypoints, just navigate there.
            const url = 'https://www.google.com/maps/dir/?api=1&destination=' +
                encodeURIComponent(destination) +
                (waypoints.length ? '&waypoints=' + encodeURIComponent(waypoints.join('|')) : '') +
                '&travelmode=driving';
            window.open(url, '_blank', 'noopener');
        });

        refresh();
    })();
})();
</script>
}
