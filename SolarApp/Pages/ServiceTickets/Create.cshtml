@page
@model SolarApp.Pages.ServiceTickets.CreateModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "แจ้งซ่อมใหม่";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">แจ้งซ่อมใหม่</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="InstallationId" class="form-label">ไซต์งาน *</label>
                        <select asp-for="InstallationId" asp-items="Model.Installations" class="form-select">
                            <option value="">-- เลือกไซต์งาน --</option>
                        </select>
                        <span asp-validation-for="InstallationId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">หัวข้อ *</label>
                        <input asp-for="Subject" class="form-control" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">รายละเอียด *</label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Priority" class="form-label">ความสำคัญ</label>
                        <select asp-for="Priority" class="form-select">
                            @foreach (var pr in Enum.GetValues<TicketPriority>())
                            { <option value="@((int)pr)">@UiLabels.Label(pr)</option> }
                        </select>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        @if (Model.InstallationId > 0)
                        {
                            <a asp-page="/Installations/Detail" asp-route-id="@Model.InstallationId" class="btn btn-outline-secondary">ยกเลิก</a>
                        }
                        else
                        {
                            <a asp-page="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                        }
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle"></i> รับเรื่อง</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
