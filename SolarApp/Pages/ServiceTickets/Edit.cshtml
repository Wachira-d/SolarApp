@page "{id:int}"
@model SolarApp.Pages.ServiceTickets.EditModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = $"งานแจ้งซ่อม {Model.Ticket.TicketNumber}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">
            <span class="badge @UiLabels.Badge(Model.Ticket.Status) fs-6 align-middle">@UiLabels.Label(Model.Ticket.Status)</span>
            @Model.Ticket.Subject
        </h4>
        <small class="text-muted">@Model.Ticket.TicketNumber · @Model.Ticket.Installation.SiteName</small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.IsAdminOrPartner && Model.Ticket.Status != TicketStatus.Resolved && Model.Ticket.Status != TicketStatus.Closed
             && !Model.WorkOrders.Any(w => w.Status != WorkOrderStatus.Cancelled))
        {
            <a asp-page="/WorkOrders/Create" asp-route-ticketId="@Model.Ticket.Id" class="btn btn-warning">
                <i class="bi bi-clipboard2-plus"></i> นัดช่างเข้าไซต์
            </a>
        }
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> กลับ
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="mb-3">
                        <label class="form-label">หัวข้อ *</label>
                        <input asp-for="Input.Subject" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">รายละเอียด *</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ความสำคัญ</label>
                            <select asp-for="Input.Priority" class="form-select">
                                @foreach (var pr in Enum.GetValues<TicketPriority>())
                                { <option value="@((int)pr)">@UiLabels.Label(pr)</option> }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">สถานะ</label>
                            <select asp-for="Input.Status" class="form-select" disabled="@(!Model.IsAdminOrPartner)">
                                @foreach (var st in Enum.GetValues<TicketStatus>())
                                { <option value="@((int)st)">@UiLabels.Label(st)</option> }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ผู้รับผิดชอบ</label>
                            <select asp-for="Input.AssignedToUserId" asp-items="Model.Assignees" class="form-select">
                                <option value="">-- ยังไม่มอบหมาย --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">วิธีแก้ไข</label>
                        <textarea asp-for="Input.Resolution" class="form-control" rows="3"
                                  placeholder="แก้ไขปัญหานี้อย่างไร..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">หมายเหตุภายใน</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> บันทึกการแก้ไข
                        </button>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="submit" asp-page-handler="Delete" asp-route-id="@Model.Ticket.Id"
                                    class="btn btn-outline-danger ms-auto"
                                    onclick="return confirm('ลบงานแจ้งซ่อมนี้ถาวร?');">
                                <i class="bi bi-trash"></i> ลบ
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @* The visit that answers this ticket — without it the ticket page was
           a dead end and the technician had to find the work order by hand. *@
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-clipboard2-check"></i> ใบสั่งงานของเรื่องนี้</h6></div>
            <div class="list-group list-group-flush">
                @foreach (var w in Model.WorkOrders)
                {
                    <a asp-page="/WorkOrders/Detail" asp-route-id="@w.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <span class="fw-semibold">@w.Title</span>
                            <small class="text-muted d-block">@w.ScheduledDate.ToString("dd/MM/yyyy") · @(w.AssignedToUser?.FullName ?? w.AssignedTeam ?? "ยังไม่ระบุช่าง")</small>
                        </div>
                        <span class="badge @UiLabels.Badge(w.Status)">@UiLabels.Label(w.Status)</span>
                    </a>
                }
                @if (!Model.WorkOrders.Any())
                {
                    <div class="list-group-item text-muted small">ยังไม่ได้นัดช่าง — กด "นัดช่างเข้าไซต์" เมื่อพร้อม</div>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">ข้อมูลงานแจ้งซ่อม</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted">ไซต์งาน</td><td>@Model.Ticket.Installation.SiteName</td></tr>
                        <tr><td class="text-muted">ลูกค้า</td><td>@Model.Ticket.Installation.Customer.FullName</td></tr>
                        <tr><td class="text-muted">ผู้แจ้ง</td><td>@Model.Ticket.ReportedByUser.FullName</td></tr>
                        <tr><td class="text-muted">แจ้งเมื่อ</td><td>@SolarApp.Services.SiteTime.ToSiteTime(Model.Ticket.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td></tr>
                        <tr><td class="text-muted">แก้ไขล่าสุด</td><td>@SolarApp.Services.SiteTime.ToSiteTime(Model.Ticket.UpdatedAt).ToString("dd/MM/yyyy HH:mm")</td></tr>
                        @if (Model.Ticket.ResolvedAt.HasValue)
                        {
                            <tr><td class="text-muted">แก้ไขเสร็จ</td><td>@(SolarApp.Services.SiteTime.ToSiteTime(Model.Ticket.ResolvedAt)?.ToString("dd/MM/yyyy HH:mm"))</td></tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
