@page
@model SolarApp.Pages.ServiceTickets.IndexModel
@{
    ViewData["Title"] = "แจ้งซ่อม";
}

<div class="d-flex justify-content-between mb-3">
    <h4>แจ้งซ่อม / ปัญหา</h4>
    <a asp-page="Create" class="btn btn-warning btn-sm">
        <i class="bi bi-plus-lg"></i> แจ้งซ่อมใหม่
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between">
        <h6 class="mb-0">รายการทั้งหมด</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>เลขที่</th>
                        <th>ไซต์งาน</th>
                        <th>หัวข้อ</th>
                        <th>ความสำคัญ</th>
                        <th>สถานะ</th>
                        <th>ผู้แจ้ง</th>
                        <th>ผู้รับผิดชอบ</th>
                        <th>วันที่แจ้ง</th>
                        <th class="text-end">การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Tickets)
                    {
                        var priorityClass = t.Priority switch
                        {
                            SolarApp.Models.Enums.TicketPriority.Urgent => "bg-danger",
                            SolarApp.Models.Enums.TicketPriority.High => "bg-warning",
                            SolarApp.Models.Enums.TicketPriority.Normal => "bg-info",
                            _ => "bg-secondary"
                        };
                        var priorityLabel = t.Priority switch
                        {
                            SolarApp.Models.Enums.TicketPriority.Urgent => "เร่งด่วน",
                            SolarApp.Models.Enums.TicketPriority.High => "สูง",
                            SolarApp.Models.Enums.TicketPriority.Normal => "ปกติ",
                            SolarApp.Models.Enums.TicketPriority.Low => "ต่ำ",
                            _ => t.Priority.ToString()
                        };
                        var statusClass = t.Status switch
                        {
                            SolarApp.Models.Enums.TicketStatus.Open => "bg-primary",
                            SolarApp.Models.Enums.TicketStatus.InProgress => "bg-warning",
                            SolarApp.Models.Enums.TicketStatus.Resolved => "bg-success",
                            SolarApp.Models.Enums.TicketStatus.Closed => "bg-secondary",
                            _ => "bg-info"
                        };
                        var statusLabel = t.Status switch
                        {
                            SolarApp.Models.Enums.TicketStatus.Open => "เปิด",
                            SolarApp.Models.Enums.TicketStatus.InProgress => "กำลังดำเนินการ",
                            SolarApp.Models.Enums.TicketStatus.Resolved => "แก้ไขแล้ว",
                            SolarApp.Models.Enums.TicketStatus.Closed => "ปิดเรื่อง",
                            _ => t.Status.ToString()
                        };
                        <tr>
                            <td><strong>@t.TicketNumber</strong></td>
                            <td>@t.Installation.SiteName</td>
                            <td>@t.Subject</td>
                            <td><span class="badge @priorityClass">@priorityLabel</span></td>
                            <td><span class="badge @statusClass">@statusLabel</span></td>
                            <td>@t.ReportedByUser.FullName</td>
                            <td>@(t.AssignedToUser?.FullName ?? "-")</td>
                            <td>@t.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> แก้ไข
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Tickets.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">ยังไม่มีรายการแจ้งซ่อม</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
