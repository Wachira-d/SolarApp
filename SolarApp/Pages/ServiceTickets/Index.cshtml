@page
@model SolarApp.Pages.ServiceTickets.IndexModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "แจ้งซ่อม";
    var open = Model.Tickets.Where(t => t.Status != TicketStatus.Resolved && t.Status != TicketStatus.Closed).ToList();
    var closed = Model.Tickets.Except(open).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-ticket-detailed"></i> แจ้งซ่อม / ปัญหา</h4>
        <small class="text-muted">เรื่องที่รับแจ้งเข้ามา — นัดช่างได้จากในเรื่อง</small>
    </div>
    <a asp-page="Create" class="btn btn-warning">
        <i class="bi bi-plus-lg"></i> แจ้งซ่อมใหม่
    </a>
</div>

@if (TempData["StatusMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show">@msg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Tickets.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-ticket-detailed d-block mb-2" style="font-size:3rem"></i>
            ยังไม่มีรายการแจ้งซ่อม
        </div>
    </div>
    return;
}

@{
    // async Task, not void: the body contains a tag helper (asp-page), and
    // Razor only allows those in an async helper (MVC1006 / CS4033).
    async Task TicketList(List<SolarApp.Models.ServiceTicket> list)
    {
        <div class="list-group list-group-flush">
            @foreach (var t in list)
            {
                <a asp-page="Edit" asp-route-id="@t.Id" class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <span class="badge @UiLabels.Badge(t.Priority) me-1">@UiLabels.Label(t.Priority)</span>
                            <span class="fw-semibold">@t.Subject</span>
                        </div>
                        <span class="badge @UiLabels.Badge(t.Status) text-nowrap">@UiLabels.Label(t.Status)</span>
                    </div>
                    <small class="text-muted d-block mt-1">
                        @t.Installation.SiteName · @t.TicketNumber
                        · แจ้งโดย @t.ReportedByUser.FullName
                        · @SolarApp.Services.SiteTime.ToSiteTime(t.CreatedAt).ToString("dd/MM/yy")
                        @if (t.AssignedToUser != null) { <span>· ผู้รับผิดชอบ @t.AssignedToUser.FullName</span> }
                    </small>
                </a>
            }
        </div>
    }
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">ยังไม่ปิดเรื่อง</h6>
        <span class="badge bg-primary">@open.Count</span>
    </div>
    @if (open.Any()) { await TicketList(open); }
    else { <div class="card-body text-success text-center"><i class="bi bi-check-circle-fill"></i> ไม่มีเรื่องค้าง</div> }
</div>

@if (closed.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 text-muted">ปิดเรื่องแล้ว</h6>
            <span class="badge bg-secondary">@closed.Count</span>
        </div>
        @{ await TicketList(closed); }
    </div>
}
