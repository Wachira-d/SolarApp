@page
@model SolarApp.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-sun text-warning" style="font-size: 3rem;"></i>
                    <h3 class="mt-2">SolarApp</h3>
                    <p class="text-muted">Solar Installation Management System</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="email@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 mb-3">Login</button>
                </form>

                @if (Model.ExternalProviders.Any())
                {
                    <div class="text-center text-muted my-3">
                        <small>— OR —</small>
                    </div>
                    <form method="post" asp-page="/Account/ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl">
                        @foreach (var provider in Model.ExternalProviders)
                        {
                            var (label, icon, colour) = provider.Name switch
                            {
                                "Microsoft" => ("Sign in with Microsoft / Office 365", "bi-microsoft", "btn-outline-primary"),
                                "LINE"      => ("Sign in with LINE", "bi-chat-dots-fill", "btn-success"),
                                _           => ($"Sign in with {provider.DisplayName}", "bi-box-arrow-in-right", "btn-outline-secondary")
                            };
                            <button type="submit" name="provider" value="@provider.Name"
                                    class="btn @colour w-100 mb-2">
                                <i class="bi @icon me-2"></i>@label
                            </button>
                        }
                    </form>
                }
                else
                {
                    <div class="alert alert-light small text-muted mb-0">
                        <i class="bi bi-info-circle"></i>
                        External login (Microsoft/LINE) is not configured. Ask your admin to fill in
                        <code>Authentication:Microsoft</code> or <code>Authentication:LINE</code> in appsettings.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
