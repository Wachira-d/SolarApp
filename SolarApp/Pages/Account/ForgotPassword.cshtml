@page
@model SolarApp.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "ลืมรหัสผ่าน";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-3"><i class="bi bi-key text-warning"></i> ลืมรหัสผ่าน</h4>
                <p>
                    การรีเซ็ตรหัสผ่านขณะนี้ทำผ่านทีมงาน
                    กรุณาติดต่อตามช่องทางด้านล่างพร้อมแจ้ง email ที่ใช้ login —
                    ทีมงานจะตั้งรหัสชั่วคราวให้และส่งกลับให้คุณ
                </p>

                <h6 class="mt-4 mb-2"><i class="bi bi-headset"></i> @Model.OperatorName</h6>

                <div class="list-group list-group-flush">
                    @if (!string.IsNullOrWhiteSpace(Model.OperatorPhone))
                    {
                        <a href="tel:@Model.OperatorPhone" class="list-group-item list-group-item-action">
                            <i class="bi bi-telephone-fill text-success me-2"></i>
                            @Model.OperatorPhone
                            <small class="text-muted ms-2">แตะเพื่อโทร</small>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OperatorLine))
                    {
                        <a href="https://line.me/R/ti/p/@Model.OperatorLine" target="_blank" rel="noopener"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-chat-dots-fill text-success me-2"></i>
                            LINE: @Model.OperatorLine
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OperatorEmail))
                    {
                        <a href="mailto:@Model.OperatorEmail?subject=ขอรีเซ็ตรหัสผ่าน SolarApp"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-envelope-fill text-primary me-2"></i>
                            @Model.OperatorEmail
                        </a>
                    }
                    @if (string.IsNullOrWhiteSpace(Model.OperatorPhone)
                         && string.IsNullOrWhiteSpace(Model.OperatorLine)
                         && string.IsNullOrWhiteSpace(Model.OperatorEmail))
                    {
                        <div class="list-group-item text-muted">
                            <i class="bi bi-exclamation-triangle"></i>
                            ยังไม่ได้ตั้งช่องทางติดต่อทีมงาน — กรุณาตั้งใน <code>appsettings.json</code> → <code>MySolar</code> section
                        </div>
                    }
                </div>

                <hr />

                <details class="small">
                    <summary class="text-muted">หรือลองวิธีอื่น</summary>
                    <ul class="mt-2 text-muted">
                        <li>ถ้ามีบัญชี LINE / Microsoft ผูกไว้ ใช้ปุ่ม "Sign in with LINE/Microsoft" บนหน้า login แทน</li>
                        <li>ถ้าจำ email ไม่ได้ — ทีมงานสามารถค้นหาบัญชีของคุณได้จากเบอร์โทรหรือชื่อ</li>
                    </ul>
                </details>

                <div class="mt-3">
                    <a asp-page="/Account/Login" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> กลับไปหน้า Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
