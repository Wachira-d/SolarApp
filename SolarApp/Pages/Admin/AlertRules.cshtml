@page
@model SolarApp.Pages.Admin.AlertRulesModel
@using SolarApp.Models
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "กฎแจ้งเตือน";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-shield-exclamation"></i> กฎแจ้งเตือน</h4>
        <small class="text-muted">ตั้งเงื่อนไขให้ระบบแจ้งเตือนอัตโนมัติ</small>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="RunNow">
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-play-fill"></i> ตรวจสอบเดี๋ยวนี้
            </button>
        </form>
        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-circle"></i> เพิ่มกฎใหม่
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-permanent">@Model.ErrorMessage</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ชื่อกฎ</th>
                        <th>เงื่อนไข</th>
                        <th>ขอบเขต</th>
                        <th>ระดับความรุนแรง</th>
                        <th>แจ้งเตือนล่าสุด</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rules.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">
                            ยังไม่มีกฎแจ้งเตือน — กด "เพิ่มกฎใหม่" เพื่อสร้างกฎแรก
                        </td></tr>
                    }
                    @foreach (var r in Model.Rules)
                    {
                        var opStr = r.Operator switch
                        {
                            AlertRuleOperator.LessThan => "<",
                            AlertRuleOperator.LessThanOrEqual => "≤",
                            AlertRuleOperator.GreaterThan => ">",
                            AlertRuleOperator.GreaterThanOrEqual => "≥",
                            _ => "="
                        };
                        <tr class="@(r.IsEnabled ? "" : "text-muted")">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (r.IsEnabled)
                                    { <span class="badge bg-success">ON</span> }
                                    else
                                    { <span class="badge bg-secondary">OFF</span> }
                                    <div>
                                        <strong>@r.Name</strong>
                                        @if (!string.IsNullOrEmpty(r.Description))
                                        { <div class="small text-muted">@r.Description</div> }
                                    </div>
                                </div>
                            </td>
                            <td><code>@r.Metric @opStr @r.Threshold</code></td>
                            <td>
                                @if (r.Installation != null)
                                { <span>@r.Installation.SiteName</span> }
                                else if (r.BrandScope != null)
                                { <span class="badge bg-info">@r.BrandScope</span> }
                                else
                                { <span class="badge bg-secondary">ทุกไซต์</span> }
                            </td>
                            <td>
                                <span class="badge bg-@(r.Severity == AlertSeverity.Critical ? "danger" : r.Severity == AlertSeverity.High ? "warning text-dark" : "secondary")">
                                    @r.Severity
                                </span>
                            </td>
                            <td><small class="text-muted">@(r.LastFiredAt?.ToString("dd/MM HH:mm") ?? "-")</small></td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Toggle" asp-route-ruleId="@r.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="เปิด/ปิดกฎ">
                                        <i class="bi bi-power"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-ruleId="@r.Id" class="d-inline"
                                      onsubmit="return confirm('ลบกฎนี้?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">เพิ่มกฎแจ้งเตือนใหม่</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">ชื่อกฎ *</label>
                        <input asp-for="Input.Name" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">คำอธิบาย</label>
                        <input asp-for="Input.Description" class="form-control" maxlength="300" />
                    </div>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">ค่าที่ตรวจสอบ</label>
                            <select asp-for="Input.Metric" class="form-select" asp-items="Html.GetEnumSelectList<AlertRuleMetric>()"></select>
                        </div>
                        <div class="col-5">
                            <label class="form-label">เงื่อนไขเปรียบเทียบ</label>
                            <select asp-for="Input.Operator" class="form-select" asp-items="Html.GetEnumSelectList<AlertRuleOperator>()"></select>
                        </div>
                        <div class="col-7">
                            <label class="form-label">ค่าเกณฑ์</label>
                            <input asp-for="Input.Threshold" type="number" step="any" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ระดับความรุนแรง</label>
                            <select asp-for="Input.Severity" class="form-select" asp-items="Html.GetEnumSelectList<AlertSeverity>()"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">ประเภทแจ้งเตือน</label>
                            <select asp-for="Input.AlertType" class="form-select" asp-items="Html.GetEnumSelectList<AlertType>()"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">เว้นระยะก่อนเตือนซ้ำ (นาที)</label>
                            <input asp-for="Input.CooldownMinutes" type="number" min="1" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ขอบเขต</label>
                            <select asp-for="Input.InstallationId" class="form-select">
                                <option value="">ทุกไซต์</option>
                                @foreach (var inst in Model.Installations)
                                {
                                    <option value="@inst.Id">@inst.SiteName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        หมายเหตุหน่วย: PerformanceRatioDaily ใช้ค่า 0-1 (0.7 = 70%) · UptimePercent7d ใช้ค่า 0-100 · OfflineMinutes ใช้หน่วยนาที
                    </small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-warning">สร้างกฎ</button>
                </div>
            </div>
        </form>
    </div>
</div>
