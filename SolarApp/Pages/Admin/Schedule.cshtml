@page
@model SolarApp.Pages.Admin.ScheduleModel
@{
    ViewData["Title"] = "ตารางงานเบื้องหลัง";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h4 class="mb-4">ตารางงานเบื้องหลัง</h4>

<!-- Recommended Settings Info -->
<div class="alert alert-info">
    <h6><i class="bi bi-lightbulb"></i> ค่าที่แนะนำ</h6>
    <p class="mb-2">ระบบแนะนำให้ใช้ค่า default เหล่านี้ (เหมาะสมกับ API rate limits ของทุกแบรนด์):</p>
    <ul class="mb-2">
        <li><strong>Data Sync: ทุก 15 นาที</strong> (96 ครั้ง/วัน/installation) -- ปลอดภัยกับทุก API</li>
        <li><strong>Health Monitor: ทุก 5 นาที</strong> -- ไม่เรียก cloud API (เช็คจาก local DB เท่านั้น)</li>
    </ul>
    <p class="small mb-0 text-muted">
        เหตุผล: FOX ESS จำกัด 1,440 ครั้ง/วัน/device | Huawei strict ~1 req/min | Solis แนะนำ batch read
    </p>
</div>

<div class="row">
    <!-- Schedule Configuration -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0">ตั้งค่าตารางงาน</h6></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Save">
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-cloud-download text-primary"></i> ดึงข้อมูลจากคลาวด์ผู้ผลิต
                        </label>
                        <input asp-for="DataSyncCron" class="form-control font-monospace" />
                        <small class="text-muted">
                            Cron expression (5 ช่อง: นาที ชั่วโมง วันที่ เดือน วันในสัปดาห์)
                        </small>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="DataSyncCron" data-val="*/5 * * * *">ทุก 5 นาที (หนัก)</button>
                            <button type="button" class="btn btn-sm btn-outline-primary cron-preset"
                                    data-target="DataSyncCron" data-val="*/15 * * * *">ทุก 15 นาที (แนะนำ)</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="DataSyncCron" data-val="*/30 * * * *">ทุก 30 นาที</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="DataSyncCron" data-val="0 * * * *">ทุก 1 ชั่วโมง</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-heart-pulse text-danger"></i> ตรวจสอบสุขภาพระบบ
                        </label>
                        <input asp-for="HealthMonitorCron" class="form-control font-monospace" />
                        <small class="text-muted">
                            ตรวจ offline, warranty ใกล้หมด, cleaning ครบกำหนด (ไม่เรียก cloud API)
                        </small>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="HealthMonitorCron" data-val="*/2 * * * *">ทุก 2 นาที</button>
                            <button type="button" class="btn btn-sm btn-outline-primary cron-preset"
                                    data-target="HealthMonitorCron" data-val="*/5 * * * *">ทุก 5 นาที (แนะนำ)</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="HealthMonitorCron" data-val="*/10 * * * *">ทุก 10 นาที</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="HealthMonitorCron" data-val="*/30 * * * *">ทุก 30 นาที</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-bell text-warning"></i> เตือนใบสั่งงาน (แจ้ง LINE ถึงช่าง/ลูกค้า)
                        </label>
                        <input asp-for="WorkOrderRemindersCron" class="form-control font-monospace" />
                        <small class="text-muted">
                            ส่ง LINE แจ้งงานที่ใกล้ถึงกำหนด (≤36 ชม.) และเตือนงานที่เลยกำหนด (ทุก 23 ชม.)
                        </small>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="WorkOrderRemindersCron" data-val="*/15 * * * *">ทุก 15 นาที</button>
                            <button type="button" class="btn btn-sm btn-outline-primary cron-preset"
                                    data-target="WorkOrderRemindersCron" data-val="*/30 * * * *">ทุก 30 นาที (แนะนำ)</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="WorkOrderRemindersCron" data-val="0 * * * *">ทุกชั่วโมง</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cron-preset"
                                    data-target="WorkOrderRemindersCron" data-val="0 7,17 * * *">07:00 + 17:00</button>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> บันทึกตารางงาน
                        </button>
                        <button type="submit" asp-page-handler="ApplyRecommended" class="btn btn-outline-primary">
                            <i class="bi bi-magic"></i> ใช้ค่าที่แนะนำ
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Cron Guide -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0">คู่มือ Cron Expression</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>รูปแบบ</th><th>ความหมาย</th></tr>
                        </thead>
                        <tbody>
                            <tr><td class="font-monospace">* * * * *</td><td>ทุกนาที</td></tr>
                            <tr><td class="font-monospace">*/5 * * * *</td><td>ทุก 5 นาที</td></tr>
                            <tr><td class="font-monospace">*/15 * * * *</td><td>ทุก 15 นาที</td></tr>
                            <tr><td class="font-monospace">0 * * * *</td><td>ทุกชั่วโมง นาทีที่ 0</td></tr>
                            <tr><td class="font-monospace">0 */2 * * *</td><td>ทุก 2 ชั่วโมง</td></tr>
                            <tr><td class="font-monospace">0 7 * * *</td><td>ทุกวัน 07:00 น.</td></tr>
                            <tr><td class="font-monospace">0 0 * * 0</td><td>ทุกวันอาทิตย์ เที่ยงคืน</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2 mb-0">
                    ฟอร์แมต: <code>นาที(0-59) ชั่วโมง(0-23) วันที่(1-31) เดือน(1-12) วันในสัปดาห์(0-6, 0=อาทิตย์)</code>
                </p>
            </div>
        </div>
    </div>

    <!-- Current Job Status -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">งานที่ตั้งไว้ตอนนี้</h6>
                <a href="/hangfire" target="_blank" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-gear"></i> หน้า Hangfire
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.Jobs.Any())
                {
                    @foreach (var j in Model.Jobs)
                    {
                        <div class="border-bottom p-3">
                            <div class="d-flex justify-content-between">
                                <strong>@j.Id</strong>
                                <span class="badge bg-@(j.LastJobState == "Succeeded" ? "success" : j.LastJobState == "Failed" ? "danger" : "secondary")">
                                    @(j.LastJobState ?? "ไม่ทราบสถานะ")
                                </span>
                            </div>
                            <div class="small text-muted mt-1">
                                <div><strong>ตารางเวลา:</strong> <code>@j.Cron</code></div>
                                <div><strong>รันล่าสุด:</strong> @(j.LastExecution?.ToString("dd/MM HH:mm:ss") ?? "ยังไม่เคยรัน")</div>
                                <div><strong>รันครั้งถัดไป:</strong> @(j.NextExecution?.ToString("dd/MM HH:mm:ss") ?? "ยังไม่ได้ตั้งเวลา")</div>
                            </div>
                            <form method="post" asp-page-handler="RunNow" class="mt-2">
                                <input type="hidden" name="jobId" value="@j.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-play-fill"></i> รันเดี๋ยวนี้
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <div class="p-3 text-center text-muted">
                        ยังไม่มีงานลงทะเบียน (Hangfire อาจกำลังเริ่มทำงาน)
                    </div>
                }
            </div>
        </div>

        <!-- What the jobs do -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">แต่ละงานทำอะไรบ้าง</h6></div>
            <div class="card-body small">
                <p class="mb-2"><strong><i class="bi bi-cloud-download text-primary"></i> sync-production-data</strong></p>
                <ul class="mb-3">
                    <li>วนดูไซต์งานที่เปิดใช้งานทั้งหมด</li>
                    <li>เรียก cloud API: กำลังไฟเรียลไทม์ พลังงาน และ SOC แบตเตอรี่</li>
                    <li>บันทึกลงตาราง <code>EnergyData</code></li>
                    <li>อัปเดต <code>LastOnlineAt</code> และสถานะไซต์</li>
                    <li>บันทึกทุกการเรียก API ลง <code>InverterApiLogs</code></li>
                </ul>
                <p class="mb-2"><strong><i class="bi bi-heart-pulse text-danger"></i> check-system-health</strong></p>
                <ul class="mb-3">
                    <li>ตรวจไซต์ที่ออฟไลน์เกินเกณฑ์ → สร้างการแจ้งเตือน</li>
                    <li>ตรวจไซต์ที่ครบกำหนดล้างแผง → สร้างการแจ้งเตือน</li>
                    <li>ตรวจประกันที่จะหมดใน 90 วัน → สร้างการแจ้งเตือน</li>
                    <li>ส่งแจ้งเตือนใหม่เข้า LINE</li>
                    <li>ปิดการแจ้งเตือนอัตโนมัติเมื่อระบบกลับมาออนไลน์</li>
                </ul>
                <p class="mb-2"><strong><i class="bi bi-bell text-warning"></i> workorder-reminders</strong></p>
                <ul class="mb-0">
                    <li>หา WO ที่กำหนดภายใน 36 ชม. ข้างหน้า → ส่ง LINE ครั้งเดียว</li>
                    <li>หา WO เลยกำหนด (ยังไม่ Completed) → ส่ง LINE ทุก 23 ชม. จนกว่าจะอัพเดต</li>
                    <li>ส่งถึง: ช่างที่ assigned, ลูกค้า, LINE Alert Group (ถ้าตั้งไว้)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.cron-preset').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = document.querySelector('[name="' + btn.dataset.target + '"]');
                if (target) target.value = btn.dataset.val;
            });
        });
    </script>
}
