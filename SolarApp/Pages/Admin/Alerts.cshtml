@page
@model SolarApp.Pages.Admin.AlertsModel
@{
    ViewData["Title"] = "All Alerts";
}

<h4 class="mb-3">System Alerts</h4>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Severity</th>
                    <th>Type</th>
                    <th>Site</th>
                    <th>Title</th>
                    <th>Root Cause Analysis</th>
                    <th>Time</th>
                    <th>Notified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in Model.ActiveAlerts)
                {
                    var severityClass = alert.Severity switch
                    {
                        SolarApp.Models.Enums.AlertSeverity.Critical => "bg-danger",
                        SolarApp.Models.Enums.AlertSeverity.High => "bg-warning text-dark",
                        SolarApp.Models.Enums.AlertSeverity.Medium => "bg-info",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><span class="badge @severityClass">@alert.Severity</span></td>
                        <td>@alert.AlertType</td>
                        <td>@alert.Installation.SiteName</td>
                        <td>@alert.Title</td>
                        <td><small>@(alert.RootCauseAnalysis ?? "-")</small></td>
                        <td>@alert.OccurredAt.ToString("dd/MM HH:mm")</td>
                        <td>
                            @if (alert.IsNotified)
                            {
                                <i class="bi bi-check-circle text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-clock text-muted"></i>
                            }
                        </td>
                        <td>
                            @if (alert.AcknowledgedAt == null)
                            {
                                <form method="post" asp-page-handler="Acknowledge" class="d-inline">
                                    <input type="hidden" name="alertId" value="@alert.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">ACK</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Resolve" class="d-inline">
                                <input type="hidden" name="alertId" value="@alert.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Resolve</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.ActiveAlerts.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No active alerts</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
