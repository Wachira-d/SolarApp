@page
@model SolarApp.Pages.Admin.ConnectionHealthModel
@{
    ViewData["Title"] = "สุขภาพการเชื่อมต่อ API";
    string RateClass(double r) => r >= 98 ? "text-success" : r >= 90 ? "text-warning" : "text-danger";
    string RateBg(double r) => r >= 98 ? "bg-success" : r >= 90 ? "bg-warning" : "bg-danger";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-activity"></i> สุขภาพการเชื่อมต่อ API</h4>
        <small class="text-muted">อัตราสำเร็จของการเรียก cloud แต่ละแบรนด์/ไซต์ ใน @Model.WindowHours ชั่วโมงล่าสุด</small>
    </div>
    <div class="btn-group btn-group-sm" role="group">
        <a asp-page="ConnectionHealth" asp-route-hours="24" class="btn btn-outline-secondary @(Model.WindowHours==24?"active":"")">24 ชม.</a>
        <a asp-page="ConnectionHealth" asp-route-hours="168" class="btn btn-outline-secondary @(Model.WindowHours==168?"active":"")">7 วัน</a>
        <a asp-page="ConnectionHealth" asp-route-hours="720" class="btn btn-outline-secondary @(Model.WindowHours==720?"active":"")">30 วัน</a>
    </div>
</div>

@if (Model.TotalCalls == 0)
{
    <div class="alert alert-info">ยังไม่มี log การเรียก API ในช่วงเวลานี้.</div>
}
else
{
    <!-- Overall + per-brand -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                <div class="text-muted small">อัตราสำเร็จรวม</div>
                <div class="display-6 fw-bold @RateClass(Model.OverallRate)">@Model.OverallRate.ToString("0.0")%</div>
                <small class="text-muted">@Model.TotalSuccess / @Model.TotalCalls ครั้ง</small>
            </div></div>
        </div>
        @foreach (var b in Model.Brands)
        {
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fw-semibold">@b.Provider</span>
                        <span class="fw-bold @RateClass(b.Rate)">@b.Rate.ToString("0.0")%</span>
                    </div>
                    <div class="progress mt-2" style="height:6px">
                        <div class="progress-bar @RateBg(b.Rate)" style="width:@b.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <small class="text-muted d-block mt-1">@b.Total ครั้ง · ล้มเหลว @b.Failed</small>
                </div></div>
            </div>
        }
    </div>

    <!-- Per-site (worst first) -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><strong>ไซต์ที่ควรดู (เรียงตามอัตราสำเร็จต่ำสุด)</strong></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ไซต์</th><th>แบรนด์</th><th class="text-end">เรียก</th>
                        <th class="text-end">สำเร็จ</th><th style="width:160px">อัตราสำเร็จ</th><th>ล้มเหลวล่าสุด</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Sites)
                    {
                        <tr>
                            <td>@s.SiteName</td>
                            <td><span class="badge bg-secondary">@s.Brand</span></td>
                            <td class="text-end">@s.Total</td>
                            <td class="text-end">@s.Success</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:6px">
                                        <div class="progress-bar @RateBg(s.Rate)" style="width:@s.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                    <span class="small fw-semibold @RateClass(s.Rate)" style="width:46px">@s.Rate.ToString("0.0")%</span>
                                </div>
                            </td>
                            <td class="small text-muted">@(s.LastFail?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <a asp-page="/Installations/Diagnostics" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning">ตรวจ</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2">แสดงสูงสุด 100 ไซต์ · อัตราสำเร็จ &lt; 90% = แดง, 90-98% = เหลือง</p>
}
