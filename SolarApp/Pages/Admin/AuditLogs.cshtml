@page
@model SolarApp.Pages.Admin.AuditLogsModel
@{
    ViewData["Title"] = "บันทึกการใช้งาน";
}

<h4 class="mb-3">บันทึกการใช้งาน</h4>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>เวลา</th>
                        <th>ผู้ใช้</th>
                        <th>การกระทำ</th>
                        <th>รายการ</th>
                        <th>รหัสรายการ</th>
                        <th>IP</th>
                        <th>ข้อมูลที่เปลี่ยน</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        var actionClass = log.Action switch
                        {
                            "Create" => "text-success",
                            "Update" => "text-warning",
                            "Delete" => "text-danger",
                            _ => ""
                        };
                        <tr>
                            <td><small>@log.Timestamp.ToString("dd/MM HH:mm:ss")</small></td>
                            <td><small>@(log.UserName ?? "-")</small></td>
                            <td><span class="@actionClass fw-bold">@log.Action</span></td>
                            <td>@log.EntityType</td>
                            <td>@(log.EntityId ?? "-")</td>
                            <td><small>@(log.IpAddress ?? "-")</small></td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.NewValues))
                                {
                                    <button class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="popover"
                                            data-bs-content="@log.NewValues"
                                            data-bs-trigger="hover">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Logs.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">ยังไม่มีบันทึกการใช้งาน</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
        popoverTriggerList.map(function (el) { return new bootstrap.Popover(el); });
    </script>
}
