<!-- Edit Customer -->
<div class="modal fade" id="editCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditCustomer">
                <input type="hidden" asp-for="EditCustomer.Id" id="editCustId" />
                <div class="modal-header"><h5 class="modal-title">แก้ไขข้อมูลลูกค้า</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-2"><label class="form-label">ชื่อ *</label><input asp-for="EditCustomer.FirstName" id="editCustFirst" class="form-control" required /></div>
                        <div class="col-6 mb-2"><label class="form-label">นามสกุล *</label><input asp-for="EditCustomer.LastName" id="editCustLast" class="form-control" required /></div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2"><label class="form-label">อีเมล</label><input asp-for="EditCustomer.Email" id="editCustEmail" class="form-control" type="email" /></div>
                        <div class="col-6 mb-2"><label class="form-label">โทรศัพท์ *</label><input asp-for="EditCustomer.Phone" id="editCustPhone" class="form-control" required /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">LINE User ID</label><input asp-for="EditCustomer.LineUserId" id="editCustLine" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">ที่อยู่ *</label><input asp-for="EditCustomer.Address" id="editCustAddress" class="form-control" required /></div>
                    <div class="row">
                        <div class="col-4 mb-2"><label class="form-label">อำเภอ/เขต</label><input asp-for="EditCustomer.City" id="editCustCity" class="form-control" /></div>
                        <div class="col-4 mb-2"><label class="form-label">จังหวัด</label><input asp-for="EditCustomer.Province" id="editCustProvince" class="form-control" /></div>
                        <div class="col-4 mb-2"><label class="form-label">รหัสไปรษณีย์</label><input asp-for="EditCustomer.PostalCode" id="editCustPostal" class="form-control" /></div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2"><label class="form-label">เลขผู้เสียภาษี</label><input asp-for="EditCustomer.TaxId" id="editCustTaxId" class="form-control" /></div>
                        <div class="col-6 mb-2"><label class="form-label">ผูกกับบัญชีเข้าระบบ</label>
                            <select asp-for="EditCustomer.UserId" id="editCustUserId" class="form-select">
                                <option value="">-- ไม่ระบุ --</option>
                                @foreach (var u in Model.Users.Where(x => x.Role == "Customer"))
                                {
                                    <option value="@u.Id">@u.FullName (@u.Email)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-2"><label class="form-label">หมายเหตุ</label><textarea asp-for="EditCustomer.Notes" id="editCustNotes" class="form-control" rows="2"></textarea></div>
                    <div class="form-check"><input asp-for="EditCustomer.IsActive" id="editCustActive" class="form-check-input" /><label class="form-check-label">เปิดใช้งาน</label></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button><button type="submit" class="btn btn-primary">บันทึก</button></div>
            </form>

            @* ── Login account management (out of the Save-Customer form so a
                  password-set doesn't piggyback on a full customer-save) ────── *@
            <div class="border-top px-3 py-3 bg-light">
                <h6 class="mb-2"><i class="bi bi-key"></i> บัญชี Login ของลูกค้ารายนี้</h6>

                @* Linked: show email + buttons (visible only when row has UserId) *@
                <div id="editCustLoginLinked" style="display:none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> ผูกกับ account แล้ว</span>
                            <span class="ms-2 text-muted small" id="editCustLinkedEmail"></span>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="ResetPassword" class="row g-2 align-items-end"
                          onsubmit="return confirm('รีเซ็ตรหัสผ่านของลูกค้านี้?');">
                        <input type="hidden" name="PwReset.UserId" id="resetPwdUserId" />
                        <div class="col-md-7">
                            <label class="form-label small">รหัสผ่านใหม่ (อย่างน้อย 8 ตัวอักษร)</label>
                            <input type="text" name="PwReset.NewPassword" class="form-control form-control-sm"
                                   placeholder="ใส่รหัสที่ต้องการ" minlength="8" required />
                        </div>
                        <div class="col-md-5">
                            <button type="submit" class="btn btn-sm btn-warning w-100">
                                <i class="bi bi-arrow-clockwise"></i> รีเซ็ตรหัสผ่าน
                            </button>
                        </div>
                    </form>
                    <small class="text-muted d-block mt-1">
                        รหัสใหม่จะแสดงในข้อความผลลัพธ์ — แจ้งลูกค้าและให้เปลี่ยนเองในหน้าจัดการบัญชี
                    </small>
                </div>

                @* Has email, not linked: show "create account" with optional pwd *@
                <div id="editCustLoginCreate" style="display:none">
                    <div class="alert alert-info py-2 small mb-2">
                        <i class="bi bi-info-circle"></i>
                        ลูกค้ารายนี้ยังไม่มี account ใช้ login — สร้างให้ได้ทันที
                    </div>
                    <form method="post" asp-page-handler="InviteCustomer" class="row g-2 align-items-end"
                          onsubmit="return confirm('สร้าง login account ให้ลูกค้านี้?');">
                        <input type="hidden" name="customerId" id="inviteCustId" />
                        <div class="col-md-7">
                            <label class="form-label small">รหัสผ่านตั้งต้น (เว้นว่าง = auto-generate)</label>
                            <input type="text" name="password" class="form-control form-control-sm"
                                   placeholder="ขั้นต่ำ 8 ตัวอักษร" minlength="8" />
                        </div>
                        <div class="col-md-5">
                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <i class="bi bi-person-plus"></i> สร้างบัญชีเข้าระบบ
                            </button>
                        </div>
                    </form>
                </div>

                @* No email: warn *@
                <div id="editCustLoginNoEmail" class="alert alert-warning py-2 small mb-0" style="display:none">
                    <i class="bi bi-exclamation-triangle"></i>
                    ต้องกรอก <strong>อีเมล</strong> ให้ลูกค้าก่อน จึงจะสร้างบัญชีเข้าระบบได้
                    (อีเมลใช้เป็นชื่อผู้ใช้สำหรับเข้าระบบ)
                </div>
            </div>
        </div>
    </div>
</div>

