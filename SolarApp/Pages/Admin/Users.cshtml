@page
@model SolarApp.Pages.Admin.UsersModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "User Management";
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#users">Users</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#customers">Customers (@Model.CustomerList.Count)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#partners">Partners (@Model.PartnerList.Count)</a>
    </li>
</ul>

<div class="tab-content">
    <!-- Users Tab -->
    <div class="tab-pane fade show active" id="users">
        <div class="d-flex justify-content-between mb-3">
            <h5>System Users</h5>
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-person-plus"></i> Add User
            </button>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Email</th><th>Company</th><th>Role</th><th>Status</th><th>Created</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var roleClass = u.Role switch { "Admin" => "bg-danger", "Partner" => "bg-primary", "Customer" => "bg-success", _ => "bg-secondary" };
                            <tr>
                                <td><strong>@u.FullName</strong></td>
                                <td>@u.Email</td>
                                <td>@(u.CompanyName ?? "-")</td>
                                <td><span class="badge @roleClass">@u.Role</span></td>
                                <td><span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                                <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Customers Tab -->
    <div class="tab-pane fade" id="customers">
        <div class="d-flex justify-content-between mb-3">
            <h5>Customers</h5>
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createCustomerModal">
                <i class="bi bi-person-plus"></i> Add Customer
            </button>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>LINE</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.CustomerList)
                        {
                            <tr>
                                <td><strong>@c.FullName</strong></td>
                                <td>@(c.Email ?? "-")</td>
                                <td>@c.Phone</td>
                                <td><small>@c.Address, @c.City @c.Province</small></td>
                                <td>@(!string.IsNullOrEmpty(c.LineUserId) ? "Connected" : "-")</td>
                                <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span></td>
                            </tr>
                        }
                        @if (!Model.CustomerList.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No customers</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Partners Tab -->
    <div class="tab-pane fade" id="partners">
        <div class="d-flex justify-content-between mb-3">
            <h5>Partners</h5>
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createPartnerModal">
                <i class="bi bi-building-add"></i> Add Partner
            </button>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Company</th><th>Email</th><th>Phone</th><th>Commission</th><th>Tax ID</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PartnerList)
                        {
                            <tr>
                                <td><strong>@p.CompanyName</strong></td>
                                <td>@p.ContactEmail</td>
                                <td>@p.ContactPhone</td>
                                <td>@(p.CommissionRate?.ToString("N1") ?? "-")%</td>
                                <td>@(p.TaxId ?? "-")</td>
                                <td><span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                            </tr>
                        }
                        @if (!Model.PartnerList.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No partners</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-header"><h5 class="modal-title">Add User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Full Name *</label><input asp-for="NewUser.FullName" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Email *</label><input asp-for="NewUser.Email" class="form-control" type="email" required /></div>
                    <div class="mb-3"><label class="form-label">Password *</label><input asp-for="NewUser.Password" class="form-control" type="password" required /></div>
                    <div class="mb-3"><label class="form-label">Role *</label>
                        <select asp-for="NewUser.Role" class="form-select">
                            <option value="@UserRoles.Customer">Customer</option>
                            <option value="@UserRoles.Partner">Partner</option>
                            <option value="@UserRoles.Admin">Admin</option>
                        </select>
                    </div>
                    <div class="mb-3"><label class="form-label">Company</label><input asp-for="NewUser.CompanyName" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Phone</label><input asp-for="NewUser.Phone" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">LINE User ID</label><input asp-for="NewUser.LineUserId" class="form-control" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning">Create</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Create Customer Modal -->
<div class="modal fade" id="createCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateCustomer">
                <div class="modal-header"><h5 class="modal-title">Add Customer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-6"><label class="form-label">First Name *</label><input asp-for="NewCustomer.FirstName" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">Last Name *</label><input asp-for="NewCustomer.LastName" class="form-control" required /></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Email</label><input asp-for="NewCustomer.Email" class="form-control" type="email" /></div>
                    <div class="mb-3"><label class="form-label">Phone *</label><input asp-for="NewCustomer.Phone" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">LINE User ID</label><input asp-for="NewCustomer.LineUserId" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Address *</label><input asp-for="NewCustomer.Address" class="form-control" required /></div>
                    <div class="row mb-3">
                        <div class="col-4"><label class="form-label">City</label><input asp-for="NewCustomer.City" class="form-control" /></div>
                        <div class="col-4"><label class="form-label">Province</label><input asp-for="NewCustomer.Province" class="form-control" /></div>
                        <div class="col-4"><label class="form-label">Postal Code</label><input asp-for="NewCustomer.PostalCode" class="form-control" /></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Tax ID</label><input asp-for="NewCustomer.TaxId" class="form-control" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning">Create</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Create Partner Modal -->
<div class="modal fade" id="createPartnerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreatePartner">
                <div class="modal-header"><h5 class="modal-title">Add Partner</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Company Name *</label><input asp-for="NewPartner.CompanyName" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Contact Email *</label><input asp-for="NewPartner.ContactEmail" class="form-control" type="email" required /></div>
                    <div class="mb-3"><label class="form-label">Contact Phone *</label><input asp-for="NewPartner.ContactPhone" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Address</label><input asp-for="NewPartner.Address" class="form-control" /></div>
                    <div class="row mb-3">
                        <div class="col-6"><label class="form-label">City</label><input asp-for="NewPartner.City" class="form-control" /></div>
                        <div class="col-6"><label class="form-label">Province</label><input asp-for="NewPartner.Province" class="form-control" /></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6"><label class="form-label">Commission Rate (%)</label><input asp-for="NewPartner.CommissionRate" class="form-control" /></div>
                        <div class="col-6"><label class="form-label">Tax ID</label><input asp-for="NewPartner.TaxId" class="form-control" /></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning">Create</button></div>
            </form>
        </div>
    </div>
</div>
