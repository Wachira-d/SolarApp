@page
@model SolarApp.Pages.Admin.UsersModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "จัดการผู้ใช้";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#users">
            <i class="bi bi-person"></i> ผู้ใช้ระบบ (@Model.Users.Count)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#customers">
            <i class="bi bi-people"></i> ลูกค้า (@Model.CustomerList.Count)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#partners">
            <i class="bi bi-building"></i> พาร์ทเนอร์ (@Model.PartnerList.Count)
        </a>
    </li>
</ul>

<div class="tab-content">
    <!-- ───── USERS TAB ───── -->
    <div class="tab-pane fade show active" id="users">
        <div class="d-flex justify-content-between mb-3">
            <h5>ผู้ใช้ระบบ</h5>
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-person-plus"></i> เพิ่มผู้ใช้
            </button>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ชื่อ</th>
                                <th>อีเมล</th>
                                <th>โทรศัพท์</th>
                                <th>บทบาท</th>
                                <th>พาร์ทเนอร์</th>
                                <th>สถานะ</th>
                                <th>เข้าระบบล่าสุด</th>
                                <th class="text-end">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.Users)
                            {
                                var roleClass = u.Role switch { "Admin" => "bg-danger", "Partner" => "bg-primary", "Customer" => "bg-success", _ => "bg-secondary" };
                                <tr>
                                    <td><strong>@u.FullName</strong></td>
                                    <td>@u.Email</td>
                                    <td>@(u.PhoneNumber ?? "-")</td>
                                    <td><span class="badge @roleClass">@u.Role</span></td>
                                    <td>@(u.PartnerName ?? "-")</td>
                                    <td>
                                        <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                            @(u.IsActive ? "ใช้งาน" : "ปิดใช้งาน")
                                        </span>
                                    </td>
                                    <td><small>@(SolarApp.Services.SiteTime.ToSiteTime(u.LastLoginAt)?.ToString("dd/MM HH:mm") ?? "-")</small></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary edit-user-btn" type="button"
                                                    data-id="@u.Id" data-fullname="@u.FullName" data-email="@u.Email"
                                                    data-phone="@u.PhoneNumber" data-company="@u.CompanyName"
                                                    data-line="@u.LineUserId" data-role="@u.Role"
                                                    data-partner="@u.PartnerId" data-active="@u.IsActive.ToString().ToLower()"
                                                    data-bs-toggle="modal" data-bs-target="#editUserModal">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-warning reset-pw-btn" type="button"
                                                    data-id="@u.Id" data-email="@u.Email"
                                                    data-bs-toggle="modal" data-bs-target="#resetPwModal" title="รีเซ็ตรหัสผ่าน">
                                                <i class="bi bi-key"></i>
                                            </button>
                                            <form method="post" asp-page-handler="ToggleUserActive" class="d-inline">
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <button type="submit" class="btn btn-outline-secondary" title="@(u.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")">
                                                    <i class="bi bi-@(u.IsActive ? "lock" : "unlock")"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="DeleteUser" class="d-inline"
                                                  onsubmit="return confirm('ลบผู้ใช้ @u.Email?');">
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <button type="submit" class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ───── CUSTOMERS TAB ───── -->
    <div class="tab-pane fade" id="customers">
        <div class="d-flex justify-content-between mb-3">
            <h5>ลูกค้า</h5>
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createCustomerModal">
                <i class="bi bi-person-plus"></i> เพิ่มลูกค้า
            </button>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ชื่อ</th>
                                <th>อีเมล</th>
                                <th>โทรศัพท์</th>
                                <th>ที่อยู่</th>
                                <th>LINE</th>
                                <th>ไซต์</th>
                                <th>สถานะ</th>
                                <th class="text-end">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.CustomerList)
                            {
                                <tr>
                                    <td><strong>@c.FullName</strong></td>
                                    <td>@(c.Email ?? "-")</td>
                                    <td>@c.Phone</td>
                                    <td><small>@c.Address @(string.IsNullOrEmpty(c.City) ? "" : ", " + c.City)</small></td>
                                    <td>@(string.IsNullOrEmpty(c.LineUserId) ? "-" : "ผูกแล้ว")</td>
                                    <td><span class="badge bg-info">@c.Installations.Count</span></td>
                                    <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</span></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary edit-customer-btn" type="button"
                                                    data-id="@c.Id" data-firstname="@c.FirstName" data-lastname="@c.LastName"
                                                    data-email="@c.Email" data-phone="@c.Phone" data-line="@c.LineUserId"
                                                    data-address="@c.Address" data-city="@c.City" data-province="@c.Province"
                                                    data-postal="@c.PostalCode" data-taxid="@c.TaxId" data-userid="@c.UserId"
                                                    data-active="@c.IsActive.ToString().ToLower()" data-notes="@c.Notes"
                                                    data-bs-toggle="modal" data-bs-target="#editCustomerModal">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (string.IsNullOrEmpty(c.UserId) && !string.IsNullOrEmpty(c.Email))
                                            {
                                                <form method="post" asp-page-handler="InviteCustomer" class="d-inline"
                                                      onsubmit="return confirm('สร้างบัญชีเข้าระบบให้ @c.FullName (@c.Email)?');">
                                                    <input type="hidden" name="customerId" value="@c.Id" />
                                                    <button type="submit" class="btn btn-outline-success" title="สร้างบัญชีเข้าระบบ">
                                                        <i class="bi bi-person-plus"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (!string.IsNullOrEmpty(c.UserId))
                                            {
                                                <button type="button" class="btn btn-outline-secondary" disabled title="ผูกบัญชีเข้าระบบแล้ว">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            }
                                            <form method="post" asp-page-handler="DeleteCustomer" class="d-inline"
                                                  onsubmit="return confirm('ลบลูกค้า @c.FullName?');">
                                                <input type="hidden" name="customerId" value="@c.Id" />
                                                <button type="submit" class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.CustomerList.Any())
                            {
                                <tr><td colspan="8" class="text-center text-muted py-3">ยังไม่มีลูกค้า</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ───── PARTNERS TAB ───── -->
    <div class="tab-pane fade" id="partners">
        <div class="d-flex justify-content-between mb-3">
            <h5>พาร์ทเนอร์</h5>
            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createPartnerModal">
                <i class="bi bi-building-add"></i> เพิ่มพาร์ทเนอร์
            </button>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>บริษัท</th>
                                <th>อีเมล</th>
                                <th>โทรศัพท์</th>
                                <th>ค่าคอมมิชชั่น</th>
                                <th>ไซต์</th>
                                <th>สัญญาถึง</th>
                                <th>สถานะ</th>
                                <th class="text-end">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PartnerList)
                            {
                                <tr>
                                    <td><strong>@p.CompanyName</strong></td>
                                    <td>@p.ContactEmail</td>
                                    <td>@p.ContactPhone</td>
                                    <td>@(p.CommissionRate?.ToString("N1") ?? "-")%</td>
                                    <td><span class="badge bg-info">@p.Installations.Count</span></td>
                                    <td><small>@(p.ContractEndDate?.ToString("dd/MM/yyyy") ?? "-")</small></td>
                                    <td><span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</span></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary edit-partner-btn" type="button"
                                                    data-id="@p.Id" data-company="@p.CompanyName"
                                                    data-email="@p.ContactEmail" data-phone="@p.ContactPhone"
                                                    data-address="@p.Address" data-city="@p.City" data-province="@p.Province"
                                                    data-postal="@p.PostalCode" data-commission="@p.CommissionRate"
                                                    data-taxid="@p.TaxId" data-active="@p.IsActive.ToString().ToLower()"
                                                    data-contractstart="@p.ContractStartDate?.ToString("yyyy-MM-dd")"
                                                    data-contractend="@p.ContractEndDate?.ToString("yyyy-MM-dd")"
                                                    data-notes="@p.Notes"
                                                    data-bs-toggle="modal" data-bs-target="#editPartnerModal">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @{
                                                var hasPartnerUser = Model.Users.Any(u => u.PartnerId == p.Id);
                                            }
                                            @if (!hasPartnerUser && !string.IsNullOrEmpty(p.ContactEmail))
                                            {
                                                <form method="post" asp-page-handler="InvitePartner" class="d-inline"
                                                      onsubmit="return confirm('สร้างบัญชีเข้าระบบให้พาร์ทเนอร์ @p.CompanyName (@p.ContactEmail)?');">
                                                    <input type="hidden" name="partnerId" value="@p.Id" />
                                                    <button type="submit" class="btn btn-outline-success" title="สร้างบัญชีเข้าระบบ">
                                                        <i class="bi bi-person-plus"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (hasPartnerUser)
                                            {
                                                <button type="button" class="btn btn-outline-secondary" disabled title="มีผู้ใช้ในสังกัดแล้ว">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            }
                                            <form method="post" asp-page-handler="DeletePartner" class="d-inline"
                                                  onsubmit="return confirm('ลบพาร์ทเนอร์ @p.CompanyName?');">
                                                <input type="hidden" name="partnerId" value="@p.Id" />
                                                <button type="submit" class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.PartnerList.Any())
                            {
                                <tr><td colspan="8" class="text-center text-muted py-3">ยังไม่มีพาร์ทเนอร์</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════ MODALS ═══════════════════ -->

<!-- Create User -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-header"><h5 class="modal-title">เพิ่มผู้ใช้</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label">ชื่อ-นามสกุล *</label><input asp-for="NewUser.FullName" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">อีเมล *</label><input asp-for="NewUser.Email" class="form-control" type="email" required /></div>
                    <div class="mb-2"><label class="form-label">รหัสผ่าน *</label><input asp-for="NewUser.Password" class="form-control" type="password" required minlength="8" />
                        <small class="text-muted">อย่างน้อย 8 ตัวอักษร มีตัวพิมพ์ใหญ่ ตัวเลข และอักขระพิเศษ</small></div>
                    <div class="mb-2"><label class="form-label">บทบาท *</label>
                        <select asp-for="NewUser.Role" class="form-select" id="newUserRole">
                            <option value="@UserRoles.Customer">ลูกค้า</option>
                            <option value="@UserRoles.Partner">พาร์ทเนอร์</option>
                            <option value="@UserRoles.Admin">ผู้ดูแลระบบ</option>
                        </select>
                    </div>
                    <div class="mb-2 partner-select" style="display:none">
                        <label class="form-label">สังกัดพาร์ทเนอร์</label>
                        <select asp-for="NewUser.PartnerId" class="form-select">
                            <option value="">-- เลือกพาร์ทเนอร์ --</option>
                            @foreach (var p in Model.PartnerList)
                            {
                                <option value="@p.Id">@p.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label">โทรศัพท์</label><input asp-for="NewUser.Phone" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">LINE User ID</label><input asp-for="NewUser.LineUserId" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">บริษัท</label><input asp-for="NewUser.CompanyName" class="form-control" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button><button type="submit" class="btn btn-warning">สร้าง</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditUser">
                <input type="hidden" asp-for="EditUser.Id" id="editUserId" />
                <div class="modal-header"><h5 class="modal-title">แก้ไขผู้ใช้</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label">ชื่อ-นามสกุล *</label><input asp-for="EditUser.FullName" id="editFullName" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">อีเมล *</label><input asp-for="EditUser.Email" id="editEmail" class="form-control" type="email" required /></div>
                    <div class="mb-2"><label class="form-label">บทบาท *</label>
                        <select asp-for="EditUser.Role" id="editRole" class="form-select">
                            <option value="@UserRoles.Customer">ลูกค้า</option>
                            <option value="@UserRoles.Partner">พาร์ทเนอร์</option>
                            <option value="@UserRoles.Admin">ผู้ดูแลระบบ</option>
                        </select>
                    </div>
                    <div class="mb-2 partner-select-edit">
                        <label class="form-label">สังกัดพาร์ทเนอร์</label>
                        <select asp-for="EditUser.PartnerId" id="editPartnerId" class="form-select">
                            <option value="">-- ไม่ระบุ --</option>
                            @foreach (var p in Model.PartnerList)
                            {
                                <option value="@p.Id">@p.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label">โทรศัพท์</label><input asp-for="EditUser.Phone" id="editPhone" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">LINE User ID</label><input asp-for="EditUser.LineUserId" id="editLineUserId" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">บริษัท</label><input asp-for="EditUser.CompanyName" id="editCompany" class="form-control" /></div>
                    <div class="form-check"><input asp-for="EditUser.IsActive" id="editIsActive" class="form-check-input" /><label class="form-check-label">เปิดใช้งาน</label></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button><button type="submit" class="btn btn-primary">บันทึก</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password -->
<div class="modal fade" id="resetPwModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ResetPassword">
                <input type="hidden" asp-for="PwReset.UserId" id="resetUserId" />
                <div class="modal-header"><h5 class="modal-title">รีเซ็ตรหัสผ่าน</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p>รีเซ็ตรหัสผ่านของ <strong id="resetEmail"></strong></p>
                    <div class="mb-2">
                        <label class="form-label">รหัสผ่านใหม่ *</label>
                        <input asp-for="PwReset.NewPassword" class="form-control" type="password" required minlength="8" />
                        <small class="text-muted">อย่างน้อย 8 ตัวอักษร มีตัวพิมพ์ใหญ่ ตัวเลข และอักขระพิเศษ (เช่น Test@1234)</small>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button><button type="submit" class="btn btn-warning">รีเซ็ต</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Create Customer -->
<div class="modal fade" id="createCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateCustomer">
                <div class="modal-header"><h5 class="modal-title">เพิ่มลูกค้า</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-2"><label class="form-label">ชื่อ *</label><input asp-for="NewCustomer.FirstName" class="form-control" required /></div>
                        <div class="col-6 mb-2"><label class="form-label">นามสกุล *</label><input asp-for="NewCustomer.LastName" class="form-control" required /></div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2"><label class="form-label">อีเมล</label><input asp-for="NewCustomer.Email" class="form-control" type="email" /></div>
                        <div class="col-6 mb-2"><label class="form-label">โทรศัพท์ *</label><input asp-for="NewCustomer.Phone" class="form-control" required /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">LINE User ID</label><input asp-for="NewCustomer.LineUserId" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label">ที่อยู่ *</label><input asp-for="NewCustomer.Address" class="form-control" required /></div>
                    <div class="row">
                        <div class="col-4 mb-2"><label class="form-label">อำเภอ/เขต</label><input asp-for="NewCustomer.City" class="form-control" /></div>
                        <div class="col-4 mb-2"><label class="form-label">จังหวัด</label><input asp-for="NewCustomer.Province" class="form-control" /></div>
                        <div class="col-4 mb-2"><label class="form-label">รหัสไปรษณีย์</label><input asp-for="NewCustomer.PostalCode" class="form-control" /></div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2"><label class="form-label">เลขผู้เสียภาษี</label><input asp-for="NewCustomer.TaxId" class="form-control" /></div>
                        <div class="col-6 mb-2"><label class="form-label">ผูกกับบัญชีเข้าระบบ</label>
                            <select asp-for="NewCustomer.UserId" class="form-select">
                                <option value="">-- ไม่ระบุ --</option>
                                @foreach (var u in Model.Users.Where(x => x.Role == "Customer"))
                                {
                                    <option value="@u.Id">@u.FullName (@u.Email)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
