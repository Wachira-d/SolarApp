@section Scripts {
    <script>
        // Show/hide partner select based on role
        function togglePartnerSelect(roleSelect, partnerSelectClass) {
            const isPartner = roleSelect.value === 'Partner';
            document.querySelectorAll('.' + partnerSelectClass).forEach(el => {
                el.style.display = isPartner ? '' : 'none';
            });
        }

        const newRoleSelect = document.getElementById('newUserRole');
        if (newRoleSelect) {
            newRoleSelect.addEventListener('change', () => togglePartnerSelect(newRoleSelect, 'partner-select'));
        }

        // Edit User - populate modal
        document.querySelectorAll('.edit-user-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editUserId').value = btn.dataset.id;
                document.getElementById('editFullName').value = btn.dataset.fullname || '';
                document.getElementById('editEmail').value = btn.dataset.email || '';
                document.getElementById('editPhone').value = btn.dataset.phone || '';
                document.getElementById('editCompany').value = btn.dataset.company || '';
                document.getElementById('editLineUserId').value = btn.dataset.line || '';
                document.getElementById('editRole').value = btn.dataset.role || 'Customer';
                document.getElementById('editPartnerId').value = btn.dataset.partner || '';
                document.getElementById('editIsActive').checked = btn.dataset.active === 'true';
            });
        });

        // Reset Password - populate modal
        document.querySelectorAll('.reset-pw-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('resetUserId').value = btn.dataset.id;
                document.getElementById('resetEmail').textContent = btn.dataset.email;
            });
        });

        // Edit Customer - populate modal
        document.querySelectorAll('.edit-customer-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editCustId').value = btn.dataset.id;
                document.getElementById('editCustFirst').value = btn.dataset.firstname || '';
                document.getElementById('editCustLast').value = btn.dataset.lastname || '';
                document.getElementById('editCustEmail').value = btn.dataset.email || '';
                document.getElementById('editCustPhone').value = btn.dataset.phone || '';
                document.getElementById('editCustLine').value = btn.dataset.line || '';
                document.getElementById('editCustAddress').value = btn.dataset.address || '';
                document.getElementById('editCustCity').value = btn.dataset.city || '';
                document.getElementById('editCustProvince').value = btn.dataset.province || '';
                document.getElementById('editCustPostal').value = btn.dataset.postal || '';
                document.getElementById('editCustTaxId').value = btn.dataset.taxid || '';
                document.getElementById('editCustUserId').value = btn.dataset.userid || '';
                document.getElementById('editCustNotes').value = btn.dataset.notes || '';
                document.getElementById('editCustActive').checked = btn.dataset.active === 'true';

                // Login-account section: show the right state based on what the
                // customer already has (linked? has email? neither?)
                const linkedDiv  = document.getElementById('editCustLoginLinked');
                const createDiv  = document.getElementById('editCustLoginCreate');
                const noEmailDiv = document.getElementById('editCustLoginNoEmail');
                const linkedEmailSpan = document.getElementById('editCustLinkedEmail');
                const resetPwdUserIdInput = document.getElementById('resetPwdUserId');
                const inviteCustIdInput   = document.getElementById('inviteCustId');

                linkedDiv.style.display = 'none';
                createDiv.style.display = 'none';
                noEmailDiv.style.display = 'none';

                const userId = btn.dataset.userid || '';
                const email  = btn.dataset.email  || '';
                if (userId) {
                    linkedDiv.style.display = 'block';
                    resetPwdUserIdInput.value = userId;
                    linkedEmailSpan.textContent = email ? `(${email})` : '';
                } else if (email) {
                    createDiv.style.display = 'block';
                    inviteCustIdInput.value = btn.dataset.id;
                } else {
                    noEmailDiv.style.display = 'block';
                }
            });
        });

        // Edit Partner - populate modal
        document.querySelectorAll('.edit-partner-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editPartnerId').value = btn.dataset.id;
                document.getElementById('editPartnerCompany').value = btn.dataset.company || '';
                document.getElementById('editPartnerEmail').value = btn.dataset.email || '';
                document.getElementById('editPartnerPhone').value = btn.dataset.phone || '';
                document.getElementById('editPartnerAddress').value = btn.dataset.address || '';
                document.getElementById('editPartnerCity').value = btn.dataset.city || '';
                document.getElementById('editPartnerProvince').value = btn.dataset.province || '';
                document.getElementById('editPartnerPostal').value = btn.dataset.postal || '';
                document.getElementById('editPartnerTaxId').value = btn.dataset.taxid || '';
                document.getElementById('editPartnerCommission').value = btn.dataset.commission || '';
                document.getElementById('editPartnerStart').value = btn.dataset.contractstart || '';
                document.getElementById('editPartnerEnd').value = btn.dataset.contractend || '';
                document.getElementById('editPartnerNotes').value = btn.dataset.notes || '';
                document.getElementById('editPartnerActive').checked = btn.dataset.active === 'true';
            });
        });
    </script>
}
