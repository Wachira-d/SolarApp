@page
@model SolarApp.Pages.Admin.UsersModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between mb-3">
    <h4>User Management</h4>
    <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="bi bi-person-plus"></i> Add User
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    var roleClass = u.Role switch
                    {
                        "Admin" => "bg-danger",
                        "Partner" => "bg-primary",
                        "Customer" => "bg-success",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td>@u.Email</td>
                        <td>@(u.CompanyName ?? "-")</td>
                        <td><span class="badge @roleClass">@u.Role</span></td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Full Name *</label>
                        <input asp-for="NewUser.FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input asp-for="NewUser.Email" class="form-control" type="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password *</label>
                        <input asp-for="NewUser.Password" class="form-control" type="password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role *</label>
                        <select asp-for="NewUser.Role" class="form-select">
                            <option value="@UserRoles.Customer">Customer</option>
                            <option value="@UserRoles.Partner">Partner</option>
                            <option value="@UserRoles.Admin">Admin</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Company Name</label>
                        <input asp-for="NewUser.CompanyName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input asp-for="NewUser.Phone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">LINE User ID</label>
                        <input asp-for="NewUser.LineUserId" class="form-control"
                               placeholder="For LINE notifications" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>
