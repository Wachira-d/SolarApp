@page
@model SolarApp.Pages.Admin.WorkOrderTemplatesModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "ค่ามาตรฐานใบสั่งงาน";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-list-check"></i> ค่ามาตรฐานใบสั่งงาน</h4>
        <small class="text-muted">
            ตั้งค่าหัวข้องาน + รายการตรวจสอบเบื้องต้นของแต่ละประเภทงาน — ช่างจะเห็นเป็น default
            เมื่อสร้างใบสั่งงานใหม่ และยังสามารถปรับแก้ทีหลังได้
        </small>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    <strong>วิธีใช้:</strong> รายการตรวจสอบ — 1 ข้อต่อบรรทัด. กดบันทึกเพื่อปรับใช้ทันที.
    ช่างจะเห็นค่าเหล่านี้เป็นจุดเริ่มต้นในหน้า "สร้างใบสั่งงานใหม่" — ปรับแก้ได้ตามไซต์งานจริง.
</div>

<div class="row g-3">
    @foreach (var (type, tmpl) in Model.Templates.OrderBy(kv => (int)kv.Key))
    {
        var label = SolarApp.Pages.Admin.WorkOrderTemplatesModel.ThaiLabel(type);
        var itemCount = string.IsNullOrWhiteSpace(tmpl.ChecklistItems)
            ? 0
            : tmpl.ChecklistItems.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length;
        <div class="col-lg-6">
            <form method="post" asp-page-handler="Save" class="card border-0 shadow-sm h-100">
                <input type="hidden" name="type" value="@((int)type)" />
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">@label</h6>
                        <small class="text-muted">@itemCount รายการตรวจสอบ</small>
                    </div>
                    <span class="badge bg-secondary">Type @((int)type)</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">หัวข้องาน</label>
                        <input name="title" value="@tmpl.Title" class="form-control"
                               placeholder="เช่น ล้างแผงโซลาร์" maxlength="200" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">
                            รายการตรวจสอบ (Checklist)
                            <span class="text-muted">— 1 ข้อต่อบรรทัด</span>
                        </label>
                        <textarea name="checklist" class="form-control font-monospace"
                                  rows="12" style="font-size:0.9rem"
                                  placeholder="ใส่ 1 รายการต่อบรรทัด เช่น:&#10;ตรวจ DC isolator&#10;ปิด AC breaker&#10;ล้างแผงทุกแถว">@tmpl.ChecklistItems</textarea>
                    </div>
                    @if (tmpl.UpdatedAt > DateTime.MinValue && tmpl.Id > 0)
                    {
                        <small class="text-muted">
                            <i class="bi bi-clock-history"></i>
                            แก้ไขล่าสุด: @tmpl.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </small>
                    }
                </div>
                <div class="card-footer bg-white d-flex justify-content-between gap-2">
                    <button type="submit" asp-page-handler="Reset" class="btn btn-outline-secondary btn-sm"
                            onclick="return confirm('รีเซ็ตค่ามาตรฐานของ \'@label\' กลับเป็นค่าตั้งต้นใช่หรือไม่?')">
                        <i class="bi bi-arrow-counterclockwise"></i> รีเซ็ต
                    </button>
                    <button type="submit" class="btn btn-warning btn-sm">
                        <i class="bi bi-save"></i> บันทึก
                    </button>
                </div>
            </form>
        </div>
    }
</div>
