@page
@model SolarApp.Pages.Admin.LineSettingsModel
@{
    ViewData["Title"] = "LINE Messaging Settings";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.TestResult))
{
    <div class="alert alert-@(Model.TestSuccess ? "success" : "danger") alert-dismissible fade show">
        <i class="bi bi-@(Model.TestSuccess ? "check-circle-fill" : "x-circle-fill")"></i>
        <strong>Test Result:</strong> @Model.TestResult
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h4 class="mb-4">LINE Messaging Settings</h4>

<!-- Setup Guide -->
<div class="alert alert-info">
    <h6><i class="bi bi-info-circle"></i> How to get LINE Messaging credentials</h6>
    <ol class="mb-0 small">
        <li>Go to <a href="https://developers.line.biz/console/" target="_blank">LINE Developers Console</a></li>
        <li>Create a Provider + Channel (select "Messaging API")</li>
        <li>On Channel Settings, copy <strong>Channel Secret</strong></li>
        <li>On "Messaging API" tab, click "Issue" under Channel access token (long-lived) → copy <strong>Channel Access Token</strong></li>
        <li>Each user must add your bot as a LINE friend, then their LINE User ID goes into their profile</li>
    </ol>
</div>

<div class="row">
    <!-- Configuration -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Configuration</h6>
                <span class="badge @(Model.IsTokenConfigured ? "bg-success" : "bg-warning")">
                    @(Model.IsTokenConfigured ? "Configured" : "Not Configured")
                </span>
            </div>
            <div class="card-body">
                <p class="small text-muted">Source: @Model.TokenSource</p>

                <form method="post" asp-page-handler="Save">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Channel Access Token *</label>
                        <input asp-for="ChannelAccessToken" class="form-control font-monospace"
                               placeholder="Leave blank to keep existing" />
                        <small class="text-muted">Long-lived token from LINE Developers Console</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Channel Secret</label>
                        <input asp-for="ChannelSecret" class="form-control font-monospace"
                               placeholder="Leave blank to keep existing" />
                        <small class="text-muted">For webhook signature verification (future use)</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Save Settings
                        </button>
                        @if (Model.IsTokenConfigured && Model.TokenSource.Contains("Database"))
                        {
                            <button type="submit" asp-page-handler="ClearToken" class="btn btn-outline-danger ms-auto"
                                    onclick="return confirm('Clear LINE settings from database?');">
                                <i class="bi bi-trash"></i> Clear
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Test -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-send-check"></i> Test Notification</h6></div>
            <div class="card-body">
                <p class="small text-muted">
                    Send a test message to verify your LINE setup works. The recipient must have added your bot as friend.
                </p>

                <form method="post" asp-page-handler="Test">
                    <div class="mb-3">
                        <label class="form-label fw-bold">LINE User ID</label>
                        <input asp-for="TestLineUserId" class="form-control font-monospace"
                               placeholder="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        <small class="text-muted">
                            Get your LINE User ID from the bot (user needs to send a message to the bot first, then use webhook to capture)
                            or from <a href="https://access.line.me/dialog/bot/mid/get" target="_blank">LINE Profile</a>
                        </small>
                    </div>

                    <!-- Use entered token (unsaved) or saved token -->
                    <input type="hidden" asp-for="ChannelAccessToken" />

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-send"></i> Send Test Message
                    </button>
                    <small class="text-muted ms-2">Uses current form token if entered, else saved token</small>
                </form>
            </div>
        </div>

        <!-- What gets sent -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0">What the system notifies</h6></div>
            <div class="card-body small">
                <ul class="mb-0">
                    <li><strong>System Offline</strong> (Critical) - when inverter stops reporting</li>
                    <li><strong>Cleaning Due</strong> (Medium) - panel cleaning reminder</li>
                    <li><strong>Warranty Expiring</strong> (Low) - 90 days before expiry</li>
                    <li><strong>Error/Warning</strong> - from inverter cloud alarms</li>
                </ul>
                <p class="mb-0 mt-2 text-muted">
                    Recipients: Customer (if LINE ID set), all Partner users with LINE ID
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Notification History -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">Recent LINE Notifications (Last 20)</h6></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Recipient</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.RecentNotifications)
                {
                    var statusClass = n.Status switch
                    {
                        SolarApp.Models.Enums.NotificationStatus.Sent => "bg-success",
                        SolarApp.Models.Enums.NotificationStatus.Delivered => "bg-success",
                        SolarApp.Models.Enums.NotificationStatus.Failed => "bg-danger",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><small>@n.CreatedAt.ToString("dd/MM HH:mm:ss")</small></td>
                        <td><code class="small">@(n.RecipientLineId?.Length > 20 ? n.RecipientLineId[..20] + "..." : n.RecipientLineId)</code></td>
                        <td>@n.Title</td>
                        <td><span class="badge @statusClass">@n.Status</span></td>
                        <td><small class="text-danger">@(n.ErrorMessage?.Length > 100 ? n.ErrorMessage[..100] + "..." : n.ErrorMessage)</small></td>
                    </tr>
                }
                @if (!Model.RecentNotifications.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No LINE notifications sent yet</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
