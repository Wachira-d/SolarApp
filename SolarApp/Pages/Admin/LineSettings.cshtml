@page
@model SolarApp.Pages.Admin.LineSettingsModel
@{
    ViewData["Title"] = "ตั้งค่า LINE";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.TestResult))
{
    <div class="alert alert-@(Model.TestSuccess ? "success" : "danger") alert-dismissible fade show">
        <i class="bi bi-@(Model.TestSuccess ? "check-circle-fill" : "x-circle-fill")"></i>
        <strong>ผลการทดสอบ:</strong> @Model.TestResult
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h4 class="mb-4">ตั้งค่า LINE Messaging API</h4>

<!-- Setup Guide -->
<div class="alert alert-info">
    <h6><i class="bi bi-info-circle"></i> วิธีตั้งค่า LINE Messaging API</h6>
    <ol class="mb-0 small">
        <li>ไปที่ <a href="https://developers.line.biz/console/" target="_blank">LINE Developers Console</a></li>
        <li>Create Provider → Create Channel → เลือก <strong>Messaging API</strong></li>
        <li>ที่ Channel Settings → copy <strong>Channel Secret</strong></li>
        <li>ที่ Messaging API tab → Issue <strong>Channel access token (long-lived)</strong> → copy</li>
        <li>ที่ Messaging API tab → <strong>Webhook URL</strong> → ใส่ URL ด้านล่าง แล้วเปิด <strong>Use webhook</strong></li>
        <li>เพิ่ม Bot เข้ากลุ่ม LINE → Bot จะตอบ <strong>Group ID</strong> กลับมาในกลุ่มทันที</li>
        <li>ให้ลูกค้าเพิ่มเพื่อน Bot → Bot จะตอบ <strong>User ID</strong> กลับไปให้ลูกค้าส่งมาให้</li>
    </ol>
</div>

@* Copying a group ID out of a debugger was the only way to get one. With
   the webhook connected the bot answers with it, and customers can ask the
   system how their site is doing instead of ringing the office. *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h6 class="mb-0"><i class="bi bi-arrow-left-right"></i> Webhook — ให้ลูกค้าถามสถานะผ่าน LINE ได้</h6>
    </div>
    <div class="card-body">
        <label class="form-label fw-bold">Webhook URL (นำไปใส่ใน LINE Developers Console)</label>
        <div class="input-group mb-2">
            <input type="text" class="form-control font-monospace" readonly id="webhookUrl"
                   value="@($"{Context.Request.Scheme}://{Context.Request.Host}/api/line/webhook")" />
            <button type="button" class="btn btn-outline-secondary"
                    onclick="navigator.clipboard.writeText(document.getElementById('webhookUrl').value); this.innerHTML='<i class=bi-check2></i> คัดลอกแล้ว'">
                <i class="bi bi-clipboard"></i> คัดลอก
            </button>
        </div>
        <div class="small text-muted">
            ต้องเป็น <code>https://</code> — LINE ไม่รับ webhook ที่ไม่ได้เข้ารหัส<br>
            ต้องตั้งค่า <strong>Channel Secret</strong> ด้านล่างก่อน มิฉะนั้นระบบจะปฏิเสธทุก request
            (ใช้ตรวจลายเซ็นว่ามาจาก LINE จริง)
        </div>
        <hr />
        <p class="small mb-1 fw-bold">คำสั่งที่ลูกค้าพิมพ์ได้:</p>
        <ul class="small mb-0">
            <li><code>สถานะ</code> — ระบบทำงานปกติไหม ผลิตได้เท่าไหร่วันนี้</li>
            <li><code>เดือนนี้</code> — ผลผลิตและค่าไฟที่ประหยัดได้เดือนนี้</li>
            <li><code>แจ้งเตือน</code> — รายการที่ยังไม่ได้จัดการ</li>
            <li><code>ID</code> — ดู LINE ID ของตัวเองหรือของกลุ่ม</li>
            <li><code>เมนู</code> — ดูคำสั่งทั้งหมด</li>
        </ul>
        <div class="small text-muted mt-2">
            ระบบตอบเฉพาะข้อมูลของ LINE ID ที่ถามเท่านั้น — ถ้ายังไม่ได้ผูกกับบัญชีลูกค้า
            จะได้รับแค่ ID ของตัวเองกลับไป
        </div>
    </div>
</div>

<div class="row">
    <!-- Configuration + Save -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between">
                <h6 class="mb-0">การตั้งค่า</h6>
                <span class="badge @(Model.IsTokenConfigured ? "bg-success" : "bg-warning")">
                    @(Model.IsTokenConfigured ? "ตั้งค่าแล้ว" : "ยังไม่ได้ตั้งค่า")
                </span>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">ที่มาของค่า: @Model.TokenSource</p>

                <form method="post" asp-page-handler="Save">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Channel Access Token *</label>
                        <input asp-for="ChannelAccessToken" class="form-control font-monospace" placeholder="วาง token ใหม่ (เว้นว่าง = ใช้ค่าเดิม)" />
                        <small class="text-muted">token แบบ long-lived จาก LINE Developers</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Channel Secret</label>
                        <input asp-for="ChannelSecret" class="form-control font-monospace" placeholder="วาง secret ใหม่ (เว้นว่าง = ใช้ค่าเดิม)" />
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-people-fill text-success"></i> Alert Group ID (แจ้งเตือนไปกลุ่ม LINE)
                        </label>
                        <input asp-for="AlertGroupId" class="form-control font-monospace"
                               placeholder="Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        <small class="text-muted">
                            ทุก Alert จะถูกส่งไปกลุ่มนี้ด้วย (นอกเหนือจากส่งให้ Customer/Partner แต่ละคน)
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-link-45deg text-primary"></i> App Base URL (สำหรับปุ่มกดในข้อความ LINE)
                        </label>
                        <input asp-for="AppBaseUrl" class="form-control font-monospace"
                               placeholder="https://solarapp.mangkorn.co.th" />
                        <small class="text-muted">
                            URL หลักของเว็บ (ต้องเป็น <code>https://</code>) — ใช้สร้างปุ่ม "ดู Alert ค้าง"
                            ในสรุปรายวันที่ส่งเข้า LINE. เว้นว่าง = ไม่มีปุ่ม.
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentAppBaseUrl))
                            {
                                <span class="d-block text-success">ปัจจุบัน: <code>@Model.CurrentAppBaseUrl</code></span>
                            }
                        </small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> บันทึกการตั้งค่า
                        </button>
                        @if (Model.IsTokenConfigured && Model.TokenSource.Contains("Database"))
                        {
                            <button type="submit" asp-page-handler="ClearToken" class="btn btn-outline-danger ms-auto"
                                    onclick="return confirm('ล้างค่า LINE ทั้งหมด?');">
                                <i class="bi bi-trash"></i> ล้างทั้งหมด
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Test -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-send-check"></i> ทดสอบส่งแจ้งเตือน</h6>
            </div>
            <div class="card-body">
                <!-- Test to User -->
                <form method="post" asp-page-handler="TestUser" class="mb-4">
                    <h6 class="text-primary">1. ส่งทดสอบไปที่ User</h6>
                    <div class="input-group mb-2">
                        <input asp-for="TestLineUserId" class="form-control font-monospace"
                               placeholder="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        <button type="submit" class="btn btn-outline-success">
                            <i class="bi bi-send"></i> ทดสอบส่งหา User
                        </button>
                    </div>
                    <small class="text-muted">LINE User ID ของคนที่จะส่งทดสอบ</small>
                    <input type="hidden" asp-for="ChannelAccessToken" />
                </form>

                <!-- Test to Group -->
                <form method="post" asp-page-handler="TestGroup">
                    <h6 class="text-success">2. ส่งทดสอบไปที่ Group</h6>
                    <div class="input-group mb-2">
                        <input asp-for="AlertGroupId" class="form-control font-monospace"
                               placeholder="Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        <button type="submit" class="btn btn-outline-success">
                            <i class="bi bi-send"></i> ทดสอบส่งเข้ากลุ่ม
                        </button>
                    </div>
                    <small class="text-muted">Group ID ที่ต้องการทดสอบ (Bot ต้องอยู่ในกลุ่มแล้ว)</small>
                    <input type="hidden" asp-for="ChannelAccessToken" />
                </form>
            </div>
        </div>

        <!-- How alerts get sent -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0">ระบบส่งแจ้งเตือนอย่างไร</h6></div>
            <div class="card-body small">
                <p class="mb-2">เมื่อเกิด Alert ระบบจะส่งไปที่:</p>
                <ol class="mb-2">
                    <li><strong>Alert Group ID</strong> (กลุ่ม LINE ที่ตั้งค่าด้านบน) — ทุก alert</li>
                    <li><strong>Customer</strong> (ถ้ามี LINE User ID ใน Customer profile) — เฉพาะ installation ของตัวเอง</li>
                    <li><strong>Partner Users</strong> (ถ้ามี LINE User ID ใน User profile) — เฉพาะ installation ที่ดูแล</li>
                </ol>
                <p class="mb-2 fw-bold">ประเภทการแจ้งเตือน:</p>
                <ul class="mb-0">
                    <li><span class="badge bg-danger">วิกฤต</span> ระบบออฟไลน์</li>
                    <li><span class="badge bg-warning text-dark">ปานกลาง</span> ล้างแผงครบกำหนด</li>
                    <li><span class="badge bg-info">ต่ำ</span> ประกันใกล้หมด (90 วัน)</li>
                    <li><span class="badge bg-secondary">เตือน</span> ข้อผิดพลาดจากคลาวด์ของอินเวอร์เตอร์</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Notification History -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">ประวัติการส่งแจ้งเตือน (20 รายการล่าสุด)</h6></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr><th>เวลา</th><th>ผู้รับ</th><th>หัวข้อ</th><th>สถานะ</th><th>ข้อผิดพลาด</th></tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.RecentNotifications)
                    {
                        var statusClass = n.Status switch
                        {
                            SolarApp.Models.Enums.NotificationStatus.Sent => "bg-success",
                            SolarApp.Models.Enums.NotificationStatus.Delivered => "bg-success",
                            SolarApp.Models.Enums.NotificationStatus.Failed => "bg-danger",
                            _ => "bg-secondary"
                        };
                        var recipientType = n.RecipientLineId?.StartsWith("C") == true ? "Group" :
                                           n.RecipientLineId?.StartsWith("U") == true ? "User" : "?";
                        <tr>
                            <td><small>@n.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                            <td>
                                <span class="badge bg-secondary me-1">@recipientType</span>
                                <code class="small">@(n.RecipientLineId?.Length > 16 ? n.RecipientLineId[..16] + "..." : n.RecipientLineId)</code>
                            </td>
                            <td>@n.Title</td>
                            <td><span class="badge @statusClass">@n.Status</span></td>
                            <td><small class="text-danger">@(n.ErrorMessage != null && n.ErrorMessage.Length > 80 ? n.ErrorMessage[..80] + "..." : n.ErrorMessage)</small></td>
                        </tr>
                    }
                    @if (!Model.RecentNotifications.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">ยังไม่มีประวัติการส่ง</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
