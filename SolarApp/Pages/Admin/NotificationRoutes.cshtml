@page
@using SolarApp.Models.Enums
@model SolarApp.Pages.Admin.NotificationRoutesModel
@{
    ViewData["Title"] = "ตั้งค่าการส่ง LINE แบบละเอียด";

    string EventLabel(NotificationEventType e) => e switch
    {
        NotificationEventType.GridLossOffline => "🔴 ระบบดับ / Offline",
        NotificationEventType.Recovery => "✅ กลับมาปกติ (Recovery)",
        NotificationEventType.LowProduction => "📉 ผลิตต่ำกว่าเป้า",
        NotificationEventType.ApiFailure => "🔌 API/Cloud ล้มเหลว",
        NotificationEventType.CleaningDue => "🧽 ครบรอบล้างแผง",
        NotificationEventType.WarrantyExpiry => "🛡️ ประกันใกล้หมดอายุ",
        NotificationEventType.DailySummary => "📊 สรุปรายวัน",
        NotificationEventType.StationFaulty => "⚠️ Station Faulty",
        NotificationEventType.PredictiveDiagnostic => "🔮 แจ้งเตือนล่วงหน้า",
        NotificationEventType.All => "🌐 ทุกเหตุการณ์ (All)",
        _ => e.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-bell"></i> ตั้งค่าการส่ง LINE แบบละเอียด</h4>
    <a asp-page="LineSettings" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-gear"></i> ตั้งค่า LINE หลัก
    </a>
</div>

<p class="text-muted small">
    กำหนดได้ว่าแต่ละ <strong>เหตุการณ์</strong> (เช่น ประกันหมดอายุ, ระบบดับ) จะส่ง LINE
    เข้า<strong>กรุ๊ป</strong>หรือ<strong>ผู้ใช้ส่วนตัว</strong> ตาม ID ที่ตั้ง.
    เพิ่มได้หลายปลายทางต่อหนึ่งเหตุการณ์ — เช่น ประกันหมดอายุ → ส่งทั้งกรุ๊ปทีมงาน และ LINE เจ้าของไซต์.
    <br>
    <strong>Global</strong> = ใช้กับทุกไซต์ &nbsp;|&nbsp; เลือกไซต์ = เฉพาะไซต์นั้น.
    ระบบนี้<strong>เพิ่มเติม</strong>จากการแจ้งเตือนเดิม (กรุ๊ป operator + ลูกค้า) ไม่ทับกัน — ปลายทางซ้ำจะส่งครั้งเดียว.
</p>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- ── Add route ── -->
<div class="card mb-4">
    <div class="card-header bg-light"><strong>เพิ่มปลายทางใหม่</strong></div>
    <div class="card-body">
        <form method="post" asp-page-handler="Add" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">เหตุการณ์</label>
                <select asp-for="Input.EventType" class="form-select form-select-sm">
                    @foreach (var e in Enum.GetValues<NotificationEventType>())
                    {
                        <option value="@e">@EventLabel(e)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">ขอบเขต</label>
                <select asp-for="Input.InstallationId" class="form-select form-select-sm">
                    <option value="0">🌐 Global (ทุกไซต์)</option>
                    @foreach (var opt in Model.InstallationOptions)
                    {
                        <option value="@opt.Value">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">LINE ID (group/user/room)</label>
                <input asp-for="Input.LineId" class="form-control form-control-sm"
                       placeholder="C... หรือ U..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">ป้ายกำกับ</label>
                <input asp-for="Input.Label" class="form-control form-control-sm"
                       placeholder="เช่น ทีมช่าง" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-warning btn-sm w-100">
                    <i class="bi bi-plus-lg"></i> เพิ่ม
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ── Existing routes ── -->
@if (!Model.Routes.Any())
{
    <div class="alert alert-info">ยังไม่มี route — เพิ่มด้านบนเพื่อเริ่มส่ง LINE ตามเหตุการณ์.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>เหตุการณ์</th>
                    <th>ขอบเขต</th>
                    <th>LINE ID</th>
                    <th>ป้ายกำกับ</th>
                    <th>สถานะ</th>
                    <th class="text-end">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Routes)
                {
                    <tr class="@(r.IsEnabled ? "" : "opacity-50")">
                        <td>@EventLabel(r.EventType)</td>
                        <td>
                            @if (r.InstallationId == null)
                            {
                                <span class="badge bg-primary">🌐 Global</span>
                            }
                            else if (Model.InstallationNames.TryGetValue(r.InstallationId.Value, out var name))
                            {
                                <span class="badge bg-secondary">@name</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">#@r.InstallationId</span>
                            }
                        </td>
                        <td><code>@r.LineId</code></td>
                        <td>@(r.Label ?? "-")</td>
                        <td>
                            @if (r.IsEnabled)
                            {
                                <span class="badge bg-success">เปิด</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ปิด</span>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Test" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-outline-info btn-sm" title="ส่งข้อความทดสอบ">
                                    <i class="bi bi-send"></i>
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@r.Id" class="d-inline">
                                <button class="btn btn-outline-secondary btn-sm" title="เปิด/ปิด">
                                    <i class="bi bi-@(r.IsEnabled ? "pause" : "play")"></i>
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline"
                                  onsubmit="return confirm('ลบ route นี้?');">
                                <button class="btn btn-outline-danger btn-sm" title="ลบ">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
