@using Microsoft.AspNetCore.Identity
@using SolarApp.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#212529" />
    <title>@ViewData["Title"] - SolarApp</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Apply theme BEFORE body renders to avoid white flash
        (function () {
            try {
                var saved = localStorage.getItem('solarapp.theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) { }
        })();
    </script>
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        @* ── Mobile Top Bar (visible < lg) ── *@
        <nav class="navbar navbar-dark bg-dark d-lg-none sticky-top shadow-sm">
            <div class="container-fluid">
                <button class="btn btn-outline-light btn-sm" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <span class="navbar-brand mb-0 ms-2">
                    <i class="bi bi-sun-fill text-warning"></i> SolarApp
                </span>
                <span class="ms-auto text-white-50 small d-none d-sm-inline me-2">@ViewData["Title"]</span>
                <button type="button" class="btn btn-sm btn-outline-light ms-auto ms-sm-0" onclick="toggleTheme()" title="สลับธีมสว่าง/มืด">
                    <i class="bi bi-moon-fill"></i><i class="bi bi-sun-fill"></i>
                </button>
            </div>
        </nav>

        @* ── Mobile Sidebar (offcanvas) ── *@
        <div class="offcanvas offcanvas-start bg-dark text-white d-lg-none" tabindex="-1"
             id="mobileSidebar" aria-labelledby="mobileSidebarLabel" style="width: 280px;">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title" id="mobileSidebarLabel">
                    <i class="bi bi-sun-fill text-warning"></i> SolarApp
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body p-0">
                @await Html.PartialAsync("_SideNav")
            </div>
        </div>

        <div class="d-flex" id="wrapper">
            @* ── Desktop Sidebar (visible >= lg) ── *@
            <aside class="bg-dark text-white d-none d-lg-flex flex-column" id="sidebar">
                <div class="p-3 border-bottom border-secondary">
                    <h5 class="mb-0"><i class="bi bi-sun-fill text-warning"></i> SolarApp</h5>
                    <small class="text-muted">ระบบจัดการพลังงานแสงอาทิตย์</small>
                </div>
                @await Html.PartialAsync("_SideNav")
            </aside>

            @* ── Main content ── *@
            <div class="flex-grow-1 min-width-0">
                @* Top bar for desktop *@
                <nav class="navbar navbar-expand navbar-light bg-white border-bottom shadow-sm d-none d-lg-flex">
                    <div class="container-fluid">
                        <span class="navbar-text fw-bold">@ViewData["Title"]</span>
                        <div class="ms-auto d-flex align-items-center">
                            <div class="dropdown me-2">
                                <button class="btn btn-link btn-sm text-muted text-decoration-none dropdown-toggle"
                                        type="button" data-bs-toggle="dropdown">
                                    <span id="liveLed" title="Live feed status"></span>
                                    <i class="bi bi-person-circle me-1"></i>
                                    @UserManager.GetUserName(User)
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Account/Manage">
                                        <i class="bi bi-shield-lock me-1"></i> จัดการบัญชี
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-page="/Account/Logout" method="post" class="px-3">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                                <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                            <div class="dropdown me-2">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-translate"></i> @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToUpper())
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/Language/Set?culture=en&returnUrl=@Context.Request.Path">English</a></li>
                                    <li><a class="dropdown-item" href="/Language/Set?culture=th&returnUrl=@Context.Request.Path">ไทย</a></li>
                                </ul>
                            </div>
                            <button type="button" class="theme-toggle me-2" onclick="toggleTheme()" title="สลับธีมสว่าง/มืด">
                                <i class="bi bi-moon-fill"></i><i class="bi bi-sun-fill"></i>
                            </button>
                            <form asp-page="/Account/Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                                </button>
                            </form>
                        </div>
                    </div>
                </nav>

                <div class="container-fluid p-3 p-md-4">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container py-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Auto-close offcanvas sidebar on link click (mobile UX)
        document.querySelectorAll('#mobileSidebar .nav-link').forEach(link => {
            link.addEventListener('click', () => {
                const off = bootstrap.Offcanvas.getInstance(document.getElementById('mobileSidebar'));
                off?.hide();
            });
        });

        // ──────────────────────────────────────────────────────────────
        // Global Toast notification system — replacement for alert()
        // Usage:  window.toast.success('Saved')
        //         window.toast.error('Failed: ' + err.message)
        //         window.toast.info('Syncing...')
        //         window.toast.warning('Connection slow')
        // ──────────────────────────────────────────────────────────────
        (function () {
            // Create container if absent
            let container = document.getElementById('toastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toastContainer';
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '1090';
                document.body.appendChild(container);
            }

            function show(message, variant, icon, delay) {
                const id = 'toast_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
                const html =
                    '<div id="' + id + '" class="toast align-items-center text-white bg-' + variant +
                    ' border-0" role="alert" aria-live="assertive" aria-atomic="true">' +
                    '  <div class="d-flex">' +
                    '    <div class="toast-body"><i class="bi bi-' + icon + ' me-2"></i>' +
                    String(message).replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c])) +
                    '    </div>' +
                    '    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                    '  </div>' +
                    '</div>';
                container.insertAdjacentHTML('beforeend', html);
                const el = document.getElementById(id);
                const t = new bootstrap.Toast(el, { delay: delay || 4000 });
                el.addEventListener('hidden.bs.toast', () => el.remove());
                t.show();
            }

            window.toast = {
                success: (msg) => show(msg, 'success', 'check-circle-fill', 3500),
                error:   (msg) => show(msg, 'danger',  'exclamation-triangle-fill', 6000),
                info:    (msg) => show(msg, 'info',    'info-circle-fill', 4000),
                warning: (msg) => show(msg, 'warning', 'exclamation-circle-fill', 5000)
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
