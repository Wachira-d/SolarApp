@using Microsoft.AspNetCore.Identity
@using SolarApp.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string)?.ToLower() ?? "";
    string ActiveClass(params string[] prefixes) =>
        prefixes.Any(p => currentPage.StartsWith(p.ToLower())) ? "active" : "";
}

<nav class="p-2 d-flex flex-column" style="flex: 1 1 auto;">
    <ul class="nav flex-column mb-auto">
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/dashboard")" asp-page="/Dashboard/Index">
                <i class="bi bi-speedometer2 me-2"></i>หน้าหลัก
            </a>
        </li>
        @if (User.IsInRole("Customer"))
        {
            <li class="nav-item">
                @* There were two customer portals and this link pointed at the
                   weaker one. /My/* is the maintained portal (PWA shell, sites,
                   history, alerts, settings); /MyHome was a single page. *@
                <a class="nav-link text-white @ActiveClass("/my/")" asp-page="/My/Index">
                    <i class="bi bi-sun-fill me-2 text-warning"></i>โซลาร์ของฉัน
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/installations")" asp-page="/Installations/Index">
                <i class="bi bi-house-gear me-2"></i>ไซต์งาน
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/map")" asp-page="/Map/Index">
                <i class="bi bi-geo-alt me-2"></i>แผนที่
            </a>
        </li>
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/customers")" asp-page="/Customers/Index">
                    <i class="bi bi-people me-2"></i>ลูกค้า
                </a>
            </li>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
        {
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/partners")" asp-page="/Partners/Index">
                    <i class="bi bi-building me-2"></i>พาร์ทเนอร์
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/workorders")" asp-page="/WorkOrders/Index">
                <i class="bi bi-clipboard2-check me-2"></i>ใบสั่งงาน
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/maintenance")" asp-page="/Maintenance/Index">
                <i class="bi bi-tools me-2"></i>การบำรุงรักษา
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/servicetickets")" asp-page="/ServiceTickets/Index">
                <i class="bi bi-ticket-detailed me-2"></i>แจ้งซ่อม
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/performance")" asp-page="/Performance/Index">
                <i class="bi bi-speedometer me-2"></i>ผลการผลิต
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/reports")" asp-page="/Reports/Index">
                <i class="bi bi-bar-chart me-2"></i>รายงาน
            </a>
        </li>
        @if (User.IsInRole("Admin"))
        {
            @* Sixteen flat links pushed everything below the fold on a phone,
               and the four an admin opens weekly sat among twelve they open
               once a year. Daily work stays visible; setup collapses. *@
            <li class="nav-item mt-3">
                <small class="text-muted px-3 text-uppercase" style="letter-spacing: 0.1em;">ผู้ดูแลระบบ</small>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/users")" asp-page="/Admin/Users">
                    <i class="bi bi-people me-2"></i>จัดการผู้ใช้
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/importinstallations")" asp-page="/Admin/ImportInstallations">
                    <i class="bi bi-upload me-2"></i>นำเข้าข้อมูล
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/alerts")" asp-page="/Admin/Alerts">
                    <i class="bi bi-bell me-2"></i>แจ้งเตือนทั้งหมด
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/alertrules")" asp-page="/Admin/AlertRules">
                    <i class="bi bi-shield-exclamation me-2"></i>กฎแจ้งเตือน
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/contracts")" asp-page="/Contracts/Index">
                    <i class="bi bi-file-earmark-text me-2"></i>สัญญาบริการ
                </a>
            </li>
            @{
                // Open the group when the operator is already inside it, so a
                // page reload doesn't hide the section they're working in.
                var inSetup = currentPage.StartsWith("/admin/workordertemplates")
                    || currentPage.StartsWith("/admin/schedule")
                    || currentPage.StartsWith("/admin/linesettings")
                    || currentPage.StartsWith("/admin/notificationroutes")
                    || currentPage.StartsWith("/admin/externalauth");
                var inDiag = currentPage.StartsWith("/admin/connectionhealth")
                    || currentPage.StartsWith("/admin/startuplogs")
                    || currentPage.StartsWith("/admin/auditlogs");
            }

            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center @(inSetup ? "" : "collapsed")"
                   data-bs-toggle="collapse" href="#navSetup" role="button"
                   aria-expanded="@(inSetup ? "true" : "false")" aria-controls="navSetup">
                    <i class="bi bi-sliders me-2"></i>ตั้งค่าระบบ
                    <i class="bi bi-chevron-down ms-auto small"></i>
                </a>
                <ul class="nav flex-column collapse @(inSetup ? "show" : "") ps-3" id="navSetup">
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/workordertemplates")" asp-page="/Admin/WorkOrderTemplates">
                            <i class="bi bi-list-check me-2"></i>ค่ามาตรฐานใบสั่งงาน
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/schedule")" asp-page="/Admin/Schedule">
                            <i class="bi bi-clock-history me-2"></i>ตารางงานเบื้องหลัง
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/linesettings")" asp-page="/Admin/LineSettings">
                            <i class="bi bi-chat-dots me-2"></i>ตั้งค่า LINE
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/notificationroutes")" asp-page="/Admin/NotificationRoutes">
                            <i class="bi bi-bell me-2"></i>เส้นทางแจ้งเตือน LINE
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/externalauth")" asp-page="/Admin/ExternalAuth">
                            <i class="bi bi-shield-lock me-2"></i>การเข้าสู่ระบบภายนอก
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center @(inDiag ? "" : "collapsed")"
                   data-bs-toggle="collapse" href="#navDiag" role="button"
                   aria-expanded="@(inDiag ? "true" : "false")" aria-controls="navDiag">
                    <i class="bi bi-activity me-2"></i>ตรวจสอบระบบ
                    <i class="bi bi-chevron-down ms-auto small"></i>
                </a>
                <ul class="nav flex-column collapse @(inDiag ? "show" : "") ps-3" id="navDiag">
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/connectionhealth")" asp-page="/Admin/ConnectionHealth">
                            <i class="bi bi-hdd-network me-2"></i>สุขภาพการเชื่อมต่อ API
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/startuplogs")" asp-page="/Admin/StartupLogs">
                            <i class="bi bi-bug me-2"></i>บันทึกการเริ่มระบบ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @ActiveClass("/admin/auditlogs")" asp-page="/Admin/AuditLogs">
                            <i class="bi bi-journal-text me-2"></i>บันทึกการใช้งาน
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/hangfire" target="_blank">
                            <i class="bi bi-gear me-2"></i>Hangfire (งานเบื้องหลัง)
                        </a>
                    </li>
                </ul>
            </li>
        }
    </ul>

    @* User info + manage + logout *@
    <div class="mt-auto p-2 border-top border-secondary">
        <div class="text-white-50 small mb-2">
            <i class="bi bi-person-circle me-1"></i>
            @UserManager.GetUserName(User)
        </div>
        <a asp-page="/Account/Manage" class="btn btn-outline-light btn-sm w-100 mb-2">
            <i class="bi bi-shield-lock"></i> จัดการบัญชี / ผูก LINE
        </a>
        <form asp-page="/Account/Logout" method="post" class="d-grid">
            <button type="submit" class="btn btn-outline-light btn-sm">
                <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
            </button>
        </form>
    </div>
</nav>
