@using Microsoft.AspNetCore.Identity
@using SolarApp.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string)?.ToLower() ?? "";
    string ActiveClass(params string[] prefixes) =>
        prefixes.Any(p => currentPage.StartsWith(p.ToLower())) ? "active" : "";
}

<nav class="p-2 d-flex flex-column" style="flex: 1 1 auto;">
    <ul class="nav flex-column mb-auto">
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/dashboard")" asp-page="/Dashboard/Index">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
        </li>
        @if (User.IsInRole("Customer"))
        {
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/myhome")" asp-page="/MyHome/Index">
                    <i class="bi bi-sun-fill me-2 text-warning"></i>My Solar
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/installations")" asp-page="/Installations/Index">
                <i class="bi bi-house-gear me-2"></i>Installations
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/map")" asp-page="/Map/Index">
                <i class="bi bi-geo-alt me-2"></i>Map
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/workorders")" asp-page="/WorkOrders/Index">
                <i class="bi bi-clipboard2-check me-2"></i>Work Orders
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/maintenance")" asp-page="/Maintenance/Index">
                <i class="bi bi-tools me-2"></i>Maintenance
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/servicetickets")" asp-page="/ServiceTickets/Index">
                <i class="bi bi-ticket-detailed me-2"></i>Service Tickets
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/performance")" asp-page="/Performance/Index">
                <i class="bi bi-speedometer me-2"></i>Performance
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white @ActiveClass("/reports")" asp-page="/Reports/Index">
                <i class="bi bi-bar-chart me-2"></i>Reports
            </a>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item mt-3">
                <small class="text-muted px-3 text-uppercase" style="letter-spacing: 0.1em;">Admin</small>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/users")" asp-page="/Admin/Users">
                    <i class="bi bi-people me-2"></i>User Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/importinstallations")" asp-page="/Admin/ImportInstallations">
                    <i class="bi bi-upload me-2"></i>Bulk Import
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/alerts")" asp-page="/Admin/Alerts">
                    <i class="bi bi-bell me-2"></i>All Alerts
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/alertrules")" asp-page="/Admin/AlertRules">
                    <i class="bi bi-shield-exclamation me-2"></i>Alert Rules
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/schedule")" asp-page="/Admin/Schedule">
                    <i class="bi bi-clock-history me-2"></i>Sync Schedule
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/linesettings")" asp-page="/Admin/LineSettings">
                    <i class="bi bi-chat-dots me-2"></i>LINE Messaging
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/externalauth")" asp-page="/Admin/ExternalAuth">
                    <i class="bi bi-shield-lock me-2"></i>External Auth (SSO)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/startuplogs")" asp-page="/Admin/StartupLogs">
                    <i class="bi bi-bug me-2"></i>Startup Logs
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @ActiveClass("/admin/auditlogs")" asp-page="/Admin/AuditLogs">
                    <i class="bi bi-journal-text me-2"></i>Audit Logs
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" href="/hangfire" target="_blank">
                    <i class="bi bi-gear me-2"></i>Hangfire
                </a>
            </li>
        }
    </ul>

    @* User info + manage + logout *@
    <div class="mt-auto p-2 border-top border-secondary">
        <div class="text-white-50 small mb-2">
            <i class="bi bi-person-circle me-1"></i>
            @UserManager.GetUserName(User)
        </div>
        <a asp-page="/Account/Manage" class="btn btn-outline-light btn-sm w-100 mb-2">
            <i class="bi bi-shield-lock"></i> Manage Logins / Link LINE
        </a>
        <form asp-page="/Account/Logout" method="post" class="d-grid">
            <button type="submit" class="btn btn-outline-light btn-sm">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </div>
</nav>
