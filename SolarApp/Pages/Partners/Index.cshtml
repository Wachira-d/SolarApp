@page
@model SolarApp.Pages.Partners.IndexModel
@{
    ViewData["Title"] = "พาร์ทเนอร์";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-building text-warning"></i> พาร์ทเนอร์</h4>
        <small class="text-muted">
            @Model.Rows.Count ราย · @Model.TotalSites ไซต์ · @Model.TotalCapacityKw.ToString("N1") kWp
        </small>
    </div>
    @if (Model.IsAdmin)
    {
        <a asp-page="/Admin/Users" class="btn btn-warning btn-sm">
            <i class="bi bi-plus-lg"></i> เพิ่ม / แก้ไขพาร์ทเนอร์
        </a>
    }
</div>

@if (Model.IsAdmin)
{
    <form method="get" class="card border-0 shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-2 align-items-center">
            <input type="text" name="q" value="@Model.Q" class="form-control form-control-sm"
                   style="max-width:280px" placeholder="ค้นหาชื่อบริษัท / อีเมล / เบอร์โทร / จังหวัด..." />
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-search"></i> ค้นหา
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <a asp-page="/Partners/Index" class="btn btn-sm btn-link">ล้างตัวกรอง</a>
            }
        </div>
    </form>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>พาร์ทเนอร์</th>
                        <th>ติดต่อ</th>
                        <th class="text-center">ผู้ใช้</th>
                        <th class="text-center">ลูกค้า</th>
                        <th class="text-center">ไซต์</th>
                        <th class="text-end">กำลังติดตั้ง</th>
                        <th class="text-center">แจ้งเตือน</th>
                        <th>สัญญา</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Rows)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Partners/Detail" asp-route-id="@p.Id" class="text-decoration-none">
                                    <strong>@p.CompanyName</strong>
                                </a>
                                @if (!p.IsActive)
                                {
                                    <span class="badge bg-secondary ms-1">ปิดใช้งาน</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Province))
                                {
                                    <br /><small class="text-muted">@p.Province</small>
                                }
                            </td>
                            <td>
                                <small class="d-block">@(string.IsNullOrWhiteSpace(p.ContactPhone) ? "-" : p.ContactPhone)</small>
                                <small class="text-muted">@p.ContactEmail</small>
                            </td>
                            <td class="text-center">
                                @* Zero users means nobody at this partner can log
                                   in — their sites are effectively unattended. *@
                                @if (p.UserCount == 0)
                                {
                                    <span class="badge bg-warning text-dark" title="ยังไม่มีผู้ใช้เข้าระบบ">0</span>
                                }
                                else
                                {
                                    @p.UserCount
                                }
                            </td>
                            <td class="text-center">@p.CustomerCount</td>
                            <td class="text-center">
                                @p.SiteCount
                                @if (p.OfflineCount > 0)
                                {
                                    <br /><span class="badge bg-danger">ออฟไลน์ @p.OfflineCount</span>
                                }
                            </td>
                            <td class="text-end">@p.CapacityKw.ToString("N1") kWp</td>
                            <td class="text-center">
                                @if (p.OpenAlerts > 0)
                                {
                                    <span class="badge bg-warning text-dark">@p.OpenAlerts</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (p.ContractEndDate.HasValue)
                                {
                                    <small class="@(p.ContractAtRisk ? "text-danger fw-bold" : "text-muted")">
                                        ถึง @p.ContractEndDate.Value.ToString("dd/MM/yyyy")
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">-</small>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="/Partners/Detail" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary">ดู</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">ไม่พบพาร์ทเนอร์ตามเงื่อนไขที่เลือก</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
