@page
@using SolarApp.Models.Enums
@model SolarApp.Pages.Contracts.IndexModel
@{
    ViewData["Title"] = "สัญญาบริการ";

    string StatusBadge(ContractStatus s) => s switch
    {
        ContractStatus.Active => "bg-success",
        ContractStatus.Draft => "bg-secondary",
        ContractStatus.Expired => "bg-danger",
        ContractStatus.Terminated => "bg-dark",
        ContractStatus.Suspended => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    string StatusLabel(ContractStatus s) => s switch
    {
        ContractStatus.Active => "ใช้งาน",
        ContractStatus.Draft => "ร่าง",
        ContractStatus.Expired => "หมดอายุ",
        ContractStatus.Terminated => "ยกเลิก",
        ContractStatus.Suspended => "พักชั่วคราว",
        _ => s.ToString()
    };

    string CycleLabel(ContractBillingCycle c) => c switch
    {
        ContractBillingCycle.Monthly => "รายเดือน",
        ContractBillingCycle.Quarterly => "รายไตรมาส",
        ContractBillingCycle.Yearly => "รายปี",
        ContractBillingCycle.OneTime => "จ่ายครั้งเดียว",
        _ => c.ToString()
    };
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="mb-0"><i class="bi bi-file-earmark-text text-warning"></i> สัญญาบริการ</h4>
    <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createContractModal">
        <i class="bi bi-plus-lg"></i> เพิ่มสัญญา
    </button>
</div>

<!-- ═══ SUMMARY ═══ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
            <div class="fs-4 fw-bold text-success">@Model.AnnualRunRate.ToString("N0")</div>
            <small class="text-muted">รายได้ต่อปี (บาท)</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
            <div class="fs-4 fw-bold">@Model.ActiveCount</div>
            <small class="text-muted">สัญญาที่ใช้งาน</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 @(Model.ExpiringCount > 0 ? "border-warning border-2" : "")">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold @(Model.ExpiringCount > 0 ? "text-warning" : "text-muted")">@Model.ExpiringCount</div>
                <small class="text-muted">ใกล้หมดอายุ (60 วัน)</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 @(Model.OutstandingThb > 0 ? "border-danger border-2" : "")">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold @(Model.OutstandingThb > 0 ? "text-danger" : "text-muted")">
                    @Model.OutstandingThb.ToString("N0")
                </div>
                <small class="text-muted">ค้างชำระ (บาท)</small>
            </div>
        </div>
    </div>
</div>

@* Work we may be giving away. A site with no contract still gets alerts,
   cleaning reminders and truck rolls — it just doesn't get billed. *@
@if (Model.UncoveredSites > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle fs-4"></i>
        <div>
            มี <strong>@Model.UncoveredSites ไซต์</strong> ที่ยังไม่มีสัญญาบริการที่ใช้งานอยู่ —
            ไซต์เหล่านี้ยังได้รับการแจ้งเตือนและงานบำรุงรักษาตามปกติ แต่ไม่มีรายการเรียกเก็บเงิน
        </div>
    </div>
}

<!-- ═══ OVERDUE INVOICES ═══ -->
@if (Model.OverdueInvoices.Any())
{
    <div class="card border-danger border-2 shadow-sm mb-4">
        <div class="card-header bg-danger text-white">
            <i class="bi bi-cash-stack"></i> ใบแจ้งหนี้ที่เลยกำหนดชำระ (@Model.OverdueInvoices.Count)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>เลขที่</th><th>ไซต์งาน</th><th>รอบบริการ</th>
                            <th>ครบกำหนด</th><th class="text-end">จำนวนเงิน</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.OverdueInvoices)
                        {
                            <tr>
                                <td><small>@(inv.InvoiceNumber ?? "—")</small></td>
                                <td>@inv.ServiceContract.Installation.SiteName</td>
                                <td><small class="text-muted">@inv.PeriodStart.ToString("dd/MM/yy") – @inv.PeriodEnd.ToString("dd/MM/yy")</small></td>
                                <td class="text-danger">
                                    @inv.DueDate.ToString("dd/MM/yyyy")
                                    <br /><small>เลยมาแล้ว @inv.DaysOverdue วัน</small>
                                </td>
                                <td class="text-end fw-bold">@inv.Amount.ToString("N0")</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="MarkPaid" class="d-inline"
                                          onsubmit="return confirm('บันทึกว่าใบแจ้งหนี้นี้ชำระแล้ว?')">
                                        <input type="hidden" name="invoiceId" value="@inv.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-check-lg"></i> ชำระแล้ว
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ═══ FILTERS ═══ -->
<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <input type="text" name="q" value="@Model.Q" class="form-control form-control-sm"
               style="max-width:260px" placeholder="ค้นหาเลขที่สัญญา / ไซต์ / ลูกค้า…" />
        <select name="status" class="form-select form-select-sm" style="width:auto">
            <option value="">ทุกสถานะ</option>
            @foreach (var s in Enum.GetValues<ContractStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@StatusLabel(s)</option>
            }
        </select>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="expiringOnly" value="true"
                   id="expiringOnly" @(Model.ExpiringOnly ? "checked" : "") />
            <label class="form-check-label small" for="expiringOnly">เฉพาะที่ใกล้หมดอายุ</label>
        </div>
        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-search"></i> ค้นหา
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Status.HasValue || Model.ExpiringOnly)
        {
            <a asp-page="/Contracts/Index" class="btn btn-sm btn-link">ล้างตัวกรอง</a>
        }
    </div>
</form>

<!-- ═══ CONTRACTS ═══ -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>สัญญา</th>
                        <th>ไซต์งาน / ลูกค้า</th>
                        <th>ระยะเวลา</th>
                        <th>รอบชำระ</th>
                        <th class="text-end">ค่าบริการ</th>
                        <th class="text-center">ค้างชำระ</th>
                        <th>สถานะ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Contracts)
                    {
                        var unpaid = c.Invoices.Count(i => i.PaidDate == null);
                        <tr class="@(c.NeedsAttention ? "table-warning" : "")">
                            <td>
                                <strong>@(c.ContractNumber ?? $"#{c.Id}")</strong>
                                @if (c.AutoRenew)
                                {
                                    <br /><small class="text-muted"><i class="bi bi-arrow-repeat"></i> ต่ออัตโนมัติ</small>
                                }
                            </td>
                            <td>
                                <a asp-page="/Installations/Detail" asp-route-id="@c.InstallationId"
                                   class="text-decoration-none"><strong>@c.Installation.SiteName</strong></a>
                                <br /><small class="text-muted">@c.Installation.Customer.FullName</small>
                            </td>
                            <td>
                                <small>@c.StartDate.ToString("dd/MM/yy") –
                                    @(c.EndDate?.ToString("dd/MM/yy") ?? "ไม่กำหนด")</small>
                                @if (c.DaysRemaining is { } days && c.Status == ContractStatus.Active)
                                {
                                    <br />
                                    <small class="@(days < 0 ? "text-danger fw-bold" : days <= 60 ? "text-warning" : "text-muted")">
                                        @(days < 0 ? $"หมดอายุแล้ว {-days} วัน" : $"เหลือ {days} วัน")
                                    </small>
                                }
                            </td>
                            <td><small>@CycleLabel(c.BillingCycle)</small></td>
                            <td class="text-end">
                                @c.FeePerCycle.ToString("N0")
                                @if (c.BillingCycle != ContractBillingCycle.Yearly && c.AnnualValue > 0)
                                {
                                    <br /><small class="text-muted">@c.AnnualValue.ToString("N0")/ปี</small>
                                }
                            </td>
                            <td class="text-center">
                                @if (unpaid > 0)
                                {
                                    <span class="badge bg-danger">@unpaid</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @StatusBadge(c.Status)">@StatusLabel(c.Status)</span></td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary invoice-btn" type="button"
                                        data-id="@c.Id" data-name="@c.Installation.SiteName"
                                        data-fee="@c.FeePerCycle"
                                        data-bs-toggle="modal" data-bs-target="#invoiceModal"
                                        title="ออกใบแจ้งหนี้">
                                    <i class="bi bi-receipt"></i>
                                </button>
                                <form method="post" asp-page-handler="Renew" class="d-inline"
                                      onsubmit="return confirm('ต่อสัญญานี้ออกไปอีก 1 รอบ?')">
                                    <input type="hidden" name="contractId" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="ต่อสัญญา">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </form>
                                @if (c.Status == ContractStatus.Active)
                                {
                                    <form method="post" asp-page-handler="SetStatus" class="d-inline"
                                          onsubmit="return confirm('ยกเลิกสัญญานี้?')">
                                        <input type="hidden" name="contractId" value="@c.Id" />
                                        <input type="hidden" name="newStatus" value="@ContractStatus.Terminated" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="ยกเลิกสัญญา">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Contracts.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">ไม่พบสัญญาตามเงื่อนไขที่เลือก</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ═══ CREATE CONTRACT ═══ -->
<div class="modal fade" id="createContractModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">เพิ่มสัญญาบริการ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">ไซต์งาน *</label>
                        <select name="installationId" class="form-select" required>
                            <option value="">-- เลือกไซต์งาน --</option>
                            @foreach (var s in Model.SiteOptions)
                            {
                                <option value="@s.Id">@s.SiteName (@s.Customer.FullName)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">เลขที่สัญญา</label>
                            <input name="contractNumber" class="form-control" maxlength="50"
                                   placeholder="ตามเอกสารที่ใช้อ้างอิงกับลูกค้า" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label">รอบชำระ *</label>
                            <select name="billingCycle" class="form-select" required>
                                @foreach (var cyc in Enum.GetValues<ContractBillingCycle>())
                                {
                                    <option value="@cyc" selected="@(cyc == ContractBillingCycle.Yearly)">@CycleLabel(cyc)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label">วันเริ่มสัญญา *</label>
                            <input name="startDate" type="date" class="form-control" required
                                   value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label">วันสิ้นสุด</label>
                            <input name="endDate" type="date" class="form-control" />
                            <small class="text-muted">เว้นว่าง = ไม่กำหนดวันสิ้นสุด</small>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label">ค่าบริการต่อรอบ (บาท) *</label>
                            <input name="feePerCycle" type="number" step="any" min="0" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="autoRenew" value="true" id="autoRenew" />
                        <label class="form-check-label" for="autoRenew">
                            ต่อสัญญาอัตโนมัติเมื่อครบกำหนด
                        </label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">หมายเหตุ</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-warning">บันทึกสัญญา</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══ ADD INVOICE ═══ -->
<div class="modal fade" id="invoiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddInvoice">
                <input type="hidden" name="contractId" id="invContractId" />
                <div class="modal-header">
                    <h5 class="modal-title">ออกใบแจ้งหนี้ — <span id="invSiteName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">เลขที่ใบแจ้งหนี้</label>
                        <input name="invoiceNumber" class="form-control" maxlength="50" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6 mb-2">
                            <label class="form-label">รอบบริการ เริ่ม *</label>
                            <input name="periodStart" type="date" class="form-control" required />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label">รอบบริการ ถึง *</label>
                            <input name="periodEnd" type="date" class="form-control" required />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label">ครบกำหนดชำระ *</label>
                            <input name="dueDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label">จำนวนเงิน (บาท) *</label>
                            <input name="amount" id="invAmount" type="number" step="any" min="0"
                                   class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">หมายเหตุ</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-warning">บันทึกใบแจ้งหนี้</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Prefill the invoice with the contract's own fee — the amount is
        // almost always exactly that, and retyping it is how a digit goes
        // missing.
        document.querySelectorAll('.invoice-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('invContractId').value = btn.dataset.id;
                document.getElementById('invSiteName').textContent = btn.dataset.name || '';
                document.getElementById('invAmount').value = btn.dataset.fee || '';
            });
        });
    </script>
}
