@page "/l/{code}"
@using SolarApp.Services.Notifications
@model SolarApp.Pages.LineLink.IndexModel
@{
    // Standalone page: the app layout assumes a signed-in user (menus, alert
    // bell) and this is opened by a customer who has never logged in.
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#06C755" />
    <title>ผูก LINE รับแจ้งเตือน - SolarApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f4f5f7; font-family: 'Sarabun', Tahoma, sans-serif; }
        .wrap { max-width: 440px; margin: 0 auto; padding: 16px; }
        .btn-line { background: #06C755; border-color: #06C755; color: #fff; }
        .btn-line:hover, .btn-line:focus { background: #05b14c; border-color: #05b14c; color: #fff; }
        .step { width: 28px; height: 28px; border-radius: 50%; background: #06C755; color: #fff;
                display: inline-flex; align-items: center; justify-content: center; font-weight: bold; flex: 0 0 28px; }
        .code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 1.6rem; letter-spacing: .2em; }
        #qr img, #qr canvas { margin: 0 auto; }
    </style>
</head>
<body>
<div class="wrap">
    <div class="text-center my-3">
        <div class="fs-3"><i class="bi bi-sun-fill text-warning"></i> SolarApp</div>
        <div class="text-muted small">รับแจ้งเตือนระบบโซลาร์เซลล์ทาง LINE</div>
    </div>

    @if (Model.Status == LineCodeStatus.Valid)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h5 class="mb-1">สวัสดีคุณ@(Model.FirstName)</h5>
                <p class="text-muted small mb-3">ทำ 2 ขั้นตอนด้านล่างบนโทรศัพท์ที่มี LINE เพื่อรับแจ้งเตือนเมื่อระบบมีปัญหา</p>

                @if (Model.BasicId == null)
                {
                    <div class="alert alert-warning small mb-0">
                        ระบบยังไม่พร้อมใช้งาน กรุณาแจ้งผู้ดูแลระบบ (ยังไม่ได้ตั้งค่า LINE Basic ID)
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 align-items-start mb-3">
                        <span class="step">1</span>
                        <div class="flex-grow-1">
                            <div class="fw-bold">เพิ่มเพื่อน LINE ของเรา</div>
                            <div class="small text-muted mb-2">@Model.BasicId — ถ้าเป็นเพื่อนอยู่แล้ว ข้ามไปขั้นที่ 2 ได้เลย</div>
                            <a href="@Model.AddFriendUrl" class="btn btn-line w-100 py-2">
                                <i class="bi bi-person-plus-fill"></i> เพิ่มเพื่อน
                            </a>
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-start">
                        <span class="step">2</span>
                        <div class="flex-grow-1">
                            <div class="fw-bold">ส่งรหัสยืนยัน</div>
                            <div class="small text-muted mb-2">กดแล้ว LINE จะเปิดแชทพร้อมข้อความ — กด <strong>ส่ง</strong> ได้เลย</div>
                            <a href="@Model.SendCodeUrl" class="btn btn-line w-100 py-2">
                                <i class="bi bi-send-fill"></i> ส่งรหัสยืนยัน
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body text-center">
                <div class="small text-muted">หรือพิมพ์ข้อความนี้ส่งในแชท LINE</div>
                <div class="code my-1">@Model.Code</div>
                <div class="small text-muted">
                    ใช้ได้ครั้งเดียว · หมดอายุ @Model.ExpiresAtLocal?.ToString("dd/MM/yyyy HH:mm") น.
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body text-center">
                <div class="small text-muted mb-2">เปิดหน้านี้บนคอมพิวเตอร์? สแกน QR นี้ด้วยโทรศัพท์</div>
                <div id="qr" class="d-inline-block p-2 bg-white"></div>
            </div>
        </div>
    }
    else
    {
        var (icon, color, title, body) = Model.Status switch
        {
            LineCodeStatus.Used => ("bi-check-circle-fill", "text-success", "ผูกบัญชีเรียบร้อยแล้ว",
                string.IsNullOrEmpty(Model.SiteName)
                    ? "ลิงก์นี้ถูกใช้ผูก LINE ไปแล้ว ท่านจะได้รับแจ้งเตือนทาง LINE ที่ผูกไว้"
                    : $"ลิงก์นี้ถูกใช้ผูก LINE กับไซต์ {Model.SiteName} ไปแล้ว"),
            LineCodeStatus.Expired => ("bi-hourglass-bottom", "text-warning", "ลิงก์หมดอายุแล้ว",
                "กรุณาขอลิงก์ผูก LINE ใหม่จากผู้ดูแลระบบ"),
            _ => ("bi-question-circle-fill", "text-secondary", "ไม่พบลิงก์นี้",
                "กรุณาตรวจสอบลิงก์อีกครั้ง หรือขอลิงก์ใหม่จากผู้ดูแลระบบ"),
        };
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi @icon @color" style="font-size: 3rem;"></i>
                <h5 class="mt-3">@title</h5>
                <p class="text-muted mb-0">@body</p>
            </div>
        </div>
    }

    <p class="text-center text-muted small mt-4">SolarApp · ระบบติดตามโซลาร์เซลล์</p>
</div>

@if (Model.Status == LineCodeStatus.Valid)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        (function () {
            var el = document.getElementById('qr');
            if (el && window.QRCode) {
                new QRCode(el, { text: @Json.Serialize(Model.LandingUrl), width: 180, height: 180, correctLevel: QRCode.CorrectLevel.M });
            }
        })();
    </script>
}
</body>
</html>
