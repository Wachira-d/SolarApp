@page
@model SolarApp.Pages.Maintenance.IndexModel
@{
    ViewData["Title"] = "Maintenance";
}

@if (Model.CleaningDue.Any())
{
    <div class="alert alert-warning mb-4">
        <h6><i class="bi bi-droplet-fill"></i> Panel Cleaning Due</h6>
        @foreach (var inst in Model.CleaningDue)
        {
            <div class="d-flex justify-content-between align-items-center py-1">
                <span>
                    <strong>@inst.SiteName</strong> -
                    Due: @inst.NextCleaningDueDate?.ToString("dd/MM/yyyy") |
                    Remaining: @inst.RemainingCleanings / @inst.TotalCleaningCount
                </span>
                <a asp-page="/Installations/Detail" asp-route-id="@inst.Id" class="btn btn-sm btn-outline-warning">View</a>
            </div>
        }
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h6 class="mb-0">Maintenance Records</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Site</th>
                    <th>Type</th>
                    <th>Scheduled</th>
                    <th>Completed</th>
                    <th>Status</th>
                    <th>By</th>
                    <th>Cost</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Records)
                {
                    <tr>
                        <td>@r.Installation.SiteName</td>
                        <td>@r.MaintenanceType</td>
                        <td>@r.ScheduledDate.ToString("dd/MM/yyyy")</td>
                        <td>@(r.CompletedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            <span class="badge @(r.Status == SolarApp.Models.Enums.MaintenanceStatus.Completed ? "bg-success" : r.Status == SolarApp.Models.Enums.MaintenanceStatus.Scheduled ? "bg-primary" : "bg-warning")">
                                @r.Status
                            </span>
                        </td>
                        <td>@(r.PerformedByUser?.FullName ?? "-")</td>
                        <td>@(r.Cost?.ToString("N0") ?? "-")</td>
                        <td><small>@(r.Notes ?? "-")</small></td>
                    </tr>
                }
                @if (!Model.Records.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No maintenance records</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
