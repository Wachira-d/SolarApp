@page
@model SolarApp.Pages.Maintenance.IndexModel
@{
    ViewData["Title"] = "การบำรุงรักษา";
}

<div class="d-flex justify-content-between mb-3">
    <h4>การบำรุงรักษา</h4>
    @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
    {
        <a asp-page="Create" class="btn btn-warning btn-sm">
            <i class="bi bi-plus-lg"></i> เพิ่มงานบำรุงรักษา
        </a>
    }
</div>

@{
    // "18/09/2025" alone doesn't say whether that's a fortnight late or a
    // year. The number of days is the thing that decides what to do today.
    string OverdueText(DateTime? due)
    {
        if (!due.HasValue) return "";
        var days = (int)Math.Floor((SolarApp.Services.SiteTime.Today - due.Value.Date).TotalDays);
        return days > 0 ? $"เลยกำหนด {days} วัน" : days == 0 ? "ครบกำหนดวันนี้" : "";
    }
}

@if (Model.CleaningDue.Any())
{
    <div class="card border-warning border-2 shadow-sm mb-4">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <span><i class="bi bi-droplet-fill"></i> ครบกำหนดล้างแผง</span>
            <span class="badge bg-dark">@Model.CleaningDue.Count ไซต์</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ไซต์งาน</th><th>ลูกค้า</th><th>กำหนด</th>
                            <th class="text-center">คงเหลือ</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in Model.CleaningDue)
                        {
                            var overdueDays = inst.NextCleaningDueDate.HasValue
                                ? (int)Math.Floor((SolarApp.Services.SiteTime.Today - inst.NextCleaningDueDate.Value.Date).TotalDays)
                                : 0;
                            <tr>
                                <td><strong>@inst.SiteName</strong></td>
                                <td><small class="text-muted">@inst.Customer?.FullName</small></td>
                                <td>
                                    @inst.NextCleaningDueDate?.ToString("dd/MM/yyyy")
                                    <br />
                                    <small class="@(overdueDays > 90 ? "text-danger fw-bold" : "text-warning")">
                                        @OverdueText(inst.NextCleaningDueDate)
                                    </small>
                                </td>
                                <td class="text-center">@(inst.TotalCleaningCount > 0 ? $"{inst.RemainingCleanings} / {inst.TotalCleaningCount}" : "ตามรอบ")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-page="/Installations/Cleaning" asp-route-id="@inst.Id"
                                       class="btn btn-sm btn-warning">บันทึกการล้าง</a>
                                    <a asp-page="/Installations/Detail" asp-route-id="@inst.Id"
                                       class="btn btn-sm btn-outline-secondary">ดู</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}


<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h6 class="mb-0">รายการบำรุงรักษา</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ไซต์งาน</th>
                        <th>ประเภท</th>
                        <th>วันที่นัด</th>
                        <th>วันที่ทำ</th>
                        <th>สถานะ</th>
                        <th>ผู้ดำเนินการ</th>
                        <th>ค่าใช้จ่าย</th>
                        <th>หมายเหตุ</th>
                        @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
                        {
                            <th class="text-end">การจัดการ</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        var statusLabel = r.Status switch
                        {
                            SolarApp.Models.Enums.MaintenanceStatus.Scheduled => "นัดหมายแล้ว",
                            SolarApp.Models.Enums.MaintenanceStatus.InProgress => "กำลังดำเนินการ",
                            SolarApp.Models.Enums.MaintenanceStatus.Completed => "เสร็จสิ้น",
                            SolarApp.Models.Enums.MaintenanceStatus.Cancelled => "ยกเลิก",
                            _ => r.Status.ToString()
                        };
                        var typeLabel = r.MaintenanceType switch
                        {
                            SolarApp.Models.Enums.MaintenanceType.PanelCleaning => "ล้างแผง",
                            SolarApp.Models.Enums.MaintenanceType.Inspection => "ตรวจสอบ",
                            SolarApp.Models.Enums.MaintenanceType.Repair => "ซ่อม",
                            SolarApp.Models.Enums.MaintenanceType.Replacement => "เปลี่ยน",
                            SolarApp.Models.Enums.MaintenanceType.GeneralMaintenance => "บำรุงทั่วไป",
                            _ => r.MaintenanceType.ToString()
                        };
                        <tr>
                            <td>@r.Installation.SiteName</td>
                            <td>@typeLabel</td>
                            <td>@r.ScheduledDate.ToString("dd/MM/yyyy")</td>
                            <td>@(r.CompletedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <span class="badge @(r.Status == SolarApp.Models.Enums.MaintenanceStatus.Completed ? "bg-success" : r.Status == SolarApp.Models.Enums.MaintenanceStatus.Scheduled ? "bg-primary" : "bg-warning")">
                                    @statusLabel
                                </span>
                            </td>
                            <td>@(r.PerformedByUser?.FullName ?? "-")</td>
                            <td>@(r.Cost?.ToString("N0") ?? "-")</td>
                            <td><small>@(r.Notes ?? "-")</small></td>
                            @if (User.IsInRole("Admin") || User.IsInRole("Partner"))
                            {
                                <td class="text-end">
                                    <a asp-page="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                    @if (!Model.Records.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">ยังไม่มีรายการบำรุงรักษา</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
