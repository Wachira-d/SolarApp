@page "{id:int}"
@model SolarApp.Pages.Maintenance.EditModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "แก้ไขบำรุงรักษา";
}

<div class="d-flex justify-content-between mb-3">
    <h4>แก้ไขรายการบำรุงรักษา</h4>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> กลับ
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ประเภทงาน</label>
                            <select asp-for="Input.MaintenanceType" asp-items="Html.GetEnumSelectList<MaintenanceType>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">สถานะ</label>
                            <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<MaintenanceStatus>()" class="form-select"></select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">หมวดหมู่</label>
                            <input asp-for="Input.Category" class="form-control" list="categoryList"
                                   placeholder="เช่น ปัญหาอินเวอร์เตอร์, การเชื่อมต่อกริด" />
                            <datalist id="categoryList">
                                <option value="Inverter Issue" />
                                <option value="Panel Cleaning" />
                                <option value="Panel Damage" />
                                <option value="Grid Connection" />
                                <option value="Wiring" />
                                <option value="Battery Issue" />
                                <option value="Monitoring System" />
                                <option value="Routine Inspection" />
                            </datalist>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">ตำแหน่ง</label>
                            <input asp-for="Input.Location" class="form-control" placeholder="เช่น หลังคา - ฝั่งตะวันออก" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">รายละเอียด *</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">วันที่นัดหมาย</label>
                            <input asp-for="Input.ScheduledDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">วันที่เสร็จงาน</label>
                            <input asp-for="Input.CompletedDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ค่าใช้จ่าย (บาท)</label>
                            <input asp-for="Input.Cost" class="form-control" type="number" step="any" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ผู้ดำเนินการ</label>
                        <select asp-for="Input.PerformedByUserId" asp-items="Model.Performers" class="form-select">
                            <option value="">-- ยังไม่มอบหมาย --</option>
                        </select>
                    </div>

                    <hr />
                    <h6 class="mb-3"><i class="bi bi-camera"></i> รูปภาพและไฟล์แนบ</h6>

                    <!-- Before Photos -->
                    <div class="mb-3">
                        <label class="form-label">รูปก่อนดำเนินการ</label>
                        @if (Model.Record.BeforePhotoList.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var url in Model.Record.BeforePhotoList)
                                {
                                    <div class="position-relative" style="width:120px">
                                        <a href="@url" target="_blank">
                                            <img src="@url" class="img-thumbnail" style="width:120px;height:120px;object-fit:cover" />
                                        </a>
                                        <form method="post" asp-page-handler="RemovePhoto" class="position-absolute top-0 end-0">
                                            <input type="hidden" name="id" value="@Model.Record.Id" />
                                            <input type="hidden" name="url" value="@url" />
                                            <input type="hidden" name="kind" value="before" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-circle"
                                                    style="width:24px;height:24px;padding:0;font-size:12px"
                                                    onclick="return confirm('ลบรูปนี้?');">×</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        <input type="file" name="BeforePhotoFiles" class="form-control" multiple accept="image/*" />
                        <small class="text-muted">เลือกได้หลายรูป (jpg, png, webp)</small>
                    </div>

                    <!-- After Photos -->
                    <div class="mb-3">
                        <label class="form-label">รูปหลังดำเนินการ</label>
                        @if (Model.Record.AfterPhotoList.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var url in Model.Record.AfterPhotoList)
                                {
                                    <div class="position-relative" style="width:120px">
                                        <a href="@url" target="_blank">
                                            <img src="@url" class="img-thumbnail" style="width:120px;height:120px;object-fit:cover" />
                                        </a>
                                        <form method="post" asp-page-handler="RemovePhoto" class="position-absolute top-0 end-0">
                                            <input type="hidden" name="id" value="@Model.Record.Id" />
                                            <input type="hidden" name="url" value="@url" />
                                            <input type="hidden" name="kind" value="after" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-circle"
                                                    style="width:24px;height:24px;padding:0;font-size:12px"
                                                    onclick="return confirm('ลบรูปนี้?');">×</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        <input type="file" name="AfterPhotoFiles" class="form-control" multiple accept="image/*" />
                    </div>

                    <!-- Attachments (documents) -->
                    <div class="mb-3">
                        <label class="form-label">ไฟล์แนบ (PDF/Word/Excel)</label>
                        @if (Model.Record.AttachmentList.Any())
                        {
                            <ul class="list-unstyled mb-2">
                                @foreach (var url in Model.Record.AttachmentList)
                                {
                                    <li class="d-flex align-items-center mb-1">
                                        <a href="@url" target="_blank" class="me-2">
                                            <i class="bi bi-file-earmark"></i> @System.IO.Path.GetFileName(url)
                                        </a>
                                        <form method="post" asp-page-handler="RemovePhoto" class="d-inline">
                                            <input type="hidden" name="id" value="@Model.Record.Id" />
                                            <input type="hidden" name="url" value="@url" />
                                            <input type="hidden" name="kind" value="attach" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1"
                                                    onclick="return confirm('ลบไฟล์นี้?');">×</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        <input type="file" name="AttachmentFiles" class="form-control" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv" />
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label">หมายเหตุ</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> บันทึก
                        </button>
                        @if (Model.Record.Status != MaintenanceStatus.Completed)
                        {
                            <button type="submit" asp-page-handler="Complete" asp-route-id="@Model.Record.Id"
                                    class="btn btn-success"
                                    onclick="return confirm('ทำเครื่องหมายว่างานนี้เสร็จแล้ว?');">
                                <i class="bi bi-check-circle"></i> ปิดงาน
                            </button>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="submit" asp-page-handler="Delete" asp-route-id="@Model.Record.Id"
                                    class="btn btn-outline-danger ms-auto"
                                    onclick="return confirm('ลบรายการบำรุงรักษานี้?');">
                                <i class="bi bi-trash"></i> ลบ
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">ข้อมูลไซต์งาน</h6></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted">ไซต์งาน</td><td>@Model.Record.Installation.SiteName</td></tr>
                        <tr><td class="text-muted">ลูกค้า</td><td>@Model.Record.Installation.Customer.FullName</td></tr>
                        <tr><td class="text-muted">สร้างเมื่อ</td><td>@Model.Record.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
