@page
@model SolarApp.Pages.MyHome.IndexModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "My Solar";
}

@if (Model.Customer == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-info-circle"></i>
        บัญชีของคุณยังไม่ได้ผูกกับโปรไฟล์ลูกค้า กรุณาติดต่อผู้ติดตั้ง
    </div>
}
else
{
    <div class="mb-3">
        <h4 class="mb-0"><i class="bi bi-sun-fill text-warning"></i> สวัสดีคุณ @Model.Customer.FirstName</h4>
        <small class="text-muted">@Model.Sites.Count ไซต์</small>
    </div>

    @if (!Model.Sites.Any())
    {
        <div class="alert alert-info">ยังไม่มีระบบโซลาร์ที่ผูกกับบัญชีของคุณ</div>
    }

    @foreach (var site in Model.Sites)
{
    var inst = site.Installation;
    var statusColor = inst.Status == InstallationStatus.Active ? "success"
                    : inst.Status == InstallationStatus.Offline ? "danger"
                    : inst.Status == InstallationStatus.Maintenance ? "warning" : "secondary";

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0">@inst.SiteName</h5>
                <small class="text-muted">@inst.SystemCapacityKw kW · @inst.InverterBrand</small>
            </div>
            <div>
                <span class="badge bg-@statusColor">@inst.Status</span>
                <span class="badge bg-@site.Performance.HealthColor">Grade @site.Performance.HealthGrade</span>
            </div>
        </div>

        <div class="card-body">
            <!-- Big numbers -->
            <div class="row g-2 text-center mb-3">
                <div class="col-6 col-md-3">
                    <div class="p-2 bg-body-secondary rounded">
                        <div class="text-muted small">ขณะนี้</div>
                        <div class="fs-3 fw-bold text-success">
                            @((site.CurrentPowerKw ?? 0).ToString("0.00"))
                            <small class="fs-6">kW</small>
                        </div>
                        @if (site.BatterySoc.HasValue)
                        { <small class="text-muted">🔋 @site.BatterySoc.Value.ToString("0")%</small> }
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 bg-body-secondary rounded">
                        <div class="text-muted small">วันนี้</div>
                        <div class="fs-3 fw-bold">@site.TodayKwh.ToString("0.0") <small class="fs-6">kWh</small></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 bg-body-secondary rounded">
                        <div class="text-muted small">7 วันที่ผ่านมา</div>
                        <div class="fs-3 fw-bold">@site.Last7dKwh.ToString("N0") <small class="fs-6">kWh</small></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 bg-body-secondary rounded">
                        <div class="text-muted small">30 วันที่ผ่านมา</div>
                        <div class="fs-3 fw-bold">@site.Last30dKwh.ToString("N0") <small class="fs-6">kWh</small></div>
                    </div>
                </div>
            </div>

            <!-- Savings -->
            <div class="alert alert-success mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <i class="bi bi-piggy-bank fs-4"></i>
                    <strong>ประหยัดประมาณ (30 วัน):</strong>
                </div>
                <div class="fs-5 fw-bold">
                    ฿@((site.Performance.EstimatedSavings + site.Performance.EstimatedRevenue).ToString("N0"))
                </div>
            </div>

            <!-- Lifetime + alerts -->
            <div class="row g-2 small">
                <div class="col-6">
                    <span class="text-muted">ผลิตสะสมตลอดอายุ:</span>
                    <strong>@site.LifetimeKwh.ToString("N0") kWh</strong>
                </div>
                <div class="col-6 text-end">
                    @if (site.UnresolvedAlerts > 0)
                    {
                        <span class="badge bg-danger">@site.UnresolvedAlerts แจ้งเตือน</span>
                    }
                    else
                    {
                        <span class="text-success"><i class="bi bi-check-circle"></i> ปกติดี</span>
                    }
                </div>
            </div>

            @if (site.Performance.Recommendations.Any())
            {
                <hr />
                <div class="small">
                    <strong>คำแนะนำ:</strong>
                    <ul class="mb-0">
                        @foreach (var tip in site.Performance.Recommendations)
                        { <li>@tip</li> }
                    </ul>
                </div>
            }
            </div>
        </div>
    }

    <div class="text-center text-muted small mt-3">
        <a asp-page="/WorkOrders/Index" class="btn btn-outline-primary btn-sm me-3">
            <i class="bi bi-clipboard2-check"></i> ดูใบสั่งงาน / รูปภาพ
        </a>
        <i class="bi bi-shield-check"></i> ข้อมูลของคุณเป็นส่วนตัว — มีเพียงคุณและผู้ติดตั้งเท่านั้นที่เห็น
    </div>
}
