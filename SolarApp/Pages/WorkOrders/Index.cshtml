@page
@model SolarApp.Pages.WorkOrders.IndexModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "ใบสั่งงาน";
}

@if (!string.IsNullOrEmpty(Model.TableError))
{
    <div class="alert alert-danger alert-permanent">
        <i class="bi bi-exclamation-triangle"></i> @Model.TableError
    </div>
    return;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-clipboard2-check"></i> ใบสั่งงาน</h4>
        <small class="text-muted">ล้างแผง, PM, ซ่อม, งานนอกระบบ</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Calendar" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar3"></i> ปฏิทิน
        </a>
        <a asp-page="Create" class="btn btn-warning btn-sm">
            <i class="bi bi-plus-circle"></i> สร้างใบสั่งงาน
        </a>
    </div>
</div>

<!-- KPI -->
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100"><div class="card-body py-2">
            <div class="fs-4 fw-bold">@Model.TotalCount</div><small class="text-muted">ทั้งหมด</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100 @(Model.OverdueCount > 0 ? "border-danger border-2" : "")"><div class="card-body py-2">
            <div class="fs-4 fw-bold text-danger">@Model.OverdueCount</div><small class="text-muted">เลยกำหนด</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100"><div class="card-body py-2">
            <div class="fs-4 fw-bold text-primary">@Model.TodayCount</div><small class="text-muted">วันนี้</small>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100"><div class="card-body py-2">
            <div class="fs-4 fw-bold text-info">@Model.ThisWeekCount</div><small class="text-muted">สัปดาห์นี้</small>
        </div></div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <select asp-for="StatusFilter" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<WorkOrderStatus>()">
                    <option value="">สถานะทั้งหมด</option>
                </select>
            </div>
            <div class="col-auto">
                <select asp-for="TypeFilter" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<WorkOrderType>()">
                    <option value="">ประเภททั้งหมด</option>
                </select>
            </div>
            <div class="col-auto">
                <input asp-for="FromDate" type="date" class="form-control form-control-sm" placeholder="ตั้งแต่" />
            </div>
            <div class="col-auto">
                <input asp-for="ToDate" type="date" class="form-control form-control-sm" placeholder="ถึง" />
            </div>
            <div class="col">
                <input asp-for="Search" class="form-control form-control-sm" placeholder="ค้นหาเลข WO / หัวเรื่อง / ไซต์..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i></button>
                <a asp-page="Index" class="btn btn-sm btn-outline-secondary">ล้าง</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>เลขที่</th>
                        <th>ประเภท</th>
                        <th>ไซต์งาน</th>
                        <th>วันที่นัด</th>
                        <th>ช่างที่รับผิดชอบ</th>
                        <th>สถานะ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5">
                            <i class="bi bi-clipboard-check text-muted d-block mb-2" style="font-size:3rem"></i>
                            <h6 class="mb-1">ยังไม่มีใบสั่งงาน</h6>
                            <p class="text-muted small mb-3">สร้างใบสั่งงานเพื่อมอบหมายภารกิจ Maintenance หรือ Inspection ให้ทีมงาน</p>
                            <a asp-page="Create" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-lg"></i> สร้างใบสั่งงาน
                            </a>
                        </td></tr>
                    }
                    @foreach (var wo in Model.Orders)
                    {
                        <tr class="@(wo.IsOverdue ? "table-danger" : "")">
                            <td><strong>@wo.WorkOrderNumber</strong></td>
                            <td><small>@wo.Type</small></td>
                            <td>
                                <div class="text-truncate" style="max-width:200px">
                                    @wo.SiteName
                                    @if (wo.IsStandalone)
                                    { <span class="badge bg-info ms-1">อิสระ</span> }
                                </div>
                            </td>
                            <td>
                                <small>@wo.ScheduledDate.ToString("dd/MM/yy")</small>
                                @if (wo.ScheduledTime.HasValue)
                                { <small class="text-muted">@wo.ScheduledTime.Value.ToString(@"hh\:mm")</small> }
                            </td>
                            <td><small>@(wo.AssignedToUser?.FullName ?? wo.AssignedTeam ?? "-")</small></td>
                            <td><span class="badge @wo.StatusBadgeClass">@wo.Status</span></td>
                            <td>
                                <a asp-page="Detail" asp-route-id="@wo.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
