@page
@model SolarApp.Pages.WorkOrders.CalendarModel
@{
    ViewData["Title"] = "ปฏิทินใบสั่งงาน";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
<style>
    #woCalendar { min-height: 600px; }
    html[data-theme="dark"] .fc { --fc-bg-color: var(--app-surface); --fc-border-color: var(--app-border); color: var(--app-text); }
    html[data-theme="dark"] .fc .fc-col-header-cell, html[data-theme="dark"] .fc .fc-daygrid-day { background: var(--app-surface); }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-calendar3"></i> Work Order Calendar</h4>
        <small class="text-muted">
            <span style="color:#0d6efd">●</span> Scheduled
            <span style="color:#ffc107">●</span> In Progress
            <span style="color:#198754">●</span> Completed
            <span style="color:#dc3545">●</span> Overdue
        </small>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list"></i> List</a>
        <a asp-page="Create" class="btn btn-warning btn-sm"><i class="bi bi-plus-circle"></i> New</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div id="woCalendar"></div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var events = @Html.Raw(Model.EventsJson);
    var cal = new FullCalendar.Calendar(document.getElementById('woCalendar'), {
        initialView: window.innerWidth < 768 ? 'listMonth' : 'dayGridMonth',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,listMonth'
        },
        locale: '@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName',
        events: events,
        eventClick: function (info) {
            info.jsEvent.preventDefault();
            if (info.event.url) window.location.href = info.event.url;
        },
        height: 'auto'
    });
    cal.render();
});
</script>
}
