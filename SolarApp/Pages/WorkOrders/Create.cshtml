@page
@model SolarApp.Pages.WorkOrders.CreateModel
@using SolarApp.Models.Enums
@using System.Text.Json
@{
    var quick = Model.LockedSite != null;
    var site = Model.LockedSite;
    ViewData["Title"] = quick ? $"บันทึกการเข้าบริการ - {site!.SiteName}" : "บันทึกการเข้าบริการ";
    var typeDefaultsJson = JsonSerializer.Serialize(Model.TypeDefaults);
    var kindsJson = JsonSerializer.Serialize(SolarApp.Pages.WorkOrders.CreateModel.VisitKinds
        .ToDictionary(k => k.Key, k => new { type = (int)k.Type, cleaning = k.Cleaning, label = k.Label }));
    var done = Model.Input.MarkCompleted;
    var cleaningNotInScope = quick && !site!.HasCleaningInScope;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-clipboard2-check"></i> บันทึกการเข้าบริการ</h4>
        @if (quick)
        {
            <div class="text-muted">
                <i class="bi bi-house-gear"></i> <strong>@site!.SiteName</strong>
                @if (site.Customer != null) { <span>· @site.Customer.FullName</span> }
            </div>
        }
        else
        {
            <small class="text-muted">ล้างแผง · บำรุงรักษา · ซ่อม — บันทึกงานที่ทำแล้ว หรือนัดล่วงหน้า</small>
        }
    </div>
    @if (quick)
    {
        <a asp-page="/Installations/Detail" asp-route-id="@site!.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> กลับหน้าไซต์
        </a>
    }
    else
    {
        <a asp-page="/Jobs/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> กลับ</a>
    }
</div>

@if (Model.SourceTicket != null)
{
    <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="bi bi-ticket-detailed fs-5"></i>
        <div>
            จากเรื่องแจ้งซ่อม <strong>@Model.SourceTicket.TicketNumber</strong> — @Model.SourceTicket.Subject
            <div class="small text-muted">เมื่องานนี้เสร็จ เรื่องแจ้งซ่อมจะถูกตั้งเป็น "แก้ไขแล้ว" ให้อัตโนมัติ</div>
        </div>
    </div>
}

<form method="post" enctype="multipart/form-data" id="woForm">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }
    <input type="hidden" asp-for="Input.ServiceTicketId" />
    @if (quick)
    {
        <input type="hidden" asp-for="Input.InstallationId" />
    }

    <div class="row g-3">
        <div class="col-lg-7">
            @* ── 1. Done already, or booking ahead? Done is the usual case. ── *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Input.MarkCompleted" id="mode-done" value="true"
                                   checked="@done" autocomplete="off" />
                            <label class="btn btn-outline-success w-100 py-2" for="mode-done">
                                <i class="bi bi-check2-circle"></i> ทำเสร็จแล้ว
                                <small class="d-block">บันทึกงานที่เข้าไปทำมา</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Input.MarkCompleted" id="mode-plan" value="false"
                                   checked="@(!done)" autocomplete="off" />
                            <label class="btn btn-outline-primary w-100 py-2" for="mode-plan">
                                <i class="bi bi-calendar-plus"></i> นัดล่วงหน้า
                                <small class="d-block">ยังไม่ได้เข้าไปทำ</small>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            @* ── 2. What was done ── *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">งานที่ทำ</h6></div>
                <div class="card-body">
                    <div class="row g-2" id="kindTiles">
                        @foreach (var k in SolarApp.Pages.WorkOrders.CreateModel.VisitKinds
                                     .Where(k => k.Common || !quick || k.Key == Model.Input.VisitKind))
                        {
                            var id = $"kind-{k.Key}";
                            <div class="@(k.Key == "pm_clean" ? "col-12 col-md-6" : "col-6 col-md-3")">
                                <input type="radio" class="btn-check" name="Input.VisitKind" id="@id" value="@k.Key"
                                       checked="@(Model.Input.VisitKind == k.Key)" autocomplete="off" />
                                <label class="btn btn-outline-primary w-100 h-100 py-3 d-flex flex-column align-items-center gap-1" for="@id">
                                    <i class="bi bi-@k.Icon fs-4"></i>
                                    <span class="small fw-semibold">@k.Label</span>
                                    @if (k.Key == "pm_clean") { <small class="text-muted">รอบตามสัญญา — นับครั้งล้างให้ด้วย</small> }
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Input.VisitKind" class="text-danger small"></span>
                    @if (cleaningNotInScope)
                    {
                        <div class="small text-muted mt-2" id="cleanScopeNote">
                            <i class="bi bi-info-circle"></i> ไซต์นี้ไม่อยู่ในสัญญาล้างแผง — บันทึกการล้างได้ (งานครั้งเดียว) แต่ระบบจะไม่ตั้งรอบถัดไป
                        </div>
                    }
                </div>
            </div>

            @* ── 3. Site (only when not opened from one) ── *@
            @if (!quick)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white"><h6 class="mb-0">ไซต์งาน <span class="text-danger">*</span></h6></div>
                    <div class="card-body">
                        <ul class="nav nav-pills mb-3" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabLinked" type="button">
                                    <i class="bi bi-link-45deg"></i> ไซต์ในระบบ
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabStandalone" type="button">
                                    <i class="bi bi-building"></i> ไซต์นอกระบบ
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="tabLinked">
                                <select asp-for="Input.InstallationId" class="form-select">
                                    <option value="">— เลือกไซต์ —</option>
                                    @foreach (var i in Model.Installations) { <option value="@i.Value">@i.Text</option> }
                                </select>
                                <span asp-validation-for="Input.InstallationId" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">
                                    เคล็ดลับ: เปิดจากหน้าไซต์ (ปุ่ม "บันทึกการเข้าบริการ") จะเลือกไซต์และงานตามสัญญาให้อัตโนมัติ
                                </small>
                            </div>
                            <div class="tab-pane fade" id="tabStandalone">
                                <small class="text-muted d-block mb-2">สำหรับไซต์ที่ยังไม่อยู่ในระบบ (ลูกค้าใหม่, งานครั้งเดียว)</small>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label">ชื่อไซต์ *</label>
                                        <input asp-for="Input.ExternalSiteName" class="form-control" placeholder="เช่น บ้านคุณสมชาย" />
                                        <span asp-validation-for="Input.ExternalSiteName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">ชื่อลูกค้า</label>
                                        <input asp-for="Input.ExternalCustomerName" class="form-control" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label">ที่อยู่</label>
                                        <input asp-for="Input.ExternalSiteAddress" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">เบอร์โทร</label>
                                        <input asp-for="Input.ExternalCustomerPhone" class="form-control" type="tel" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label">ละติจูด</label>
                                        <input asp-for="Input.ExternalLatitude" type="number" step="any" class="form-control" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label">ลองจิจูด</label>
                                        <input asp-for="Input.ExternalLongitude" type="number" step="any" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── 4. When, who, what was found ── *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">รายละเอียด</h6></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><span class="date-label">@(done ? "วันที่เข้าทำ" : "วันที่นัด")</span> *</label>
                            <input asp-for="Input.ScheduledDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.ScheduledDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ผู้เข้าทำงาน</label>
                            <select asp-for="Input.AssignedToUserId" class="form-select">
                                <option value="">(ไม่ระบุ)</option>
                                @foreach (var u in Model.Users) { <option value="@u.Value">@u.Text</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">หัวข้อ *</label>
                            <input asp-for="Input.Title" class="form-control" />
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12 done-only @(done ? "" : "d-none")">
                            <label class="form-label">สิ่งที่ทำ / สิ่งที่พบ</label>
                            <textarea asp-for="Input.CompletionNotes" class="form-control" rows="3"
                                      placeholder="เช่น ล้างแผง 486 แผ่น, ขันขั้วต่อ MC4 string 3, วัดค่าฉนวนปกติ"></textarea>
                        </div>
                        <div class="col-md-6 done-only @(done ? "" : "d-none")">
                            <label class="form-label"><i class="bi bi-camera"></i> รูปก่อนทำ</label>
                            <input type="file" name="BeforePhotoFiles" class="form-control" multiple accept="image/*" />
                        </div>
                        <div class="col-md-6 done-only @(done ? "" : "d-none")">
                            <label class="form-label"><i class="bi bi-camera-fill"></i> รูปหลังทำ</label>
                            <input type="file" name="AfterPhotoFiles" class="form-control" multiple accept="image/*" />
                        </div>

                        <div class="col-12 plan-only @(done ? "d-none" : "")">
                            <label class="form-label">สิ่งที่ต้องทำ</label>
                            <textarea asp-for="Input.Description" class="form-control" rows="3"
                                      placeholder="เช่น อินเวอร์เตอร์ 2 ขึ้น error E031 ตรวจสาย DC"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <a class="small" data-bs-toggle="collapse" href="#checklistBox" role="button">
                                <i class="bi bi-list-check"></i> รายการตรวจสอบ (checklist)
                            </a>
                            <div class="collapse @(done ? "" : "show")" id="checklistBox">
                                <textarea asp-for="Input.ChecklistItems" class="form-control mt-1" rows="5"></textarea>
                                <small class="text-muted">1 รายการต่อบรรทัด · งานที่ "ทำเสร็จแล้ว" จะติ๊กครบให้</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-3">
                <button class="card-header bg-white w-100 text-start border-0 d-flex justify-content-between align-items-center"
                        type="button" data-bs-toggle="collapse" data-bs-target="#advanced">
                    <h6 class="mb-0"><i class="bi bi-sliders"></i> ตัวเลือกเพิ่มเติม</h6>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="advanced">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label">เวลา</label>
                                <input asp-for="Input.ScheduledTimeStr" type="time" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">ใช้เวลา (นาที)</label>
                                <input asp-for="Input.EstimatedDurationMinutes" type="number" min="15" step="15" class="form-control" />
                                <span asp-validation-for="Input.EstimatedDurationMinutes" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 plan-only @(done ? "d-none" : "")">
                                <label class="form-label">ทำซ้ำทุก (เดือน)</label>
                                <input asp-for="Input.RecurrenceMonths" type="number" min="0" max="120" class="form-control" placeholder="เว้นว่าง = ครั้งเดียว" />
                                <span asp-validation-for="Input.RecurrenceMonths" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ทีม / ผู้รับเหมา</label>
                                <input asp-for="Input.AssignedTeam" class="form-control" placeholder="เช่น ทีมล้าง A" />
                            </div>
                            <div class="col-12 plan-only @(done ? "d-none" : "")">
                                <label class="form-label">หมายเหตุพิเศษ (กุญแจ, ผู้ติดต่อ, ข้อควรระวัง)</label>
                                <textarea asp-for="Input.SpecialInstructions" class="form-control" rows="2"></textarea>
                            </div>
                            @if (!quick)
                            {
                                <div class="col-12">
                                    <label class="form-label">ลูกค้า (สำหรับออกบิล)</label>
                                    <select asp-for="Input.CustomerId" class="form-select">
                                        <option value="">(ไม่ผูกลูกค้า)</option>
                                        @foreach (var c in Model.Customers) { <option value="@c.Value">@c.Text</option> }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-none d-lg-block">
                <button type="submit" class="btn btn-warning btn-lg w-100">
                    <i class="bi bi-check2-circle"></i> <span class="submit-label">@(done ? "บันทึกการเข้าบริการ" : "บันทึกนัดหมาย")</span>
                </button>
            </div>
        </div>
    </div>

    @* Sticky on phones: the form is long and the save button was at the end of it. *@
    <div class="d-lg-none position-sticky bottom-0 py-2 mt-3"
         style="background:var(--app-bg, #f5f6fa); box-shadow:0 -4px 12px rgba(0,0,0,.08)">
        <button type="submit" class="btn btn-warning btn-lg w-100">
            <i class="bi bi-check2-circle"></i> <span class="submit-label">@(done ? "บันทึกการเข้าบริการ" : "บันทึกนัดหมาย")</span>
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Per-type defaults for Title + Checklist, from Admin → ค่ามาตรฐานใบสั่งงาน.
        const WO_DEFAULTS = @Html.Raw(typeDefaultsJson);
        const KINDS = @Html.Raw(kindsJson);
        const CLEANING_TYPE = 1, OTHER = 99;

        // Title + checklist follow the chosen kind; a cleaning-included PM
        // gets both checklists. Anything typed by hand (or copied from a
        // ticket) is kept: only empty fields or the previous default change.
        (function () {
            const titleEl = document.querySelector('[name="Input.Title"]');
            const checkEl = document.querySelector('[name="Input.ChecklistItems"]');
            if (!titleEl || !checkEl) return;
            let lastTitle = titleEl.value, lastChecklist = checkEl.value;

            function defaultsFor(key) {
                const k = KINDS[key] || { type: OTHER, cleaning: false, label: '' };
                const d = WO_DEFAULTS[k.type] || WO_DEFAULTS[OTHER] || { title: '', checklist: '' };
                if (!k.cleaning) return { title: d.title || k.label, checklist: d.checklist || '' };
                const c = WO_DEFAULTS[CLEANING_TYPE] || { checklist: '' };
                return {
                    title: k.label,
                    checklist: [d.checklist, c.checklist].filter(x => x && x.trim()).join('\n')
                };
            }
            function apply() {
                const r = document.querySelector('input[name="Input.VisitKind"]:checked');
                const d = defaultsFor(r ? r.value : 'other');
                if (titleEl.value.trim() === '' || titleEl.value === lastTitle) { titleEl.value = d.title; lastTitle = d.title; }
                if (checkEl.value.trim() === '' || checkEl.value === lastChecklist) { checkEl.value = d.checklist; lastChecklist = d.checklist; }
            }
            apply();
            document.querySelectorAll('input[name="Input.VisitKind"]').forEach(r => r.addEventListener('change', apply));
        })();

        // Done vs planned: swap the fields that only make sense for one of them.
        (function () {
            const date = document.querySelector('[name="Input.ScheduledDate"]');
            function sync() {
                const done = document.getElementById('mode-done')?.checked;
                document.querySelectorAll('.done-only').forEach(e => e.classList.toggle('d-none', !done));
                document.querySelectorAll('.plan-only').forEach(e => e.classList.toggle('d-none', !!done));
                document.querySelectorAll('.submit-label').forEach(l => l.textContent = done ? 'บันทึกการเข้าบริการ' : 'บันทึกนัดหมาย');
                document.querySelectorAll('.date-label').forEach(l => l.textContent = done ? 'วันที่เข้าทำ' : 'วันที่นัด');
                // Local date — toISOString() is UTC, which in Thailand kept
                // "today" unpickable until 07:00.
                const n = new Date();
                const today = `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, '0')}-${String(n.getDate()).padStart(2, '0')}`;
                if (date) date.max = done ? today : '';
            }
            document.querySelectorAll('input[name="Input.MarkCompleted"]').forEach(r => r.addEventListener('change', sync));
            sync();
        })();

        // Re-open the standalone tab after a validation round-trip.
        (function () {
            const standaloneName = document.querySelector('[name="Input.ExternalSiteName"]')?.value;
            const linkedId = document.querySelector('select[name="Input.InstallationId"]')?.value;
            if (!linkedId && standaloneName) {
                const tab = document.querySelector('[data-bs-target="#tabStandalone"]');
                if (tab) new bootstrap.Tab(tab).show();
            }
        })();
    </script>
}
