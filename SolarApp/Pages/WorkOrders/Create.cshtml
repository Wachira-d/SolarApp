@page
@model SolarApp.Pages.WorkOrders.CreateModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "New Work Order";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-plus-circle"></i> New Work Order</h4>
        <small class="text-muted">Panel cleaning, PM, repair, inspection, or standalone job</small>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <!-- LEFT: Job details -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">Job Details</h6></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Type *</label>
                            <select asp-for="Input.Type" class="form-select" asp-items="Html.GetEnumSelectList<WorkOrderType>()"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Title *</label>
                            <input asp-for="Input.Title" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Scope of Work</label>
                            <textarea asp-for="Input.Scope" class="form-control" rows="2" placeholder="e.g. Clean all panels on roof A and B"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Special Instructions</label>
                            <textarea asp-for="Input.SpecialInstructions" class="form-control" rows="2" placeholder="e.g. Key is with guard, call before arrival"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Site selection: linked OR standalone -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">Site</h6></div>
                <div class="card-body">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabLinked" type="button">
                                <i class="bi bi-link-45deg"></i> Linked Installation
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabStandalone" type="button">
                                <i class="bi bi-building"></i> Standalone Site
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tabLinked">
                            <select asp-for="Input.InstallationId" class="form-select">
                                <option value="">(Select installation — or use Standalone tab)</option>
                                @foreach (var i in Model.Installations) { <option value="@i.Value">@i.Text</option> }
                            </select>
                        </div>
                        <div class="tab-pane fade" id="tabStandalone">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Site Name *</label>
                                    <input asp-for="Input.ExternalSiteName" class="form-control" placeholder="e.g. คุณสมชาย บ้านพัก" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Customer Name</label>
                                    <input asp-for="Input.ExternalCustomerName" class="form-control" />
                                </div>
                                <div class="col-8">
                                    <label class="form-label">Address</label>
                                    <input asp-for="Input.ExternalSiteAddress" class="form-control" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Phone</label>
                                    <input asp-for="Input.ExternalCustomerPhone" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Latitude</label>
                                    <input asp-for="Input.ExternalLatitude" type="number" step="any" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Longitude</label>
                                    <input asp-for="Input.ExternalLongitude" type="number" step="any" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Checklist -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">Checklist Items</h6></div>
                <div class="card-body">
                    <textarea asp-for="Input.ChecklistItems" class="form-control" rows="5"
                              placeholder="Enter one item per line, e.g.:
Inspect DC isolator
Clean panels row A
Clean panels row B
Check inverter display
Take before/after photos
Record meter reading"></textarea>
                    <small class="text-muted">One item per line. Technician checks them off in the field.</small>
                </div>
            </div>
        </div>

        <!-- RIGHT: Schedule + assignment -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">Schedule</h6></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-7">
                            <label class="form-label">Date *</label>
                            <input asp-for="Input.ScheduledDate" type="date" class="form-control" />
                        </div>
                        <div class="col-5">
                            <label class="form-label">Time</label>
                            <input asp-for="Input.ScheduledTimeStr" type="time" class="form-control" placeholder="09:00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Duration (min)</label>
                            <input asp-for="Input.EstimatedDurationMinutes" type="number" min="15" step="15" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Recur every (months)</label>
                            <input asp-for="Input.RecurrenceMonths" type="number" min="1" max="60" class="form-control" placeholder="(one-time)" />
                            <small class="text-muted">Leave blank for one-time jobs</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">Assignment</h6></div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Team</label>
                        <input asp-for="Input.AssignedTeam" class="form-control" placeholder="e.g. Cleaning Team A, Partner XYZ" />
                    </div>
                    <div>
                        <label class="form-label">Assign to User</label>
                        <select asp-for="Input.AssignedToUserId" class="form-select">
                            <option value="">(Unassigned)</option>
                            @foreach (var u in Model.Users) { <option value="@u.Value">@u.Text</option> }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">Customer / Billing</h6></div>
                <div class="card-body">
                    <select asp-for="Input.CustomerId" class="form-select">
                        <option value="">(No customer linked)</option>
                        @foreach (var c in Model.Customers) { <option value="@c.Value">@c.Text</option> }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-warning w-100">
                <i class="bi bi-plus-circle"></i> Create Work Order
            </button>
        </div>
    </div>
</form>
