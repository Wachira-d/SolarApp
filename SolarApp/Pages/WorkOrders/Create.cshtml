@page
@model SolarApp.Pages.WorkOrders.CreateModel
@using SolarApp.Models.Enums
@using System.Text.Json
@{
    var quick = Model.LockedSite != null;
    ViewData["Title"] = quick ? $"บันทึกงาน - {Model.LockedSite!.SiteName}" : "สร้างใบสั่งงาน";
    var typeDefaultsJson = JsonSerializer.Serialize(Model.TypeDefaults);
    var site = Model.LockedSite;
    var backPage = quick ? "/Installations/Detail" : "/Jobs/Index";
    var tileTypes = new[]
    {
        WorkOrderType.PanelCleaning, WorkOrderType.PreventiveMaintenance,
        WorkOrderType.CorrectiveRepair, WorkOrderType.Inspection,
        WorkOrderType.NewInstallation, WorkOrderType.Commissioning,
        WorkOrderType.Decommission, WorkOrderType.Other
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-clipboard2-plus"></i> @(quick ? "บันทึกงานเข้าไซต์" : "สร้างใบสั่งงาน")</h4>
        @if (quick)
        {
            <div class="text-muted">
                <i class="bi bi-house-gear"></i> <strong>@site!.SiteName</strong>
                @if (site.Customer != null) { <span>· @site.Customer.FullName</span> }
            </div>
        }
        else
        {
            <small class="text-muted">นัดล่วงหน้า หรือบันทึกงานที่ทำเสร็จแล้วก็ได้</small>
        }
    </div>
    @if (quick)
    {
        <a asp-page="/Installations/Detail" asp-route-id="@site!.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> กลับหน้าไซต์
        </a>
    }
    else
    {
        <a asp-page="/Jobs/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> กลับ</a>
    }
</div>

@if (Model.SourceTicket != null)
{
    <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="bi bi-ticket-detailed fs-5"></i>
        <div>
            สร้างจากเรื่องแจ้งซ่อม <strong>@Model.SourceTicket.TicketNumber</strong> — @Model.SourceTicket.Subject
            <div class="small text-muted">เมื่อปิดงานนี้ เรื่องแจ้งซ่อมจะถูกตั้งเป็น "แก้ไขแล้ว" ให้อัตโนมัติ</div>
        </div>
    </div>
}

<form method="post" enctype="multipart/form-data" id="woForm">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }
    <input type="hidden" asp-for="Input.ServiceTicketId" />
    @if (quick)
    {
        <input type="hidden" asp-for="Input.InstallationId" />
    }

    <div class="row g-3">
        <div class="col-lg-7">
            @* ── 1. What kind of visit ── *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">1. ประเภทงาน</h6></div>
                <div class="card-body">
                    <div class="row g-2" id="typeTiles">
                        @foreach (var t in tileTypes)
                        {
                            var id = $"type-{(int)t}";
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="Input.Type" id="@id" value="@((int)t)"
                                       checked="@(Model.Input.Type == t)" autocomplete="off" />
                                <label class="btn btn-outline-primary w-100 h-100 py-3 d-flex flex-column align-items-center gap-1" for="@id">
                                    <i class="bi bi-@UiLabels.Icon(t) fs-4"></i>
                                    <span class="small">@UiLabels.Label(t)</span>
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Input.Type" class="text-danger small"></span>
                </div>
            </div>

            @* ── 2. Site (only when not opened from one) ── *@
            @if (!quick)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white"><h6 class="mb-0">2. ไซต์งาน <span class="text-danger">*</span></h6></div>
                    <div class="card-body">
                        <ul class="nav nav-pills mb-3" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabLinked" type="button">
                                    <i class="bi bi-link-45deg"></i> ไซต์ในระบบ
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabStandalone" type="button">
                                    <i class="bi bi-building"></i> ไซต์นอกระบบ
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="tabLinked">
                                <select asp-for="Input.InstallationId" class="form-select">
                                    <option value="">— เลือกไซต์ —</option>
                                    @foreach (var i in Model.Installations) { <option value="@i.Value">@i.Text</option> }
                                </select>
                                <span asp-validation-for="Input.InstallationId" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">
                                    เคล็ดลับ: เปิดจากหน้าไซต์ (ปุ่ม "บันทึกงานเข้าไซต์") จะเลือกไซต์ให้อัตโนมัติ
                                </small>
                            </div>
                            <div class="tab-pane fade" id="tabStandalone">
                                <small class="text-muted d-block mb-2">
                                    สำหรับไซต์ที่ยังไม่อยู่ในระบบ (ลูกค้าใหม่, งานครั้งเดียว)
                                </small>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label">ชื่อไซต์ *</label>
                                        <input asp-for="Input.ExternalSiteName" class="form-control" placeholder="เช่น บ้านคุณสมชาย" />
                                        <span asp-validation-for="Input.ExternalSiteName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">ชื่อลูกค้า</label>
                                        <input asp-for="Input.ExternalCustomerName" class="form-control" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label">ที่อยู่</label>
                                        <input asp-for="Input.ExternalSiteAddress" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">เบอร์โทร</label>
                                        <input asp-for="Input.ExternalCustomerPhone" class="form-control" type="tel" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label">ละติจูด</label>
                                        <input asp-for="Input.ExternalLatitude" type="number" step="any" class="form-control" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label">ลองจิจูด</label>
                                        <input asp-for="Input.ExternalLongitude" type="number" step="any" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── 3. Details ── *@
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">@(quick ? "2" : "3"). รายละเอียด</h6></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">หัวข้องาน *</label>
                            <input asp-for="Input.Title" class="form-control" placeholder="เช่น ล้างแผงรอบไตรมาส 4" />
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">วันที่ *</label>
                            <input asp-for="Input.ScheduledDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.ScheduledDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ผู้รับผิดชอบ</label>
                            <select asp-for="Input.AssignedToUserId" class="form-select">
                                <option value="">(ยังไม่ระบุ)</option>
                                @foreach (var u in Model.Users) { <option value="@u.Value">@u.Text</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รายละเอียด / สิ่งที่ต้องทำ</label>
                            <textarea asp-for="Input.Description" class="form-control" rows="3"
                                      placeholder="เช่น อินเวอร์เตอร์ 2 ขึ้น error E031 ตรวจสาย DC"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รายการตรวจสอบ (checklist) <small class="text-muted">— 1 รายการต่อบรรทัด</small></label>
                            <textarea asp-for="Input.ChecklistItems" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            @* ── 4. Already done? ── *@
            <div class="card border-0 shadow-sm mb-3 border-success" id="doneCard">
                <div class="card-body">
                    <div class="form-check form-switch fs-5">
                        <input asp-for="Input.MarkCompleted" class="form-check-input" role="switch" />
                        <label asp-for="Input.MarkCompleted" class="form-check-label fw-semibold">
                            ทำเสร็จแล้ว — บันทึกเป็นงานที่เสร็จทันที
                        </label>
                    </div>
                    <small class="text-muted d-block mb-2">
                        ใช้เมื่อเข้าไซต์มาแล้วและมาจดย้อนหลัง งานล้างแผงจะไปนับครั้งล้างและตั้งรอบถัดไปให้เอง
                    </small>
                    <div id="doneFields" class="row g-3 @(Model.Input.MarkCompleted ? "" : "d-none")">
                        <div class="col-12">
                            <label class="form-label">บันทึกปิดงาน / สิ่งที่พบ</label>
                            <textarea asp-for="Input.CompletionNotes" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-camera"></i> รูปก่อนทำงาน</label>
                            <input type="file" name="BeforePhotoFiles" class="form-control" multiple accept="image/*" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-camera-fill"></i> รูปหลังทำงาน</label>
                            <input type="file" name="AfterPhotoFiles" class="form-control" multiple accept="image/*" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            @* ── Advanced, folded away ── *@
            <div class="card border-0 shadow-sm mb-3">
                <button class="card-header bg-white w-100 text-start border-0 d-flex justify-content-between align-items-center"
                        type="button" data-bs-toggle="collapse" data-bs-target="#advanced">
                    <h6 class="mb-0"><i class="bi bi-sliders"></i> ตัวเลือกเพิ่มเติม</h6>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse @(quick ? "" : "show")" id="advanced">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label">เวลานัด</label>
                                <input asp-for="Input.ScheduledTimeStr" type="time" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">ใช้เวลา (นาที)</label>
                                <input asp-for="Input.EstimatedDurationMinutes" type="number" min="15" step="15" class="form-control" />
                                <span asp-validation-for="Input.EstimatedDurationMinutes" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ทำซ้ำทุก (เดือน)</label>
                                <input asp-for="Input.RecurrenceMonths" type="number" min="0" max="120" class="form-control" placeholder="เว้นว่าง = ครั้งเดียว" />
                                <span asp-validation-for="Input.RecurrenceMonths" class="text-danger small"></span>
                                <small class="text-muted">ปิดงานแล้วระบบจะสร้างงานรอบถัดไปให้</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ทีม</label>
                                <input asp-for="Input.AssignedTeam" class="form-control" placeholder="เช่น ทีมล้าง A" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">ขอบเขตงาน</label>
                                <textarea asp-for="Input.Scope" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">หมายเหตุพิเศษ (กุญแจ, ผู้ติดต่อ, ข้อควรระวัง)</label>
                                <textarea asp-for="Input.SpecialInstructions" class="form-control" rows="2"></textarea>
                            </div>
                            @if (!quick)
                            {
                                <div class="col-12">
                                    <label class="form-label">ลูกค้า (สำหรับออกบิล)</label>
                                    <select asp-for="Input.CustomerId" class="form-select">
                                        <option value="">(ไม่ผูกลูกค้า)</option>
                                        @foreach (var c in Model.Customers) { <option value="@c.Value">@c.Text</option> }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-none d-lg-block">
                <button type="submit" class="btn btn-warning btn-lg w-100" id="submitDesktop">
                    <i class="bi bi-check2-circle"></i> <span class="submit-label">บันทึกใบสั่งงาน</span>
                </button>
            </div>
        </div>
    </div>

    @* Sticky on phones: the form is long and the save button was at the end of it. *@
    <div class="d-lg-none position-sticky bottom-0 py-2 mt-3"
         style="background:var(--app-bg, #f5f6fa); box-shadow:0 -4px 12px rgba(0,0,0,.08)">
        <button type="submit" class="btn btn-warning btn-lg w-100">
            <i class="bi bi-check2-circle"></i> <span class="submit-label">บันทึกใบสั่งงาน</span>
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Per-type defaults for Title + Checklist, from Admin → ค่ามาตรฐานใบสั่งงาน.
        const WO_DEFAULTS = @Html.Raw(typeDefaultsJson);
        const OTHER = 99;

        (function () {
            const titleEl = document.querySelector('[name="Input.Title"]');
            const checkEl = document.querySelector('[name="Input.ChecklistItems"]');
            const radios  = document.querySelectorAll('input[name="Input.Type"]');
            if (!titleEl || !checkEl || !radios.length) return;

            let lastTitle = titleEl.value;
            let lastChecklist = checkEl.value;

            function current() {
                const r = document.querySelector('input[name="Input.Type"]:checked');
                return r ? parseInt(r.value, 10) : OTHER;
            }
            // Only overwrite what is empty or still the previous default, so a
            // title typed by hand (or copied from a ticket) survives a type change.
            function apply() {
                const d = WO_DEFAULTS[current()] || WO_DEFAULTS[OTHER] || { title: '', checklist: '' };
                if (titleEl.value.trim() === '' || titleEl.value === lastTitle) {
                    titleEl.value = d.title || '';
                    lastTitle = titleEl.value;
                }
                if (checkEl.value.trim() === '' || checkEl.value === lastChecklist) {
                    checkEl.value = d.checklist || '';
                    lastChecklist = checkEl.value;
                }
            }
            apply();
            radios.forEach(r => r.addEventListener('change', apply));
        })();

        // "ทำเสร็จแล้ว" reveals the closing notes + photos and relabels the button.
        (function () {
            const sw = document.querySelector('[name="Input.MarkCompleted"][type="checkbox"]');
            const fields = document.getElementById('doneFields');
            const labels = document.querySelectorAll('.submit-label');
            const date = document.querySelector('[name="Input.ScheduledDate"]');
            if (!sw || !fields) return;
            function sync() {
                fields.classList.toggle('d-none', !sw.checked);
                labels.forEach(l => l.textContent = sw.checked ? 'บันทึกงานที่ทำเสร็จแล้ว' : 'บันทึกใบสั่งงาน');
                if (date) date.max = sw.checked ? new Date().toISOString().slice(0, 10) : '';
            }
            sync();
            sw.addEventListener('change', sync);
        })();

        // Re-open the standalone tab after a validation round-trip.
        (function () {
            const standaloneName = document.querySelector('[name="Input.ExternalSiteName"]')?.value;
            const linkedId = document.querySelector('select[name="Input.InstallationId"]')?.value;
            if (!linkedId && standaloneName) {
                const tab = document.querySelector('[data-bs-target="#tabStandalone"]');
                if (tab) new bootstrap.Tab(tab).show();
            }
        })();
    </script>
}
