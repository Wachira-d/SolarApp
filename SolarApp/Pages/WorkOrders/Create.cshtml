@page
@model SolarApp.Pages.WorkOrders.CreateModel
@using SolarApp.Models.Enums
@{
    ViewData["Title"] = "สร้างใบสั่งงาน";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-plus-circle"></i> สร้างใบสั่งงานใหม่</h4>
        <small class="text-muted">ล้างแผง, PM, ซ่อม, ตรวจสอบ หรืองานนอกระบบ</small>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> กลับ</a>
</div>

<form method="post">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="row g-3">
        <!-- LEFT: Job details -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">รายละเอียดงาน</h6></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">ประเภท *</label>
                            <select asp-for="Input.Type" class="form-select">
                                <option value="1">ล้างแผง</option>
                                <option value="2">บำรุงรักษาเชิงป้องกัน (PM)</option>
                                <option value="3">ซ่อมแก้ไข</option>
                                <option value="4">ตรวจสอบ</option>
                                <option value="5">ติดตั้งใหม่</option>
                                <option value="6">Commissioning</option>
                                <option value="7">ถอนการติดตั้ง</option>
                                <option value="8">อื่นๆ</option>
                            </select>
                            <span asp-validation-for="Input.Type" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">หัวข้องาน *</label>
                            <input asp-for="Input.Title" class="form-control" placeholder="เช่น ล้างแผงทุก 3 เดือน" />
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">คำอธิบาย</label>
                            <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ขอบเขตงาน</label>
                            <textarea asp-for="Input.Scope" class="form-control" rows="2" placeholder="เช่น ล้างแผงโซลาร์ทั้งแถว A และ B"></textarea>
                            <span asp-validation-for="Input.Scope" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">หมายเหตุพิเศษ</label>
                            <textarea asp-for="Input.SpecialInstructions" class="form-control" rows="2" placeholder="เช่น กุญแจอยู่ที่ รปภ. โทรก่อนถึงไซต์"></textarea>
                            <span asp-validation-for="Input.SpecialInstructions" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Site selection: linked OR standalone -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">ไซต์งาน <span class="text-danger">*</span></h6></div>
                <div class="card-body">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabLinked" type="button">
                                <i class="bi bi-link-45deg"></i> ไซต์ในระบบ
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabStandalone" type="button">
                                <i class="bi bi-building"></i> ไซต์นอกระบบ
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tabLinked">
                            <select asp-for="Input.InstallationId" class="form-select">
                                <option value="">(เลือกไซต์ — หรือใช้แท็บ "ไซต์นอกระบบ")</option>
                                @foreach (var i in Model.Installations) { <option value="@i.Value">@i.Text</option> }
                            </select>
                            <span asp-validation-for="Input.InstallationId" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">เลือกไซต์ที่อยู่ในระบบแล้ว (มีข้อมูลลูกค้า/อินเวอร์เตอร์)</small>
                        </div>
                        <div class="tab-pane fade" id="tabStandalone">
                            <small class="text-muted d-block mb-2">
                                ใช้สำหรับไซต์ที่ยังไม่ได้บันทึกในระบบ (เช่น ลูกค้าใหม่, ไซต์เช่ารถ, งานครั้งเดียว)
                            </small>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">ชื่อไซต์ *</label>
                                    <input asp-for="Input.ExternalSiteName" class="form-control" placeholder="เช่น คุณสมชาย บ้านพัก" />
                                    <span asp-validation-for="Input.ExternalSiteName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">ชื่อลูกค้า</label>
                                    <input asp-for="Input.ExternalCustomerName" class="form-control" />
                                </div>
                                <div class="col-8">
                                    <label class="form-label">ที่อยู่</label>
                                    <input asp-for="Input.ExternalSiteAddress" class="form-control" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label">เบอร์โทร</label>
                                    <input asp-for="Input.ExternalCustomerPhone" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Latitude</label>
                                    <input asp-for="Input.ExternalLatitude" type="number" step="any" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Longitude</label>
                                    <input asp-for="Input.ExternalLongitude" type="number" step="any" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Checklist -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">รายการตรวจสอบ (Checklist)</h6></div>
                <div class="card-body">
                    <textarea asp-for="Input.ChecklistItems" class="form-control" rows="5"
                              placeholder="ใส่ 1 รายการต่อบรรทัด เช่น:
ตรวจ DC isolator
ล้างแผงแถว A
ล้างแผงแถว B
ตรวจหน้าจอ inverter
ถ่ายรูปก่อน/หลัง
จดเลขมิเตอร์"></textarea>
                    <small class="text-muted">1 รายการต่อบรรทัด — ช่างจะเช็คผ่านมือถือตอนหน้างาน</small>
                </div>
            </div>
        </div>

        <!-- RIGHT: Schedule + assignment -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">การนัดหมาย</h6></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-7">
                            <label class="form-label">วันที่นัด *</label>
                            <input asp-for="Input.ScheduledDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.ScheduledDate" class="text-danger small"></span>
                        </div>
                        <div class="col-5">
                            <label class="form-label">เวลา</label>
                            <input asp-for="Input.ScheduledTimeStr" type="time" class="form-control" placeholder="09:00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">ระยะเวลา (นาที)</label>
                            <input asp-for="Input.EstimatedDurationMinutes" type="number" min="15" step="15" class="form-control" />
                            <span asp-validation-for="Input.EstimatedDurationMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">ทำซ้ำทุก (เดือน)</label>
                            <input asp-for="Input.RecurrenceMonths" type="number" min="0" max="120" class="form-control" placeholder="(งานครั้งเดียว)" />
                            <span asp-validation-for="Input.RecurrenceMonths" class="text-danger small"></span>
                            <small class="text-muted">เว้นว่างถ้าทำครั้งเดียว</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">การมอบหมาย</h6></div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">ทีม</label>
                        <input asp-for="Input.AssignedTeam" class="form-control" placeholder="เช่น ทีมล้าง A, พาร์ทเนอร์ XYZ" />
                    </div>
                    <div>
                        <label class="form-label">มอบหมายให้</label>
                        <select asp-for="Input.AssignedToUserId" class="form-select">
                            <option value="">(ยังไม่ระบุผู้รับผิดชอบ)</option>
                            @foreach (var u in Model.Users) { <option value="@u.Value">@u.Text</option> }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><h6 class="mb-0">ลูกค้า / การออกบิล</h6></div>
                <div class="card-body">
                    <select asp-for="Input.CustomerId" class="form-select">
                        <option value="">(ไม่ผูกลูกค้า)</option>
                        @foreach (var c in Model.Customers) { <option value="@c.Value">@c.Text</option> }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-warning w-100">
                <i class="bi bi-plus-circle"></i> บันทึกใบสั่งงาน
            </button>
            <small class="text-muted d-block text-center mt-2">
                * จำเป็นต้องกรอก — เลือก "ไซต์ในระบบ" หรือใส่ "ชื่อไซต์" ใน "ไซต์นอกระบบ" อย่างใดอย่างหนึ่ง
            </small>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Per-type defaults for Title + Checklist ──
        // Keys match SolarApp.Models.Enums.WorkOrderType integer values.
        const WO_DEFAULTS = {
            1: { // PanelCleaning
                title: 'ล้างแผงโซลาร์',
                checklist: [
                    'ตรวจ DC isolator ก่อนเริ่มงาน',
                    'ปิด AC breaker ก่อนล้างแผง',
                    'ล้างแผงทุกแถวด้วยน้ำสะอาด (ไม่ใช้สารทำความสะอาด)',
                    'ตรวจรอยรั่ว / น้ำซึมหลังล้าง',
                    'ตรวจความสะอาด glass หลังแห้ง',
                    'เปิดระบบกลับ + ตรวจค่ากำลังผลิต',
                    'ถ่ายรูปก่อน-หลัง ทุกแถวที่ล้าง',
                    'จดเลขมิเตอร์ก่อน-หลัง'
                ].join('\n')
            },
            2: { // PreventiveMaintenance
                title: 'บำรุงรักษาเชิงป้องกัน (PM)',
                checklist: [
                    'ตรวจสายไฟและ MC4 connectors ทุกจุด',
                    'ขันแน่นน็อต MC4 + AC terminal',
                    'วัดความต้านทานฉนวน DC string',
                    'ตรวจสภาพ inverter (จอ / เสียง / อุณหภูมิ)',
                    'ตรวจระบบดิน + bonding',
                    'ทำความสะอาด heatsink / พัดลม inverter',
                    'ตรวจ AC + DC breakers และ RCBO',
                    'ตรวจ data logger + WiFi / 4G',
                    'ตรวจโครงสร้างราง + clamps + รอยสนิม',
                    'ถ่ายรูปจุดสำคัญ + สรุปรายงาน PM'
                ].join('\n')
            },
            3: { // CorrectiveRepair
                title: 'งานซ่อมแก้ไข',
                checklist: [
                    'บันทึกอาการที่พบเมื่อมาถึงไซต์',
                    'ตรวจหาสาเหตุ (root cause)',
                    'ถ่ายรูปจุดเสีย/ก่อนซ่อม',
                    'ทำการซ่อม / เปลี่ยนอุปกรณ์',
                    'ทดสอบการทำงานหลังซ่อม',
                    'ถ่ายรูปจุดซ่อมหลังเสร็จ',
                    'บันทึกอะไหล่ที่ใช้ + serial number',
                    'อธิบาย/แจ้งลูกค้าเกี่ยวกับการซ่อม'
                ].join('\n')
            },
            4: { // Inspection
                title: 'ตรวจสอบประจำงวด',
                checklist: [
                    'ตรวจหน้าจอ inverter (ผลิตปกติ?)',
                    'วัดแรงดัน / กระแส DC ในแต่ละ string',
                    'วัดแรงดัน / กระแส AC output',
                    'ตรวจ thermal scan หา hot spot (ถ้ามีกล้อง)',
                    'ตรวจสภาพสายและ MC4 connectors',
                    'ตรวจกล่องไฟ / AC breakers',
                    'ถ่ายรูปจุดสำคัญ',
                    'เปรียบเทียบกำลังผลิตกับ baseline เดิม'
                ].join('\n')
            },
            5: { // NewInstallation
                title: 'ติดตั้งโซลาร์ใหม่',
                checklist: [
                    'สำรวจหลังคา + วัดมุม + เงา shading',
                    'ติดตั้งโครงรางและ clamps',
                    'วางแผง + ขัน clamps + เช็คความตึง',
                    'ติดตั้ง inverter (ระยะระบายอากาศ)',
                    'เดินสาย DC ผ่าน conduit + DC isolator',
                    'ติดตั้ง AC breaker + RCBO + ป้ายเตือน',
                    'ติดตั้ง data logger / WiFi stick',
                    'ทดสอบ open-circuit voltage ทุก string',
                    'ทดสอบฉนวน + ลงทะเบียน cloud',
                    'ถ่ายรูป before / during / after ทุก stage'
                ].join('\n')
            },
            6: { // Commissioning
                title: 'Commissioning + ส่งมอบงาน',
                checklist: [
                    'ตรวจ open-circuit voltage (Voc) ทุก string',
                    'ตรวจความต้านทานฉนวน (insulation)',
                    'เปิดระบบ + รัน inverter ครั้งแรก',
                    'เช็คกำลังผลิตจริงเทียบสเปก',
                    'ตั้งค่า + ลงทะเบียน cloud monitoring',
                    'สอนการใช้งานแอป FusionSolar/SmartPV ให้ลูกค้า',
                    'ส่งมอบ datasheet + คู่มือ + ใบรับประกัน',
                    'ลูกค้าเซ็นรับงาน (CustomerSigned)'
                ].join('\n')
            },
            7: { // Decommission
                title: 'ถอนการติดตั้ง',
                checklist: [
                    'ปิด AC + DC ทุกตัวก่อนเริ่มถอน',
                    'ถอด data logger + แจ้ง cloud ตัดบัญชี',
                    'ถอด + ติด label แผงเพื่อเก็บ',
                    'ม้วน + เก็บสาย DC / AC',
                    'รื้อโครงราง',
                    'อุดรู screws บนหลังคา + กันรั่ว',
                    'ทำความสะอาดพื้นที่',
                    'ถ่ายรูปสภาพหลังถอน + ส่งให้ลูกค้า'
                ].join('\n')
            },
            8: { // Other
                title: '',
                checklist: ''
            }
        };

        // ── Apply defaults when type changes ──
        // Only overwrite Title / Checklist if they are EMPTY or still equal to
        // the previously-applied default — so a tech who has typed custom text
        // won't lose it.
        (function () {
            const titleEl = document.querySelector('[name="Input.Title"]');
            const checkEl = document.querySelector('[name="Input.ChecklistItems"]');
            const typeEl  = document.querySelector('[name="Input.Type"]');
            if (!titleEl || !checkEl || !typeEl) return;

            let lastTitle = titleEl.value;
            let lastChecklist = checkEl.value;

            function apply() {
                const t = parseInt(typeEl.value, 10);
                const d = WO_DEFAULTS[t] || WO_DEFAULTS[8];

                if (titleEl.value.trim() === '' || titleEl.value === lastTitle) {
                    titleEl.value = d.title;
                    lastTitle = d.title;
                }
                if (checkEl.value.trim() === '' || checkEl.value === lastChecklist) {
                    checkEl.value = d.checklist;
                    lastChecklist = d.checklist;
                }
            }

            // Apply once on load (for empty fields)
            apply();
            typeEl.addEventListener('change', apply);
        })();

        // If the user typed something in the Standalone tab, auto-switch to it
        // when re-rendering after a validation failure.
        (function () {
            const standaloneName = document.querySelector('[name="Input.ExternalSiteName"]')?.value;
            const linkedId = document.querySelector('[name="Input.InstallationId"]')?.value;
            if (!linkedId && standaloneName) {
                const tab = document.querySelector('[data-bs-target="#tabStandalone"]');
                if (tab) new bootstrap.Tab(tab).show();
            }
        })();
    </script>
}
