<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- IIS Application Initialization: start the app immediately when the
           app pool starts (not on first request). Combined with the
           SelfKeepAliveService in the app, this ensures Hangfire background
           jobs run 24/7 even when no user visits the website. -->
      <applicationInitialization doAppInitAfterRestart="true">
        <add initializationPage="/ping" />
      </applicationInitialization>
      <aspNetCore processPath="dotnet"
                  arguments=".\SolarApp.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess"
                  startupTimeLimit="180">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
      <!-- OAuth callback URLs from Microsoft/LINE can exceed IIS defaults.
           Microsoft's authorization code alone is 2000+ chars. Without this
           section, IIS returns 404.11 before the request reaches ASP.NET Core. -->
      <security>
        <requestFiltering>
          <requestLimits maxQueryString="16384" maxUrl="16384" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
