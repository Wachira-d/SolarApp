{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "tableName": "SerilogLogs",
          "autoCreateSqlTable": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SolarApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "LineMessaging": {
    "ChannelAccessToken": "",
    "ChannelSecret": ""
  },
  "InverterApis": {
    "SyncIntervalMinutes": 5,
    "HealthCheckIntervalMinutes": 2,
    "OfflineThresholdMinutes": 15,
    "LowProductionThresholdPercent": 50,
    "HuaweiFusionSolar": {
      "BaseUrl": "https://sg5.fusionsolar.huawei.com/thirdData",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "FoxEss": {
      "BaseUrl": "https://www.foxesscloud.com/op/v0",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "Solis": {
      "BaseUrl": "https://www.soliscloud.com:13333/v1/api",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "GoodWe": {
      "BaseUrl": "https://www.semsportal.com/api/v1",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "Deye": {
      "BaseUrl": "https://eu1-developer.deyecloud.com/v1.0",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5
  },
  "FileStorage": {
    "BasePath": "./uploads",
    "MaxFileSizeMb": 10
  }
}
