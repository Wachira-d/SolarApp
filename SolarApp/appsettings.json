{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/solarapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SolarApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "LineMessaging": {
    "ChannelAccessToken": "",
    "ChannelSecret": ""
  },
  "Authentication": {
    "_comment": "Leave ClientId/Secret empty to hide the corresponding login button.",
    "Microsoft": {
      "_howto": "portal.azure.com → App registrations → New → redirect URI https://<your-domain>/signin-microsoft (Web)",
      "ClientId": "",
      "ClientSecret": ""
    },
    "LINE": {
      "_howto": "developers.line.biz → LINE Login channel → Channel ID + Secret → Callback URL https://<your-domain>/signin-line",
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Monitoring": {
    "DeviceOfflineHoursThreshold": 3,
    "Escalation": {
      "Critical": { "Level1Hours": 2, "Level2Hours": 6, "Level3Hours": 24 },
      "High":     { "Level1Hours": 6, "Level2Hours": 24, "Level3Hours": 72 }
    }
  },
  "Performance": {
    "PerformanceRatioLowThreshold": 0.7,
    "PerformanceRatioExcellent": 0.9,
    "UptimeLowThreshold": 95,
    "UptimeExcellent": 98,
    "OfflineDaysThreshold": 3
  },
  "MySolar": {
    "OperatorName": "Milden Energy",
    "OperatorPhone": "",
    "OperatorLine": "",
    "OperatorEmail": ""
  },
  "InverterApis": {
    "SyncIntervalMinutes": 5,
    "HealthCheckIntervalMinutes": 2,
    "OfflineThresholdMinutes": 45,
    "MinFailedCallsForAlert": 2,
    "LowProductionThresholdPercent": 50,
    "HuaweiFusionSolar": {
      "BaseUrl": "https://sg5.fusionsolar.huawei.com/thirdData",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "FoxEss": {
      "BaseUrl": "https://www.foxesscloud.com/op/v0",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "Solis": {
      "BaseUrl": "https://www.soliscloud.com:13333/v1/api",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "GoodWe": {
      "BaseUrl": "https://www.semsportal.com/api/v1",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    },
    "Deye": {
      "BaseUrl": "https://eu1-developer.deyecloud.com/v1.0",
      "TimeoutSeconds": 30,
      "RetryCount": 3
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5
  },
  "FileStorage": {
    "BasePath": "./uploads",
    "MaxFileSizeMb": 10
  }
}
